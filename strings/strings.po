msgstr "<link=\"OILFLOATERDECOR\">بيضة لونغهير سليكستر</link>"

msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.NAME"
msgid "<link=\"OILFLOATERDECOR\">Longhair Slickster</link>"
msgstr "<link=\"OILFLOATERDECOR\">لونغهير سليكستر</link>"

msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.BABY.DESC"
msgid ""
"A goopy little Molten Larva.\n"
"\n"
"One day it will grow into an adult Slickster morph, the <link=\"OILFLOATERHIGHTEMP\">Molten Slickster</link>."
msgstr ""
"يوما ما ستنمو لتصبح شكال بالغا من ساليكستر، الـ \n"
"\n"
"يرقة مصهورة صغيرة ولزجة.<link=\"OILFLOATERHIGHTEMP\">ساليكستر المصهور</link>."

msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.BABY.NAME"
msgid "<link=\"OILFLOATERHIGHTEMP\">Molten Larva</link>"
msgstr "<link=\"OILFLOATERHIGHTEMP\">يرقة منصهرة</link>"

msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.DESC"
msgid ""
"Molten Slicksters are slimy critters that consume "
"<link=\"CARBONDIOXIDE\">Carbon Dioxide</link> and exude "
"<link=\"PETROLEUM\">Petroleum</link>."
msgstr ""
"المولتن سليكسترز هي مخلوقات زلقة تستهلك <link=\"CARBONDIOXIDE\">ثاني أكسيد "
"الكربون</link> وتفرز <link=\"PETROLEUM\">البترول</link>."

msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.EGG_NAME"
msgid "<link=\"OILFLOATERHIGHTEMP\">Molten Slickster Egg</link>"
msgstr "<link=\"OILFLOATERHIGHTEMP\">بيضة سليكسستر المصهورة</link>"

msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.NAME"
msgid "<link=\"OILFLOATERHIGHTEMP\">Molten Slickster</link>"
msgstr "<link=\"OILFLOATERHIGHTEMP\">سليكستر المنصهر</link>"

msgctxt "STRINGS.CREATURES.SPECIES.OILSPOUT.DESC"
msgid "A rocky vent that spouts <link=\"CRUDEOIL\">Crude Oil</link>."
msgstr "فتحة صخرية تنفث <link=\"CRUDEOIL\">النفط الخام</link>."

