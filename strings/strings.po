msgctxt "STRINGS.BLUEPRINTS.PERMIT_TOP_GOTCH_RIVET_ELECTRO.DESC"
msgid "A sweat-wicking undershirt in a really riveting shade of blue."
msgstr "قميص داخلي يمتص العرق بلون أزرق جذاب للغاية."

msgctxt "STRINGS.BLUEPRINTS.PERMIT_TOP_GOTCH_RIVET_ELECTRO.NAME"
msgid "Rivet Base Layer"
msgstr "طبقة قاعدة المسامير"

msgctxt "STRINGS.BLUEPRINTS.PERMIT_TOP_GOTCH_VITRO_SYMBIO.DESC"
msgid "A sweat-wicking undershirt in a striking glassy-blue hue."
msgstr "قميص داخلي يمتص العرق بلون أزرق زجاجي الفت."

msgctxt "STRINGS.BLUEPRINTS.PERMIT_TOP_GOTCH_VITRO_SYMBIO.NAME"
msgid "Vitro Base Layer"
msgstr "طبقة قاعدة فيترو"

msgctxt "STRINGS.BLUEPRINTS.PERMIT_TOP_JERSEY_01.DESC"
