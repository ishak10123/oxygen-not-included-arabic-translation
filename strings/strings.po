msgctxt "STRINGS.BUILDINGS.PREFABS.DIAMONDPRESS.DESC"
msgid "Crushes refined carbon into diamond."
msgstr ".ﺱﺎﻤﻟﺃ ﻰﻟﺇ ﺭﺮﻜﻤﻟﺍ ﻥﻮﺑﺮﻜﻟﺍ ﻖﺤﺴﻳ"

msgctxt "STRINGS.BUILDINGS.PREFABS.DIAMONDPRESS.EFFECT"
msgid ""
"Uses <link=\"POWER\">Power</link> and <link=\"RADIATION\">Radbolts</link> to crush <link=\"REFINEDCARBON\">Refined Carbon</link> into <link=\"DIAMOND\">Diamond</link>.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued and <link=\"REFINEDCARBON\">Refined Carbon</link> has been discovered."
msgstr ""
" ﻡﺪﺨﺘﺴﻳ<link=\"POWER\">ﺔﻗﺎﻄﻟﺍ</link> ﻭ <link=\"RADIATION\">ﻉﺎﻌﺷﻹﺍ ﺕﺎﻨﺤﺷ</link> ﻖﺤﺴﻟ <link=\"REFINEDCARBON\">ﺭﺮﻜﻤﻟﺍ ﻥﻮﺑﺮﻜﻟﺍ</link> ﻰﻟﺇ <link=\"DIAMOND\">ﺱﺎﻤﻟﺍ</link>.\n"
"\n"
" ﻑﺎﺸﺘﻛﺍ ﻢﺗﻭ ﺭﺎﻈﺘﻧﻻﺍ ﺔﻤﺋﺎﻗ ﻲﻓ ﺕﺎﻔﺻﻮﻟﺍ ﺝﺍﺭﺩﺇ ﻢﺗ ﺍﺫﺇ ﻻﺇ ﺀﺎﻴﺷﻷﺍ ﻊﻴﻨﺼﺘﺑ ﺦﺴﻨﻟﺍ ﻡﻮﻘﻳ ﻦﻟ<link=\"REFINEDCARBON\">ﺭﺮﻜﻤﻟﺍ ﻥﻮﺑﺮﻜﻟﺍ</link>."

