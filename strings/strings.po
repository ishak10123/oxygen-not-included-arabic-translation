msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTBRIDGE.DESC"
msgid "Allows rocket platforms to be built farther apart."
msgstr "يسمح ببناء منصات الصواريخ على مسافات أبعد."

msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTBRIDGE.EFFECT"
msgid ""
"Automatically links when built to the side of a <link=\"LAUNCHPAD\">Rocket "
"Platform</link> or any <link=\"MODULARLAUNCHPADPORTSOLID\">Rocket "
"Port</link>."
msgstr ""
"يرتبط تلقائيا عند البناء بجانب <link=\"LAUNCHPAD\">منصة الصواريخ</link> أو "
"أي <link=\"MODULARLAUNCHPADPORTSOLID\">منفذ صاروخي</link>."

