msgstr "يجمع بين {0} و {1} إلنشاء {2}."

msgctxt "STRINGS.BUILDINGS.PREFABS.FACILITYBACKWALLWINDOW.EFFECT"
msgid "A tall, thin window."
msgstr "نافذة طويلة ونحيفة."

