msgid "<link=\"ITEMPEDESTAL\">Power Bank Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">قاعدة بنك الطاقة</link>"

msgctxt "STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_COTTAGE.DESC"
