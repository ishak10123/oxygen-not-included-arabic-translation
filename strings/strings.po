msgstr "<link=\"SCULPTURE1X2AMAZING1\">ليست قمعا</link>"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SMALLSCULPTURE.FACADES.SCULPTURE_1x2_AMAZING_2.DESC"
msgid "Part of a well-balanced exhibit."
msgstr "جزء من معرض متوازن جيدا."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SMALLSCULPTURE.FACADES.SCULPTURE_1x2_AMAZING_2.NAME"
msgid "<link=\"SCULPTURE1X2AMAZING2\">Equilibrium</link>"
msgstr "<link=\"SCULPTURE1X2AMAZING2\">التوازن</link>"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SMALLSCULPTURE.FACADES.SCULPTURE_1x2_AMAZING_3.DESC"
msgid "It lacks transparency."
msgstr "يفتقر إلى الشفافية."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SMALLSCULPTURE.FACADES.SCULPTURE_1x2_AMAZING_3.NAME"
msgid "<link=\"SCULPTURE1X2AMAZING3\">Opaque Orb</link>"
msgstr "<link=\"SCULPTURE1X2AMAZING3\">كرة غير شفافة</link>"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SMALLSCULPTURE.FACADES.SCULPTURE_1x2_AMAZING_4.DESC"
msgid ""
"A masterful celebration of the Sweepy's unbeatable work ethic and cheerful, "
"can-clean attitude."
msgstr ""
"احتفال بارع بأخالقيات العمل التي ال تقهر لسويبي وموقفه المبتهج المستعد "
"للتنظيف."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SMALLSCULPTURE.FACADES.SCULPTURE_1x2_AMAZING_4.NAME"
msgid "<link=\"SCULPTURE1X2AMAZING4\">Employee of the Month</link>"
msgstr "<link=\"SCULPTURE1X2AMAZING4\">موظف الشهر</link>"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SMALLSCULPTURE.FACADES.SCULPTURE_1x2_AMAZING_5.DESC"
msgid "A three-dimensional rebellion against the rules of Euclidean space."
msgstr "تمرد ثالثي األبعاد ضد قواعد الفضاء اإلقليدي."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SMALLSCULPTURE.FACADES.SCULPTURE_1x2_AMAZING_5.NAME"
msgid "<link=\"SCULPTURE1X2AMAZING5\">Pointy Impossibility</link>"
msgstr "<link=\"SCULPTURE1X2AMAZING5\">استحالة مدببة</link>"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SMALLSCULPTURE.FACADES.SCULPTURE_1x2_AMAZING_6.DESC"
msgid ""
"Tribute to the artist's friend, who once attempted to catch a meteor with "
"their bare hands."
msgstr ""
"تكريم لصديق الفنان، الذي حاول في يوم من األيام أن يمسك نيزكا بيديه "
"العاريتين."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SMALLSCULPTURE.FACADES.SCULPTURE_1x2_AMAZING_6.NAME"
msgid "<link=\"SCULPTURE1X2AMAZING6\">Fireball</link>"
msgstr "<link=\"SCULPTURE1X2AMAZING6\">كرة نارية</link>"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SMALLSCULPTURE.FACADES.SCULPTURE_1x2_CRAP.DESC"
msgid "It's a heavy heart."
msgstr "إنه قلب مثقل."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SMALLSCULPTURE.FACADES.SCULPTURE_1x2_CRAP.NAME"
msgid "<link=\"SCULPTURE1X2CRAP\">Unrequited</link>"
msgstr "<link=\"SCULPTURE1X2CRAP\">حب من طرف واحد</link>"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SMALLSCULPTURE.FACADES.SCULPTURE_1x2_GOOD.DESC"
msgid "It must be a moon, because there are no bananas in space."
msgstr "يجب أن يكون قمرا، ألنه ال توجد موزات في الفضاء."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SMALLSCULPTURE.FACADES.SCULPTURE_1x2_GOOD.NAME"
msgid "<link=\"SCULPTURE1X2GOOD\">Lunar Slice</link>"
msgstr "<link=\"SCULPTURE1X2GOOD\">شريحة قمرية</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SMALLSCULPTURE.NAME"
msgid "<link=\"SMALLSCULPTURE\">Sculpting Block</link>"
msgstr "<link=\"SMALLSCULPTURE\">كتلة النحت</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SMALLSCULPTURE.POORQUALITYNAME"
msgid "\"Abstract\" Sculpture"
msgstr "تمثال 'تجريدي'"

msgctxt "STRINGS.BUILDINGS.PREFABS.SMARTRESERVOIR.ACTIVATE_TOOLTIP"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> when reservoir is "
"less than <b>{0}%</b> full, until it is <b>{1}% (High Threshold)</b> full"
msgstr ""
"يرسل <b><style=\"logic_on\">إشارة خضراء</style></b> عندما يكون الخزان أقل من"
" <b>{0}%</b> ممتلئ، حتى يصبح ممتلائ بنسبة <b>{1}% )الحد األعلى(</b>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SMARTRESERVOIR.DEACTIVATE_TOOLTIP"
msgid ""
"Sends a <b><style=\"logic_off\">Red Signal</style></b> when reservoir is "
"<b>{0}%</b> full, until it is less than <b>{1}% (Low Threshold)</b> full"
msgstr ""
"يرسل <b><style=\"logic_off\">إشارة حمراء</style></b> عندما يكون المخزن "
"<b>{0}%</b> ممتلائ، حتى يصبح أقل من <b>{1}% )الحد األدنى(</b> ممتلائ"

msgctxt "STRINGS.BUILDINGS.PREFABS.SMARTRESERVOIR.LOGIC_PORT"
msgid "Refill Parameters"
msgstr "معايير إعادة الملء"

msgctxt "STRINGS.BUILDINGS.PREFABS.SMARTRESERVOIR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> when reservoir is "
"less than <b>Low Threshold</b> full, until <b>High Threshold</b> is reached "
"again"
msgstr ""
"يرسل <b><style=\"logic_on\">إشارة خضراء</style></b> عندما يكون الخزان أقل من"
" <b>الحد األدنى</b> ممتلائ، حتى يتم الوصول مرة أخرى إلى <b>الحد األعلى</b>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SMARTRESERVOIR.LOGIC_PORT_INACTIVE"
msgid ""
"Sends a <b><style=\"logic_off\">Red Signal</style></b> when reservoir is "
"<b>High Threshold</b> full, until <b>Low Threshold</b> is reached again"
msgstr ""
"يرسل <b><style=\"logic_off\">إشارة حمراء</style></b> عندما يكون الخزان "
"ممتلائ عند <b>الحد األعلى</b>، حتى يتم الوصول إلى <b>الحد األدنى</b> مرة "
"أخرى"

msgctxt "STRINGS.BUILDINGS.PREFABS.SMARTRESERVOIR.SIDESCREEN_ACTIVATE"
msgid "Low Threshold:"
msgstr "عتبة منخفضة:"

msgctxt "STRINGS.BUILDINGS.PREFABS.SMARTRESERVOIR.SIDESCREEN_DEACTIVATE"
msgid "High Threshold:"
msgstr "عتبة عالية:"

msgctxt "STRINGS.BUILDINGS.PREFABS.SMARTRESERVOIR.SIDESCREEN_TITLE"
msgid "Logic Activation Parameters"
msgstr "معلمات تفعيل المنطق"

msgctxt "STRINGS.BUILDINGS.PREFABS.SMOKER.DESC"
msgid "With a little patience, even tough meat can become deliciously edible."
msgstr "مع قليل من الصبر، حتى اللحوم القاسية يمكن أن تصبح صالحة لألكل ولذيذة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SMOKER.EFFECT"
msgid ""
"Cooks improved <link=\"FOOD\">foods</link> over low, slow heat.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"يقوم الطهاة بتحسين <link=\"FOOD\">األطعمة</link>لن يقوم المستنسخون بصنع العناصر إال إذا كانت الوصفات موجودة في قائمة االنتظار.\n"
"\n"
" على حرارة منخفضة وبطيئة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SMOKER.NAME"
msgid "<link=\"SMOKER\">Smoker</link>"
msgstr "<link=\"SMOKER\">مدخن</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SNOWTILE.DESC"
msgid ""
"Snow tiles have low thermal conductivity, but will melt if temperatures get "
"too high."
msgstr ""
"بالط الثلج له موصلية حرارية منخفضة، ولكنه سيذوب إذا ارتفعت درجات الحرارة "
"كثيرا."

msgctxt "STRINGS.BUILDINGS.PREFABS.SNOWTILE.EFFECT"
msgid ""
"Used to build the walls and floors of rooms.\n"
"\n"
"Insulates rooms to reduce <link=\"HEAT\">Heat</link> loss in cold climates."
msgstr ""
"تعزل الغرف لتقليل فقدان \n"
"\n"
"تستخدم لبناء جدران وأرضيات الغرف.<link=\"HEAT\">الحرارة</link> في المناخات الباردة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SNOWTILE.NAME"
msgid "<link=\"SNOWTILE\">Snow Tile</link>"
msgstr "<link=\"SNOWTILE\">بالطة الثلج</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SODAFOUNTAIN.DESC"
msgid "Sparkling water puts a twinkle in a Duplicant's eye."
msgstr "الماء الفوار يضيف بريقا في عين النسخة المكررة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SODAFOUNTAIN.EFFECT"
msgid ""
"Creates soda from <link=\"WATER\">Water</link> and <link=\"CARBONDIOXIDE\">Carbon Dioxide</link>.\n"
"\n"
"Consuming soda water increases Duplicant <link=\"MORALE\">Morale</link>."
msgstr ""
"يصنع الصودا من <link=\"WATER\">الماء</link> و <link=\"CARBONDIOXIDE\">ثاني أكسيد الكربون</link>استهالك مياه الصودا يزيد من \n"
"\n"
".<link=\"MORALE\">روح المعنوية</link> لدى المكرر."

msgctxt "STRINGS.BUILDINGS.PREFABS.SODAFOUNTAIN.NAME"
msgid "<link=\"SODAFOUNTAIN\">Soda Fountain</link>"
msgstr "<link=\"SODAFOUNTAIN\">نافورة الصودا</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLARPANEL.DESC"
msgid ""
"Solar panels convert high intensity sunlight into power and produce zero "
"waste."
msgstr ""
"تحول األلواح الشمسية ضوء الشمس العالي الكثافة إلى طاقة وتنتج صفر نفايات."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLARPANEL.EFFECT"
msgid ""
"Converts <link=\"LIGHT\">Sunlight</link> into electrical <link=\"POWER\">Power</link>.\n"
"\n"
"Must be exposed to space."
msgstr ""
"حول <link=\"LIGHT\">ضوء الشمس</link> إلى <link=\"POWER\">طاقة كهربائية</link>يجب أن يكون معرضا للفضاء.\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLARPANEL.NAME"
msgid "<link=\"SOLARPANEL\">Solar Panel</link>"
msgstr "<link=\"SOLARPANEL\">لوحة شمسية</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLARPANELMODULE.DESC"
msgid "Collect solar energy before takeoff and during flight."
msgstr "اجمع الطاقة الشمسية قبل اإلقالع وأثناء الطيران."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLARPANELMODULE.EFFECT"
msgid ""
"Converts <link=\"LIGHT\">Sunlight</link> into electrical <link=\"POWER\">Power</link> for use on rockets.\n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>. \n"
"\n"
"Must be exposed to space."
msgstr ""
"يحول <link=\"LIGHT\">ضوء الشمس</link> إلى <link=\"POWER\">طاقة كهربائية</link>يجب بناؤه عبر \n"
"\n"
" لالستخدام في الصواريخ.<link=\"LAUNCHPAD\">منصة الصواريخ</link>يجب أن يكون معرضا للفضاء.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLARPANELMODULE.NAME"
msgid "<link=\"SOLARPANELMODULE\">Solar Panel Module</link>"
msgstr "<link=\"SOLARPANELMODULE\">وحدة اللوحة الشمسية</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDBOOSTER.DESC"
msgid ""
"Additional thrusters allow rockets to reach far away space destinations."
msgstr "الصواريخ المزودة بدافعات إضافية تتيح الوصول إلى وجهات فضائية بعيدة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDBOOSTER.EFFECT"
msgid ""
"Burns <link=\"IRON\">Iron</link> and <link=\"OXYROCK\">Oxylite</link> to "
"increase rocket exploration distance."
msgstr ""
"يحرق <link=\"IRON\">الحديد</link> و<link=\"OXYROCK\">أوكساياليت</link> "
"لزيادة مسافة استكشاف الصواريخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDBOOSTER.NAME"
msgid "<link=\"SOLIDBOOSTER\">Solid Fuel Thruster</link>"
msgstr "<link=\"SOLIDBOOSTER\">دافع الوقود الصلب</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCARGOBAYSMALL.DESC"
msgid ""
"Duplicants will fill cargo bays with any resources they find during space "
"missions."
msgstr "سيمأل المكررون حواجز الشحن بأي موارد يجدونها أثناء بعثات الفضاء."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCARGOBAYSMALL.EFFECT"
msgid ""
"Allows Duplicants to store some of the <link=\"ELEMENTSSOLID\">Solid Materials</link> found during space missions.\n"
"\n"
"Stored resources become available to the colony upon the rocket's return. \n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr ""
"يتيح للمستنسخات تخزين بعض <link=\"ELEMENTSSOLID\">المواد الصلبة</link>يجب بناؤه عبر \n"
"\n"
"تصبح الموارد المخزنة متاحة للمستعمرة عند عودة الصاروخ.\n"
"\n"
" التي يتم العثور عليها خالل المهمات الفضائية.<link=\"LAUNCHPAD\">منصة الصاروخ</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCARGOBAYSMALL.NAME"
msgid "<link=\"SOLIDCARGOBAYSMALL\">Cargo Bay</link>"
msgstr "<link=\"SOLIDCARGOBAYSMALL\">حجرة الشحن</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUIT.DESC"
msgid ""
"Rails move materials where they'll be needed most, saving Duplicants the "
"walk."
msgstr ""
"تنقل القضبان المواد إلى األماكن التي ستحتاج إليها أكثر، موفرة على األشخاص "
"النسخ المشي."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUIT.EFFECT"
msgid ""
"Transports <link=\"ELEMENTSSOLID\">Solid Materials</link> on a track between <link=\"SOLIDCONDUITINBOX\">Conveyor Loader</link> and <link=\"SOLIDCONDUITOUTBOX\">Conveyor Receptacle</link>.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"ينقل <link=\"ELEMENTSSOLID\">المواد الصلبة</link> على مسار بين <link=\"SOLIDCONDUITINBOX\">محمل الناقل</link> و<link=\"SOLIDCONDUITOUTBOX\">حاوية الناقل</link>يمكن تشغيله عبر الحائط وبالط األرضية.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUIT.NAME"
msgid "<link=\"SOLIDCONDUIT\">Conveyor Rail</link>"
msgstr "<link=\"SOLIDCONDUIT\">سكة ناقلة</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITBRIDGE.DESC"
msgid ""
"Separating rail systems helps ensure materials go to the intended "
"destinations."
msgstr ""
"فصل أنظمة السكك الحديدية يساعد على ضمان وصول المواد إلى الوجهات المقصودة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITBRIDGE.EFFECT"
msgid ""
"Runs one <link=\"SOLIDCONDUIT\">Conveyor Rail</link> section over another without joining them.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"يشغل قسما واحدا من <link=\"SOLIDCONDUIT\">سكة ناقلة</link>يمكن تشغيله عبر الحائط وبالط األرضية.\n"
"\n"
" فوق قسم آخر دون ربطهما."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITBRIDGE.NAME"
msgid "<link=\"SOLIDCONDUITBRIDGE\">Conveyor Bridge</link>"
msgstr "<link=\"SOLIDCONDUITBRIDGE\">جسر الناقل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.DESC"
msgid ""
"Germ sensors can help control automation behavior in the presence of germs."
msgstr ""
"يمكن ألجهزة استشعار الجراثيم أن تساعد في التحكم في سلوك األتمتة في وجود "
"الجراثيم."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a "
"<b><style=\"logic_off\">Red Signal</style></b> based on the internal "
"<link=\"DISEASE\">Germ</link> count of the object on the rail."
msgstr ""
"يرسل <b><style=\"logic_on\">إشارة خضراء</style></b> أو "
"<b><style=\"logic_off\">إشارة حمراء</style></b> بناء على عدد "
"<link=\"DISEASE\">الجراثيم</link> الداخلية للجسم على السكة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.LOGIC_PORT"
msgid "Internal <link=\"DISEASE\">Germ</link> Count"
msgstr "العدوى الداخلية للجراثيم"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if the number of "
"Germs on the object on the rail is within the selected range"
msgstr ""
"يرسل <b><style=\"logic_on\">إشارة خضراء</style></b> إذا كان عدد الجراثيم على"
" الجسم على السكة ضمن النطاق المحدد"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "وإال، يرسل <b><style=\"logic_off\">إشارة حمراء</style></b>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITDISEASESENSOR.NAME"
msgid "<link=\"SOLIDCONDUITDISEASESENSOR\">Conveyor Rail Germ Sensor</link>"
msgstr "<link=\"SOLIDCONDUITDISEASESENSOR\">مستشعر الجراثيم لمسار الناقل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.DESC"
msgid ""
"Element sensors can be used to detect the presence of a specific item on a "
"rail."
msgstr "يمكن استخدام حساسات العناصر الكتشاف وجود عنصر معين على السكة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> when the selected "
"item is detected on a rail."
msgstr ""
"يرسل <b><style=\"logic_on\">إشارة خضراء</style></b> عند اكتشاف العنصر المحدد"
" على السكة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.LOGIC_PORT"
msgid "Internal <link=\"ELEMENTSLIQUID\">Item</link> Presence"
msgstr "وجود <link=\"ELEMENTSLIQUID\">العنصر</link> الداخلي"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if the configured "
"item is detected on the rail"
msgstr ""
"يرسل <b><style=\"logic_on\">إشارة خضراء</style></b> إذا تم اكتشاف العنصر "
"المكون على السكة"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "وإال، يرسل <b><style=\"logic_off\">إشارة حمراء</style></b>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITELEMENTSENSOR.NAME"
msgid "<link=\"SOLIDCONDUITELEMENTSENSOR\">Conveyor Rail Element Sensor</link>"
msgstr "<link=\"SOLIDCONDUITELEMENTSENSOR\">مستشعر عنصر سكة النقل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITINBOX.DESC"
msgid ""
"Material filters can be used to determine what resources are sent down the "
"rail."
msgstr "يمكن استخدام مرشحات المواد لتحديد الموارد التي ترسل عبر السكة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITINBOX.EFFECT"
msgid ""
"Loads <link=\"ELEMENTSSOLID\">Solid Materials</link> onto <link=\"SOLIDCONDUIT\">Conveyor Rail</link> for transport.\n"
"\n"
"Only loads the resources of your choosing."
msgstr ""
"يحمل <link=\"ELEMENTSSOLID\">المواد الصلبة</link> على <link=\"SOLIDCONDUIT\">سكة النقل</link>يحمل فقط الموارد التي تختارها.\n"
"\n"
" للنقل."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITINBOX.NAME"
msgid "<link=\"SOLIDCONDUITINBOX\">Conveyor Loader</link>"
msgstr "<link=\"SOLIDCONDUITINBOX\">رافعة ناقلة</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITOUTBOX.DESC"
msgid ""
"When materials reach the end of a rail they enter a receptacle to be used by"
" Duplicants."
msgstr "عندما تصل المواد إلى نهاية السكة، تدخل في وعاء ليستخدمها النسخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITOUTBOX.EFFECT"
msgid ""
"Unloads <link=\"ELEMENTSSOLID\">Solid Materials</link> from a "
"<link=\"SOLIDCONDUIT\">Conveyor Rail</link> into storage."
msgstr ""
"يفرغ <link=\"ELEMENTSSOLID\">المواد الصلبة</link> من "
"<link=\"SOLIDCONDUIT\">سكة النقل</link> إلى التخزين."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITOUTBOX.NAME"
msgid "<link=\"SOLIDCONDUITOUTBOX\">Conveyor Receptacle</link>"
msgstr "<link=\"SOLIDCONDUITOUTBOX\">وعاء الناقل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.DESC"
msgid ""
"Thermo sensors disable buildings when their rail contents reach a certain "
"temperature."
msgstr ""
"تقوم أجهزة االستشعار الحرارية بإيقاف تشغيل المباني عندما تصل محتويات سككها "
"إلى درجة حرارة معينة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a "
"<b><style=\"logic_off\">Red Signal</style></b> when rail contents enter the "
"chosen <link=\"HEAT\">Temperature</link> range."
msgstr ""
"يرسل <b><style=\"logic_on\">إشارة خضراء</style></b> أو "
"<b><style=\"logic_off\">إشارة حمراء</style></b> عندما تدخل محتويات السكك "
"الحديدية نطاق <link=\"HEAT\">درجة الحرارة</link> المختار."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.LOGIC_PORT"
msgid "Internal Item <link=\"HEAT\">Temperature</link>"
msgstr "عنصر داخلي <link=\"HEAT\">درجة الحرارة</link>"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if the contained "
"item is within the selected Temperature range"
msgstr ""
"يرسل <b><style=\"logic_on\">إشارة خضراء</style></b> إذا كان العنصر المحتوى "
"ضمن نطاق درجة الحرارة المحدد"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "وإال، يرسل <b><style=\"logic_off\">إشارة حمراء</style></b>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDCONDUITTEMPERATURESENSOR.NAME"
msgid "<link=\"SOLIDCONDUITTEMPERATURESENSOR\">Conveyor Rail Thermo Sensor</link>"
msgstr "<link=\"SOLIDCONDUITTEMPERATURESENSOR\">مستشعر حرارة سكة الناقل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDFILTER.DESC"
msgid ""
"All solids are sent into the building's output conveyor, except the solid "
"chosen for filtering."
msgstr ""
"يتم إرسال جميع المواد الصلبة إلى ناقل اإلخراج في المبنى، باستثناء المادة "
"الصلبة المختارة للترشيح."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDFILTER.EFFECT"
msgid ""
"Separates one <link=\"ELEMENTSSOLID\">Solid Material</link> from the "
"conveyor, sending it into a dedicated <link=\"SOLIDCONDUIT\">Conveyor "
"Rail</link>."
msgstr ""
"يفصل مادة صلبة واحدة <link=\"ELEMENTSSOLID\">عن الناقل</link>، ويرسلها إلى "
"<link=\"SOLIDCONDUIT\">مسار ناقل مخصص</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDFILTER.ELEMENT_NOT_SPECIFIED"
msgid "Not Specified"
msgstr "غير محدد"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDFILTER.NAME"
msgid "<link=\"SOLIDFILTER\">Solid Filter</link>"
msgstr "<link=\"SOLIDFILTER\">فلتر صلب</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDFILTER.STATUS_ITEM"
msgid "Filters: {0}"
msgstr "المرشحات: {0}"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.DESC"
msgid ""
"Conveyor Meters let an exact amount of materials pass through before "
"shutting off."
msgstr "تسمح موازين النقل بمرور كمية دقيقة من المواد قبل اإليقاف."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.EFFECT"
msgid ""
"Connects to an <link=\"LOGIC\">Automation</link> grid to automatically turn "
"material transfer off when the specified amount has passed through it."
msgstr ""
"يتصل بشبكة <link=\"LOGIC\">األتمتة</link> إليقاف نقل المواد تلقائيا عندما "
"يمر الكمية المحددة من خاللها."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.LOGIC_PORT_OUTPUT"
msgid "Limit Reached"
msgstr "تم الوصول إلى الحد"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.LOGIC_PORT_RESET"
msgid "Reset Meter"
msgstr "إعادة ضبط العداد"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.NAME"
msgid "<link=\"SOLIDLIMITVALVE\">Conveyor Meter</link>"
msgstr "<link=\"SOLIDLIMITVALVE\">عداد الناقل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.OUTPUT_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if limit has been "
"reached"
msgstr ""
"يرسل <b><style=\"logic_on\">إشارة خضراء</style></b> إذا تم الوصول إلى الحد"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.OUTPUT_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "وإال، يرسل <b><style=\"logic_off\">إشارة حمراء</style></b>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.RESET_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Reset the amount"
msgstr "<b><style=\"logic_on\">إشارة خضراء</style></b>: أعد ضبط المبلغ"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLIMITVALVE.RESET_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Nothing"
msgstr "<b><style=\"logic_off\">إشارة حمراء</style></b>: ال شيء"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.DESC"
msgid ""
"Automated conveyors save power and time by removing the need for Duplicant "
"input."
msgstr ""
"تعمل السيور الناقلة اآللية على توفير الطاقة والوقت من خالل إزالة الحاجة إلى "
"إدخال tnacilpuD."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.EFFECT"
msgid ""
"Connects to an <link=\"LOGIC\">Automation</link> grid to automatically turn "
"<link=\"ELEMENTSSOLID\">Solid Material</link> transport on or off."
msgstr ""
"يتصل بشبكة <link=\"LOGIC\">األتمتة</link> لتشغيل أو إيقاف "
"<link=\"ELEMENTSSOLID\">نقل المواد الصلبة</link> تلقائيا."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.LOGIC_PORT"
msgid "Open/Close"
msgstr "فتح/إغالق"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Allow material transport"
msgstr "<b><style=\"logic_on\">إشارة خضراء</style></b>: السماح بنقل المواد"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Prevent material transport"
msgstr "<b><style=\"logic_off\">إشارة حمراء</style></b>: منع نقل المواد"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDLOGICVALVE.NAME"
msgid "<link=\"SOLIDLOGICVALVE\">Conveyor Shutoff</link>"
msgstr "<link=\"SOLIDLOGICVALVE\">إيقاف الحزام الناقل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDTRANSFERARM.DESC"
msgid ""
"An auto-sweeper's range can be viewed at any time by (ClickType/clicking) on"
" the building."
msgstr ""
"يمكن عرض نطاق آلة الكنس اآللية في أي وقت عن طريق )نوع النقر/النقر( على "
"المبنى."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDTRANSFERARM.EFFECT"
msgid ""
"Automates <link=\"CHORES\">Sweeping</link> and <link=\"CHORES\">Supplying</link> errands by sucking up all nearby <link=\"DECOR\">Debris</link>.\n"
"\n"
"Materials are automatically delivered to any <link=\"SOLIDCONDUITINBOX\">Conveyor Loader</link>, <link=\"SOLIDCONDUITOUTBOX\">Conveyor Receptacle</link>, storage, or buildings within range."
msgstr ""
"يقوم بأتمتة مهام <link=\"CHORES\">كنس</link> و<link=\"CHORES\">تزويد</link> عن طريق امتصاص جميع <link=\"DECOR\">الحطام</link>يتم تسليم المواد تلقائيا إلى أي \n"
"\n"
" القريب.<link=\"SOLIDCONDUITINBOX\">محمل ناقل</link> ،<link=\"SOLIDCONDUITOUTBOX\">مستقبل ناقل</link>، تخزين، أو مباني ضمن النطاق."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDTRANSFERARM.NAME"
msgid "<link=\"SOLIDTRANSFERARM\">Auto-Sweeper</link>"
msgstr "<link=\"SOLIDTRANSFERARM\">المكنسة األوتوماتيكية</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDVENT.DESC"
msgid ""
"When materials reach the end of a rail they are dropped back into the world."
msgstr "عندما تصل المواد إلى نهاية السكة، تسقط مرة أخرى في العالم."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDVENT.EFFECT"
msgid ""
"Unloads <link=\"ELEMENTSSOLID\">Solid Materials</link> from a "
"<link=\"SOLIDCONDUIT\">Conveyor Rail</link> onto the floor."
msgstr ""
"يفرغ <link=\"ELEMENTSSOLID\">المواد الصلبة</link> من "
"<link=\"SOLIDCONDUIT\">سكة النقل</link> على األرض."

msgctxt "STRINGS.BUILDINGS.PREFABS.SOLIDVENT.NAME"
msgid "<link=\"SOLIDVENT\">Conveyor Chute</link>"
msgstr "<link=\"SOLIDVENT\">مزلق ناقل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SPACEHEATER.DESC"
msgid "Space heaters are a welcome cure for cold, soggy feet."
msgstr "مدافئ الفضاء عالج مرحب به لألقدام الباردة المبتلة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SPACEHEATER.EFFECT"
msgid ""
"Radiates a moderate amount of <link=\"HEAT\">Heat</link>.\n"
"\n"
"Requires <link=\"POWER\">Power</link> in order to function."
msgstr ""
"يشع كمية معتدلة من <link=\"HEAT\">الحرارة</link>يتطلب \n"
"\n"
".<link=\"POWER\">الطاقة</link> لكي يعمل."

msgctxt "STRINGS.BUILDINGS.PREFABS.SPACEHEATER.NAME"
msgid "<link=\"SPACEHEATER\">Space Heater</link>"
msgstr "<link=\"SPACEHEATER\">مدفأة فضائية</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAY.DESC"
msgid ""
"Biological cargo bays allow Duplicants to retrieve alien plants and wildlife"
" from space."
msgstr ""
"تسمح حظائر الشحن البيولوجية للنسخ باسترجاع النباتات والكائنات الفضائية من "
"الفضاء."

msgctxt "STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAY.EFFECT"
msgid ""
"Allows Duplicants to store unusual or organic resources found during space missions.\n"
"\n"
"Stored resources become available to the colony upon the rocket's return."
msgstr ""
"تصبح الموارد المخزنة متاحة للمستعمرة عند عودة الصاروخ.\n"
"\n"
"يسمح للنسخ بتخزين الموارد غير المألوفة أو العضوية التي تم العثور عليها أثناء البعثات الفضائية."

msgctxt "STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAY.NAME"
msgid "<link=\"SPECIALCARGOBAY\">Biological Cargo Bay</link>"
msgstr "<link=\"SPECIALCARGOBAY\">حجرة الشحن البيولوجية</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAYCLUSTER.DESC"
msgid "Critters do not require feeding during transit."
msgstr "الكائنات الصغيرة ال تحتاج إلى تغذية أثناء النقل."

msgctxt "STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAYCLUSTER.EFFECT"
msgid ""
"Allows Duplicants to transport <link=\"CREATURES\">Critters</link> through space.\n"
"\n"
"Specimens can be released into the colony upon the rocket's return.\n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr ""
"يسمح للنسخ بنقل <link=\"CREATURES\">المخلوقات</link>يجب بناؤه عبر \n"
"\n"
"يمكن إطالق العينات في المستعمرة عند عودة الصاروخ.\n"
"\n"
" عبر الفضاء.<link=\"LAUNCHPAD\">منصة الصواريخ</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAYCLUSTER.NAME"
msgid "<link=\"SPECIALCARGOBAYCLUSTER\">Critter Cargo Bay</link>"
msgstr "<link=\"SPECIALCARGOBAYCLUSTER\">عنبر شحن الكائنات الصغيرة</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAYCLUSTER.RELEASE_BTN"
msgid "Release Critter"
msgstr "أطلق المخلوق"

msgctxt "STRINGS.BUILDINGS.PREFABS.SPECIALCARGOBAYCLUSTER.RELEASE_BTN_TOOLTIP"
msgid "Release the critter stored inside"
msgstr "أطلق المخلوق المخزن بالداخل"

msgctxt "STRINGS.BUILDINGS.PREFABS.SPICEGRINDER.DESC"
msgid ""
"Crushed seeds and other edibles make excellent meal-enhancing additives."
msgstr ""
"البذور المطحونة واألطعمة األخرى الصالحة لألكل تعتبر إضافات ممتازة لتحسين "
"الوجبة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SPICEGRINDER.EFFECT"
msgid ""
"Produces ingredients that add benefits to <link=\"FOOD\">foods</link> "
"prepared at skilled cooking stations."
msgstr ""
"ينتج مكونات تضيف فوائد إلى <link=\"FOOD\">األطعمة</link> المحضرة في محطات "
"الطهي الماهرة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SPICEGRINDER.INGREDIENTHEADER"
msgid "Ingredients per 1000kcal:"
msgstr "المكونات لكل 0001 سعرة حرارية:"

msgctxt "STRINGS.BUILDINGS.PREFABS.SPICEGRINDER.NAME"
msgid "<link=\"SPICEGRINDER\">Spice Grinder</link>"
msgstr "<link=\"SPICEGRINDER\">مطحنة التوابل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.STATERPILLAREGG.DESC"
msgid "The electrifying egg of the <link=\"STATERPILLAR\">Plug Slug</link>."
msgstr "البيضة الصاعقة لـ <link=\"STATERPILLAR\">سلغ الموصل</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.STATERPILLAREGG.EFFECT"
msgid ""
"Slug Eggs can be connected to a <link=\"POWER\">Power</link> circuit as an "
"energy source."
msgstr "يمكن توصيل بيض الحلزون بدائرة <link=\"POWER\">الطاقة</link> كمصدر للطاقة."

msgctxt "STRINGS.BUILDINGS.PREFABS.STATERPILLAREGG.NAME"
msgid "<link=\"STATERPILLAREGG\">Slug Egg</link>"
msgstr "<link=\"STATERPILLAREGG\">بيضة الرخوة</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.STATERPILLARGENERATOR.MODIFIERS.HUNGRY"
msgid "Hungry!"
msgstr "جائع!"

msgctxt "STRINGS.BUILDINGS.PREFABS.STATERPILLARGENERATOR.MODIFIERS.WILD"
msgid "Wild!"
msgstr "مجنون!"

msgctxt "STRINGS.BUILDINGS.PREFABS.STATERPILLARGENERATOR.NAME"
msgid "<link=\"STATERPILLAR\">Plug Slug</link>"
msgstr "<link=\"STATERPILLAR\">سدادة قابس</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMENGINE.DESC"
msgid ""
"Rockets can be used to send Duplicants into space and retrieve rare "
"resources."
msgstr ""
"يمكن استخدام الصواريخ إلرسال النسخ المتماثلة إلى الفضاء واسترجاع الموارد "
"النادرة."

msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMENGINE.EFFECT"
msgid ""
"Utilizes <link=\"STEAM\">Steam</link> to propel rockets for space exploration.\n"
"\n"
"The engine of a rocket must be built first before more rocket modules may be added."
msgstr ""
"يستخدم <link=\"STEAM\">ستيم</link>يجب بناء محرك الصاروخ أوال قبل إمكانية إضافة المزيد من وحدات الصاروخ.\n"
"\n"
" لدفع الصواريخ الستكشاف الفضاء."

msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMENGINE.NAME"
msgid "<link=\"STEAMENGINE\">Steam Engine</link>"
msgstr "<link=\"STEAMENGINE\">المحرك البخاري</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMENGINECLUSTER.DESC"
msgid ""
"Rockets can be used to send Duplicants into space and retrieve rare "
"resources."
msgstr ""
"يمكن استخدام الصواريخ إلرسال النسخ المتماثلة إلى الفضاء واسترجاع الموارد "
"النادرة."

msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMENGINECLUSTER.EFFECT"
msgid ""
"Utilizes <link=\"STEAM\">Steam</link> to propel rockets for space exploration.\n"
"\n"
"Engine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>. \n"
"\n"
"Once the engine has been built, more rocket modules can be added."
msgstr ""
"يستفيد من <link=\"STEAM\">ستيم</link>يجب بناء المحرك عبر \n"
"\n"
" لدفع الصواريخ الستكشاف الفضاء.<link=\"LAUNCHPAD\">منصة الصواريخ</link>بمجرد بناء المحرك، يمكن إضافة المزيد من وحدات الصاروخ.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMENGINECLUSTER.NAME"
msgid "<link=\"STEAMENGINECLUSTER\">Steam Engine</link>"
msgstr "<link=\"STEAMENGINECLUSTER\">محرك البخار</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMTURBINE.DESC"
msgid ""
"Useful for converting the geothermal energy of magma into usable power."
msgstr "مفيد لتحويل الطاقة الحرارية الجوفية للصهارة إلى طاقة قابلة لالستخدام."

msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMTURBINE.EFFECT"
msgid ""
"THIS BUILDING HAS BEEN DEPRECATED AND CANNOT BE BUILT.\n"
"\n"
"Generates exceptional electrical <link=\"POWER\">Power</link> using pressurized, <link=\"HEAT\">Scalding</link> <link=\"STEAM\">Steam</link>.\n"
"\n"
"Outputs significantly cooler <link=\"STEAM\">Steam</link> than it receives.\n"
"\n"
"Air pressure beneath this building must be higher than pressure above for air to flow."
msgstr ""
"يولد طاقة كهربائية استثنائية باستخدام \n"
"\n"
"تم إهمال هذا المبنى وال يمكن بناؤه.<link=\"HEAT\">بخار</link> <link=\"STEAM\">ساخن</link>يخرج \n"
"\n"
" مضغوط.<link=\"STEAM\">بخار</link>يجب أن تكون ضغط الهواء أسفل هذا المبنى أعلى من الضغط أعاله لكي يتدفق الهواء.\n"
"\n"
" أبرد بكثير مما يستقبله."

msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMTURBINE.NAME"
msgid "<link=\"STEAMTURBINE\">[DEPRECATED] Steam Turbine</link>"
msgstr "<link=\"STEAMTURBINE\">]مهمل[ التوربين البخاري</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMTURBINE2.DESC"
msgid "Useful for converting the geothermal energy into usable power."
msgstr "مفيد لتحويل الطاقة الحرارية الجوفية إلى طاقة قابلة لالستخدام."

msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMTURBINE2.EFFECT"
msgid ""
"Draws in <link=\"STEAM\">Steam</link> from the tiles directly below the machine's foundation and uses it to generate electrical <link=\"POWER\">Power</link>.\n"
"\n"
"Outputs <link=\"WATER\">Water</link>."
msgstr ""
"يسحب <link=\"STEAM\">البخار</link> من القطع مباشرة تحت أساس الماكينة ويستخدمه لتوليد <link=\"POWER\">الطاقة الكهربائية</link>ينتج \n"
"\n"
".<link=\"WATER\">الماء</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMTURBINE2.HEAT_SOURCE"
msgid "Power Generation Waste"
msgstr "نفايات توليد الطاقة"

msgctxt "STRINGS.BUILDINGS.PREFABS.STEAMTURBINE2.NAME"
msgid "<link=\"STEAMTURBINE2\">Steam Turbine</link>"
msgstr "<link=\"STEAMTURBINE2\">توربين بخاري</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.STICKERBOMB.DESC"
msgid "Surprise decor sneak attacks a Duplicant's gloomy day."
msgstr "الهجمات المفاجئة للديكور تفاجئ يوم الدوبليكانت الكئيب."

msgctxt "STRINGS.BUILDINGS.PREFABS.STICKERBOMB.NAME"
msgid "<link=\"STICKERBOMB\">Sticker Bomb</link>"
msgstr "<link=\"STICKERBOMB\">قنبلة الملصقات</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.DESC"
msgid ""
"Resources left on the floor become \"debris\" and lower decor when not put "
"away."
msgstr ""
"الموارد التي تترك على األرض تتحول إلى \"حطام\" وتقلل من الديكور إذا لم ترتب."

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.EFFECT"
msgid ""
"Stores the <link=\"ELEMENTSSOLID\">Solid Materials</link> of your choosing."
msgstr "يخزن <link=\"ELEMENTSSOLID\">المواد الصلبة</link> التي تختارها."

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.BLUE_BABYTEARS.DESC"
msgid "Color-coded storage makes things easier to find."
msgstr "التخزين المرمز باأللوان يجعل من السهل العثور على األشياء."

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.BLUE_BABYTEARS.NAME"
msgid "<link=\"STORAGELOCKER\">Weepy Blue Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">صندوق تخزين أزرق باك</link>"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.DEFAULT_STORAGELOCKER.DESC"
msgid ""
"Resources left on the floor become \"debris\" and lower decor when not put "
"away."
msgstr ""
"الموارد التي تترك على األرض تتحول إلى \"حطام\" وتقلل من الديكور إذا لم ترتب."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.DEFAULT_STORAGELOCKER.NAME"
msgid "<link=\"STORAGELOCKER\">Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">حاوية تخزين</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.GREEN_MUSH.DESC"
msgid "Color-coded storage makes things easier to find."
msgstr "التخزين المرمز باأللوان يجعل من السهل العثور على األشياء."

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.GREEN_MUSH.NAME"
msgid "<link=\"STORAGELOCKER\">Mush Green Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">صندوق تخزين أخضر فطر</link>"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.POLKA_DARKNAVYNOOKGREEN.DESC"
msgid "A fun storage solution for fun-damental materials."
msgstr "حل تخزين ممتع للمواد األساسية الممتعة."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.POLKA_DARKNAVYNOOKGREEN.NAME"
msgid "<link=\"STORAGELOCKER\">Party Dot Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">حاوية تخزين حفالت دوت</link>"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.POLKA_DARKPURPLERESIN.DESC"
msgid "Groovy storage, because messy colonies are such a drag."
msgstr "تخزين رائع، ألن المستعمرات الفوضوية مزعجة جدا."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.POLKA_DARKPURPLERESIN.NAME"
msgid "<link=\"STORAGELOCKER\">Mod Dot Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">صندوق تخزين مود دوت</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.PURPLE_BRAINFAT.DESC"
msgid "Color-coded storage makes things easier to find."
msgstr "التخزين المرمز باأللوان يجعل من السهل العثور على األشياء."

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.PURPLE_BRAINFAT.NAME"
msgid "<link=\"STORAGELOCKER\">Faint Purple Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">صندوق تخزين بنفسجي فاتح</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.RED_ROSE.DESC"
msgid "Color-coded storage makes things easier to find."
msgstr "التخزين المرمز باأللوان يجعل من السهل العثور على األشياء."

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.RED_ROSE.NAME"
msgid "<link=\"STORAGELOCKER\">Puce Pink Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">صندوق تخزين وردي غامق</link>"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.STRIPES_RED_WHITE.DESC"
msgid "It's the merriest storage bin of all."
msgstr "إنه أكثر صندوق تخزين مرحا على اإلطالق."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.STRIPES_RED_WHITE.NAME"
msgid "Bold Stripe Storage Bin"
msgstr "صندوق تخزين مخطط غامق"

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.YELLOW_TARTAR.DESC"
msgid "Color-coded storage makes things easier to find."
msgstr "التخزين المرمز باأللوان يجعل من السهل العثور على األشياء."

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.YELLOW_TARTAR.NAME"
msgid "<link=\"STORAGELOCKER\">Ick Yellow Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">صندوق تخزين أصفر إيكي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.NAME"
msgid "<link=\"STORAGELOCKER\">Storage Bin</link>"
msgstr "<link=\"STORAGELOCKER\">حاوية تخزين</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.DESC"
msgid ""
"Smart storage bins can automate resource organization based on type and "
"mass."
msgstr "يمكن للحاويات الذكية تخزين الموارد تلقائيا بناء على النوع والكتلة."

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.EFFECT"
msgid ""
"Stores the <link=\"ELEMENTSSOLID\">Solid Materials</link> of your choosing.\n"
"\n"
"Sends a <b><style=\"logic_on\">Green Signal</style></b> when bin is full."
msgstr ""
"يخزن <link=\"ELEMENTSSOLID\">المواد الصلبة</link>يرسل \n"
"\n"
" التي تختارها.<b><style=\"logic_on\">إشارة خضراء</style></b> عند امتالء الحاوية."

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.LOGIC_PORT"
msgid "Full/Not Full"
msgstr "ممتلئ / غير ممتلئ"

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when full"
msgstr "يرسل <b><style=\"logic_on\">إشارة خضراء</style></b> عند االمتالء"

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "وإال، يرسل <b><style=\"logic_off\">إشارة حمراء</style></b>"

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.NAME"
msgid "<link=\"STORAGELOCKERSMART\">Smart Storage Bin</link>"
msgstr "<link=\"STORAGELOCKERSMART\">صندوق التخزين الذكي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGETILE.DESC"
msgid "Storage tiles keep selected non-edible solids out of the way."
msgstr ""
"تقوم بالطات التخزين بإبقاء المواد الصلبة غير القابلة لألكل المختارة بعيدا عن"
" الطريق."

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGETILE.EFFECT"
msgid ""
"Used to build the walls and floors of rooms.\n"
"\n"
"Provides built-in storage for small spaces."
msgstr "يستخدم لبناء جدران وأرضيات الغرف. يوفر تخزينا مدمجا للمساحات الصغيرة."

msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGETILE.NAME"
msgid "<link=\"STORAGETILE\">Storage Tile</link>"
msgstr "<link=\"STORAGETILE\">بالطة التخزين</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SUBLIMATIONSTATION.DESC"
msgid ""
"Sublimation is the sublime process by which solids convert directly into "
"gas."
msgstr ""
"التسامي هو العملية السامية التي تتحول فيها المواد الصلبة مباشرة إلى غاز."

msgctxt "STRINGS.BUILDINGS.PREFABS.SUBLIMATIONSTATION.EFFECT"
msgid ""
"Speeds up the conversion of <link=\"TOXICSAND\">Polluted Dirt</link> into <link=\"CONTAMINATEDOXYGEN\">Polluted Oxygen</link>.\n"
"\n"
"Becomes idle when the area reaches maximum pressure capacity."
msgstr ""
"يسرع تحويل <link=\"TOXICSAND\">األوساخ الملوثة</link> إلى <link=\"CONTAMINATEDOXYGEN\">األكسجين الملوث</link>يصبح خامال عندما تصل المنطقة إلى الحد األقصى من الضغط.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.SUBLIMATIONSTATION.NAME"
msgid "<link=\"SUBLIMATIONSTATION\">Sublimation Station</link>"
msgstr "<link=\"SUBLIMATIONSTATION\">محطة التسامي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SUGARENGINE.DESC"
msgid "Not the most stylish way to travel space, but certainly the tastiest."
msgstr "ليست الطريقة األكثر أناقة للسفر في الفضاء، لكنها بالتأكيد األكثر لذة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SUGARENGINE.EFFECT"
msgid ""
"Burns <link=\"SUCROSE\">Sucrose</link> to propel rockets for short range space exploration.\n"
"\n"
"Sugar Engines have higher height restrictions than <link=\"CO2ENGINE\">Carbon Dioxide Engines</link>, but move slower.\n"
"\n"
"Engine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>, and requires a <link=\"OXIDIZERTANKCLUSTER\">Large Solid Oxidizer Tank</link>. \n"
"\n"
"Once the engine has been built, more rocket modules can be added."
msgstr ""
"تحرق <link=\"SUCROSE\">السكروز</link>تمتلك محركات السكر قيود ارتفاع أعلى من \n"
"\n"
" لدفع الصواريخ الستكشاف الفضاء على المدى القصير.<link=\"CO2ENGINE\">محركات ثاني أكسيد الكربون</link>يجب بناء المحرك عبر \n"
"\n"
"، لكنها تتحرك أبطأ.<link=\"LAUNCHPAD\">منصة اإلطالق</link>، ويتطلب <link=\"OXIDIZERTANKCLUSTER\">خزان مؤكسد صلب كبير</link>بمجرد بناء المحرك، يمكن إضافة المزيد من وحدات الصواريخ.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.SUGARENGINE.NAME"
msgid "<link=\"SUGARENGINE\">Sugar Engine</link>"
msgstr "<link=\"SUGARENGINE\">محرك السكر</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SUITFABRICATOR.DESC"
msgid ""
"Exosuits can be filled with oxygen to allow Duplicants to safely enter "
"hazardous areas."
msgstr ""
"يمكن ملء البدالت الخارجية باألكسجين للسماح للنسخ بالدخول بأمان إلى المناطق "
"الخطرة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SUITFABRICATOR.EFFECT"
msgid ""
"Forges protective <link=\"EQUIPMENT\">Exosuits</link> for Duplicants to wear.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"يصنع <link=\"EQUIPMENT\">بدالت خارجية</link>لن يقوم المكررون بصناعة العناصر إال إذا كانت الوصفات مصطفة في القائمة.\n"
" واقية لكي يرتديها المكررون."

msgctxt "STRINGS.BUILDINGS.PREFABS.SUITFABRICATOR.NAME"
msgid "<link=\"SUITFABRICATOR\">Exosuit Forge</link>"
msgstr "<link=\"SUITFABRICATOR\">مصنع الدراع الخارجية</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SUITLOCKER.DESC"
msgid ""
"An atmo suit dock will empty atmo suits of waste, but only one suit can "
"charge at a time."
msgstr ""
"محطة ربط بدلة الجو ستفرغ نفايات بدالت الجو، لكن يمكن شحن بدلة واحدة فقط في "
"كل مرة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SUITLOCKER.EFFECT"
msgid ""
"Stores <link=\"ATMOSUIT\">Atmo Suits</link> and refuels them with <link=\"OXYGEN\">Oxygen</link>.\n"
"\n"
"Empties suits of <link=\"DIRTYWATER\">Polluted Water</link>.\n"
"\n"
"Build next to an <link=\"SUITMARKER\">Atmo Suit Checkpoint</link> to make Duplicants change into suits when passing by."
msgstr ""
"تخزن <link=\"ATMOSUIT\">بدالت أتمو</link> وتزودها بالوقود باستخدام <link=\"OXYGEN\">األكسجين</link>تفرغ البدالت من \n"
"\n"
".<link=\"DIRTYWATER\">المياه الملوثة</link>ابن بجوار \n"
"\n"
".<link=\"SUITMARKER\">نقطة تفتيش بدالت أتمو</link> لجعل النسخ تتغير إلى البدالت عند المرور بجانبها."

msgctxt "STRINGS.BUILDINGS.PREFABS.SUITLOCKER.NAME"
msgid "<link=\"SUITLOCKER\">Atmo Suit Dock</link>"
msgstr "<link=\"SUITLOCKER\">مرسى بذلة األجواء</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SUITMARKER.DESC"
msgid ""
"A checkpoint must have a correlating dock built on the opposite side its "
"arrow faces."
msgstr ""
"يجب أن يكون لنقطة التفتيش رصيف مطابق مبني على الجانب المقابل لالتجاه الذي "
"تشير إليه السهم."

msgctxt "STRINGS.BUILDINGS.PREFABS.SUITMARKER.EFFECT"
msgid ""
"Marks a threshold where Duplicants must change into or out of <link=\"ATMOSUIT\">Atmo Suits</link>.\n"
"\n"
"Must be built next to an <link=\"SUITLOCKER\">Atmo Suit Dock</link>.\n"
"\n"
"Can be rotated before construction."
msgstr ""
"يشير إلى عتبة يجب على النسخ المزدوجة تغيير مالبسها إلى أو من <link=\"ATMOSUIT\">بدالت األجواء</link>يجب بناؤه بجانب \n"
"\n"
".<link=\"SUITLOCKER\">رصيف بدالت األجواء</link>يمكن تدويره قبل البناء.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.SUITMARKER.NAME"
msgid "<link=\"SUITMARKER\">Atmo Suit Checkpoint</link>"
msgstr "<link=\"SUITMARKER\">نقطة تفتيش بدلة أتومو</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SUNLAMP.DESC"
msgid "An artificial ray of sunshine."
msgstr "شعاع صناعي من أشعة الشمس."

msgctxt "STRINGS.BUILDINGS.PREFABS.SUNLAMP.EFFECT"
msgid ""
"Gives off <link=\"LIGHT\">Sunlight</link> level Lux.\n"
"\n"
"Can be paired with <link=\"BEACHCHAIR\">Beach Chairs</link>."
msgstr ""
"يطلق مستوى اإلضاءة <link=\"LIGHT\">أشعة الشمس</link>يمكن إقرانه بـ \n"
"\n"
" لوكس.<link=\"BEACHCHAIR\">كراسي الشاطئ</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.SUNLAMP.NAME"
msgid "<link=\"SUNLAMP\">Sun Lamp</link>"
msgstr "<link=\"SUNLAMP\">مصباح الشمس</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.DESC"
msgid "Rare materials can be procured through rocket missions into space."
msgstr "يمكن الحصول على المواد النادرة من خالل بعثات صاروخية إلى الفضاء."

msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.EFFECT"
msgid ""
"Processes <link=\"RAREMATERIALS\">Rare Materials</link> into advanced industrial goods.\n"
"\n"
"Rare materials can be retrieved from space missions.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"يعالج <link=\"RAREMATERIALS\">المواد النادرة</link>لن يقوم المستنسخون بتصنيع العناصر إال إذا كانت الوصفات موجودة في قائمة االنتظار.\n"
"\n"
"يمكن استرجاع المواد النادرة من بعثات الفضاء.\n"
"\n"
" إلى سلع صناعية متقدمة."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.FULLERENE_RECIPE_DESCRIPTION"
msgid ""
"Fullerene is a <link=\"ELEMENTSSOLID\">Solid Material</link> used in the "
"production of <link=\"SUPERCOOLANT\">Super Coolant</link>."
msgstr ""
"الفوليرين هو <link=\"ELEMENTSSOLID\">مادة صلبة</link> تستخدم في إنتاج "
"<link=\"SUPERCOOLANT\">المبرد الفائق</link>."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.HARDPLASTIC_RECIPE_DESCRIPTION"
msgid ""
"Plastium is a highly heat-resistant, plastic-like "
"<link=\"ELEMENTSSOLID\">Solid Material</link> used for space buildings."
msgstr ""
"بالستيوم هو مادة صلبة تشبه البالستيك مقاومة للحرارة بشكل كبير "
"<link=\"ELEMENTSSOLID\">تستخدم في بناء المنشآت الفضائية</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.NAME"
msgid "<link=\"SUPERMATERIALREFINERY\">Molecular Forge</link>"
msgstr "<link=\"SUPERMATERIALREFINERY\">الحدادة الجزيئية</link>"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.SELF_CHARGING_POWERBANK_RECIPE_DESCRIPTION"
msgid ""
"Atomic Power Banks are portable, self-charging units used for isolated "
"<link=\"POWER\">Power</link> grids."
msgstr ""
"البنوك الذرية للطاقة هي وحدات محمولة تشحن نفسها وتستخدم لشبكات "
"<link=\"POWER\">الطاقة</link> المعزولة."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.SUPERCOOLANT_RECIPE_DESCRIPTION"
msgid ""
"Super Coolant is an industrial-grade <link=\"FULLERENE\">Fullerene</link> "
"coolant."
msgstr " هو مبرد صناعي من نوع tnalooC repuS<link=\"FULLERENE\">فوليرين</link>."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.SUPERINSULATOR_RECIPE_DESCRIPTION"
msgid ""
"Insulite reduces <link=\"HEAT\">Heat Transfer</link> and is composed of "
"recrystallized <link=\"KATAIRITE\">Abyssalite</link>."
msgstr ""
"إنسوليت يقلل من <link=\"HEAT\">نقل الحرارة</link> ويتكون من "
"<link=\"KATAIRITE\">أبساليت</link> المعاد تبلوره."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.TEMPCONDUCTORSOLID_RECIPE_DESCRIPTION"
msgid ""
"Thermium is an industrial metal alloy formulated to maximize "
"<link=\"HEAT\">Heat Transfer</link> and thermal dispersion."
msgstr ""
"ثيرميوم هو سبيكة معدنية صناعية مصممة لتعظيم <link=\"HEAT\">نقل "
"الحرارة</link> والتشتت الحراري."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.VISCOGEL_RECIPE_DESCRIPTION"
msgid ""
"Visco-Gel Fluid is a <link=\"ELEMENTSLIQUID\">Liquid</link> polymer with "
"high surface tension."
msgstr ""
"سوائل فيسكو-جيل هو <link=\"ELEMENTSLIQUID\">سائل</link> بوليمري ذو توتر سطحي"
" عال."

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.YELLOWCAKE_RECIPE_DESCRIPTION"
msgid ""
"Yellowcake is a <link=\"ELEMENTSSOLID\">Solid Material</link> used in "
"uranium enrichment."
msgstr ""
"الكيك األصفر هو <link=\"ELEMENTSSOLID\">مادة صلبة</link> تستخدم في تخصيب "
"اليورانيوم."

msgctxt "STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.DESC"
msgid "The cute little face comes pre-installed."
msgstr "الوجه الصغير اللطيف يأتي مثبتا مسبقا."

msgctxt "STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.EFFECT"
msgid ""
"Deploys an automated <link=\"SWEEPBOT\">Sweepy Bot</link> to sweep up <link=\"ELEMENTSSOLID\">Solid</link> debris and <link=\"ELEMENTSLIQUID\">Liquid</link> spills.\n"
"\n"
"Dock stores <link=\"ELEMENTSLIQUID\">Liquids</link> and <link=\"ELEMENTSSOLID\">Solids</link> gathered by the Sweepy.\n"
"\n"
"Uses <link=\"POWER\">Power</link> to recharge the Sweepy.\n"
"\n"
"Duplicants will empty Dock storage into available storage bins."
msgstr ""
"ينشر <link=\"SWEEPBOT\">روبوت ypeewS</link> آليا لجمع الحطام <link=\"ELEMENTSSOLID\">الصلب</link> واالنسكابات <link=\"ELEMENTSLIQUID\">السائلة</link>يقوم الرصيف بتخزين \n"
"\n"
".<link=\"ELEMENTSLIQUID\">السوائل</link> و<link=\"ELEMENTSSOLID\">الصلب</link>يستخدم \n"
"\n"
" الذي يجمعه ypeewS.<link=\"POWER\">الطاقة</link>سيقوم المكررون بإفراغ تخزين الرصيف في صناديق التخزين المتاحة.\n"
"\n"
" إلعادة شحن ypeewS."

msgctxt "STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.NAME"
msgid "<link=\"SWEEPBOTSTATION\">Sweepy's Dock</link>"
msgstr "<link=\"SWEEPBOTSTATION\">رصيف سوبي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.NAMEDSTATION"
msgid "{0}'s Dock"
msgstr "رصيف {0}"

msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.DESC"
msgid "Switches can only affect buildings that come after them on a circuit."
msgstr "يمكن للمفاتيح التأثير فقط على المباني التي تأتي بعدها في الدائرة."

msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.EFFECT"
msgid ""
"Turns <link=\"POWER\">Power</link> on or off.\n"
"\n"
"Does not affect circuitry preceding the switch."
msgstr ""
"يقوم بتشغيل أو إيقاف <link=\"POWER\">الطاقة</link>ال يؤثر على الدوائر قبل المفتاح.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.NAME"
msgid "<link=\"SWITCH\">Switch</link>"
msgstr "<link=\"SWITCH\">تبديل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.SIDESCREEN_TITLE"
msgid "Switch"
msgstr "مفتاح"

msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_OFF"
msgid "Turn Off"
msgstr "أغلق"

msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_OFF_TOOLTIP"
msgid "Turn Off {Hotkey}"
msgstr "أطفئ {Hotkey}"

msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_ON"
msgid "Turn On"
msgstr "تشغيل"

msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_ON_TOOLTIP"
msgid "Turn On {Hotkey}"
msgstr "تشغيل {Hotkey}"

msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.DESC"
msgid "You never know who you'll meet on the other line."
msgstr "ال تعرف أبدا من ستقابل على الطرف اآلخر."

msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT"
msgid ""
"Can be used by one Duplicant to chat with themselves or with other Duplicants in different locations.\n"
"\n"
"Chatting increases Duplicant <link=\"MORALE\">Morale</link>."
msgstr ""
"الدردشة تزيد من \n"
"\n"
"يمكن أن يستخدمه دبلكانت واحد للدردشة مع نفسه أو مع دبلكانت آخرين في مواقع مختلفة.<link=\"MORALE\">معنويات</link> الدبلكانت."

msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_BABBLE"
msgid "{attrib}: {amount} (No One)"
msgstr ")ال أحد( {amount} :{attrib}"

msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_BABBLE_TOOLTIP"
msgid ""
"Duplicants will gain {amount} {attrib} if they chat only with themselves."
msgstr "سيكسب النسخ {attrib} {amount} إذا تحدثوا مع أنفسهم فقط."

msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_CHAT"
msgid "{attrib}: {amount} (At least one Duplicant)"
msgstr ")على األقل نسخة واحدة( {amount} :{attrib}"

msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_CHAT_TOOLTIP"
msgid ""
"Duplicants will gain {amount} {attrib} if they chat with at least one other "
"Duplicant."
msgstr "سيحصل النسخ إذا تحدثوا مع نسخة واحدة على األقل على {attrib} {amount}."

msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_LONG_DISTANCE"
msgid "{attrib}: {amount} (At least one Duplicant across space)"
msgstr ")على األقل دوبليكانت واحد عبر الفضاء( {amount} :{attrib}"

msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_LONG_DISTANCE_TOOLTIP"
msgid ""
"Duplicants will gain {amount} {attrib} if they chat with at least one other "
"Duplicant across space."
msgstr ""
"سيكتسب النسخ {attrib} {amount} إذا تحدثوا مع نسخة أخرى على األقل عبر الفضاء."

msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.NAME"
msgid "<link=\"TELEPHONE\">Party Line Phone</link>"
msgstr "<link=\"TELEPHONE\">هاتف الخط المشترك</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.DESC"
msgid "Duplicants are just atoms as far as the pad's concerned."
msgstr "بالنسبة للوسادة، النسخ المكررة ليست سوى ذرات."

msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.EFFECT"
msgid ""
"Instantly transports Duplicants and items to another portal with the same "
"portal code."
msgstr "ينقل على الفور المكررين واألشياء إلى بوابة أخرى بنفس رمز البوابة."

msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.LOGIC_PORT"
msgid "Portal Code Input"
msgstr "إدخال رمز البوابة"

msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.LOGIC_PORT_ACTIVE"
msgid "1"
msgstr "1"

msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.LOGIC_PORT_INACTIVE"
msgid "0"
msgstr "0"

msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.NAME"
msgid "Teleporter Pad"
msgstr "لوحة النقل"

msgctxt "STRINGS.BUILDINGS.PREFABS.TELESCOPE.DESC"
msgid ""
"Telescopes are necessary for learning starmaps and conducting rocket "
"missions."
msgstr "التلسكوبات ضرورية لتعلم خرائط النجوم وإجراء مهمات الصواريخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.TELESCOPE.EFFECT"
msgid ""
"Maps Starmap destinations for space exploration.\n"
"\n"
"Assigned Duplicants must possess the <link=\"RESEARCHING2\">Field Research</link> skill.\n"
"\n"
"Building must be exposed to space to function."
msgstr ""
"يجب أن يمتلك المكررون المعينون مهارة \n"
"\n"
"يرسم خرائط وجهات النجوم الستكشاف الفضاء.<link=\"RESEARCHING2\">البحث الميداني</link>يجب أن يكون المبنى معرضا للفضاء لكي يعمل.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.TELESCOPE.NAME"
msgid "<link=\"TELESCOPE\">Telescope</link>"
msgstr "<link=\"TELESCOPE\">تلسكوب</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.TELESCOPE.REQUIREMENT_TOOLTIP"
msgid "A steady {0} supply is required to sustain working Duplicants."
msgstr "هناك حاجة إلى إمداد مستمر من {0} للحفاظ على عمل الدوبليكانت."

msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPERATURECONTROLLEDSWITCH.DESC"
msgid ""
"Automated switches can be used to manage circuits in areas where Duplicants "
"cannot enter."
msgstr ""
"يمكن استخدام المفاتيح اآللية إلدارة الدوائر في المناطق التي ال يمكن للنسخ "
"المتماثلة دخولها."

msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPERATURECONTROLLEDSWITCH.EFFECT"
msgid ""
"Automatically turns <link=\"POWER\">Power</link> on or off using ambient <link=\"HEAT\">Temperature</link>.\n"
"\n"
"Does not affect circuitry preceding the switch."
msgstr ""
"يقوم بتشغيل أو إيقاف <link=\"POWER\">الطاقة</link> تلقائيا باستخدام <link=\"HEAT\">درجة الحرارة</link>ال يؤثر على الدوائر الكهربائية التي تسبق المفتاح.\n"
"\n"
" المحيطة."

msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPERATURECONTROLLEDSWITCH.NAME"
msgid "<link=\"TEMPERATURECONTROLLEDSWITCH\">Thermo Switch</link>"
msgstr "<link=\"TEMPERATURECONTROLLEDSWITCH\">مفتاح حراري</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.DESC"
msgid "Infinite possibilities, with a complimentary side of meteor showers."
msgstr "إمكانيات ال نهائية، مع جانب مجاني من شهب النيازك."

msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.EFFECT"
msgid "A powerful mechanism capable of tearing through the fabric of reality."
msgstr "آلية قوية قادرة على تمزيق نسيج الواقع."

msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.NAME"
msgid "Temporal Tear Opener"
msgstr "فاتح التمزق الزمني"

msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.SIDESCREEN.TEXT"
msgid "Fire!"
msgstr "نار!"

msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.SIDESCREEN.TOOLTIP"
msgid "The big red button."
msgstr "الزر األحمر الكبير."

msgctxt "STRINGS.BUILDINGS.PREFABS.THERMALBLOCK.DESC"
msgid ""
"The thermal properties of construction materials determine their heat "
"retention."
msgstr "تحدد الخصائص الحرارية لمواد البناء قدرتها على االحتفاظ بالحرارة."

msgctxt "STRINGS.BUILDINGS.PREFABS.THERMALBLOCK.EFFECT"
msgid ""
"Accelerates or buffers <link=\"HEAT\">Heat</link> dispersal based on the construction material used.\n"
"\n"
"Has a small area of effect."
msgstr ""
"يسرع أو يخزن تبديد <link=\"HEAT\">الحرارة</link>لديه نطاق تأثير صغير.\n"
"\n"
" استنادا إلى مادة البناء المستخدمة."

msgctxt "STRINGS.BUILDINGS.PREFABS.THERMALBLOCK.NAME"
msgid "<link=\"THERMALBLOCK\">Tempshift Plate</link>"
msgstr "<link=\"THERMALBLOCK\">لوحة تحول الحرارة</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.TILE.DESC"
msgid "Tile can be used to bridge gaps and get to unreachable areas."
msgstr ""
"يمكن استخدام البالط لردم الفجوات والوصول إلى المناطق التي ال يمكن الوصول "
"إليها."

msgctxt "STRINGS.BUILDINGS.PREFABS.TILE.EFFECT"
msgid ""
"Used to build the walls and floors of rooms.\n"
"\n"
"Increases Duplicant runspeed."
msgstr ""
"يزيد من سرعة المزدوج.\n"
"\n"
"يستخدم لبناء جدران وأرضيات الغرف."

msgctxt "STRINGS.BUILDINGS.PREFABS.TILE.NAME"
msgid "<link=\"TILE\">Tile</link>"
msgstr "<link=\"TILE\">قرميد</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.TILEPOI.EFFECT"
msgid "Used to build the walls and floor of rooms."
msgstr "يستخدم لبناء جدران وأرضيات الغرف."

msgctxt "STRINGS.BUILDINGS.PREFABS.TILEPOI.NAME"
msgid "<link=\"TILEPOI\">Tile</link>"
msgstr "<link=\"TILEPOI\">بالط</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.TOURISTMODULE.DESC"
msgid "An astronaut must accompany sight seeing Duplicants on rocket flights."
msgstr "يجب أن يرافق رائد الفضاء النسخ السياحية في رحالت الصواريخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.TOURISTMODULE.EFFECT"
msgid ""
"Allows one non-Astronaut Duplicant to visit space.\n"
"\n"
"Sight-Seeing Rocket flights decrease <link=\"STRESS\">Stress</link>."
msgstr ""
"رحالت الصاروخ لمشاهدة المعالم تقلل من \n"
"\n"
"يسمح لمضاعف واحد غير رائد فضاء بزيارة الفضاء.<link=\"STRESS\">التوتر</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.TOURISTMODULE.NAME"
msgid "<link=\"TOURISTMODULE\">Sight-Seeing Module</link>"
msgstr "<link=\"TOURISTMODULE\">وحدة مشاهدة المعالم</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBE.DESC"
msgid ""
"Duplicants will only exit a transit tube when a safe landing area is "
"available beneath it."
msgstr "لن يخرج المكررون من أنبوب النقل إال عندما تتوفر منطقة هبوط آمنة تحته."

msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBE.EFFECT"
msgid ""
"Quickly transports Duplicants from a <link=\"TRAVELTUBEENTRANCE\">Transit Tube Access</link> to the tube's end.\n"
"\n"
"Only transports Duplicants."
msgstr ""
"ينقل النسخ بسرعة من <link=\"TRAVELTUBEENTRANCE\">مدخل أنبوب النقل</link>ينقل النسخ فقط.\n"
"\n"
" إلى نهاية األنبوب."

msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBE.NAME"
msgid "<link=\"TRAVELTUBE\">Transit Tube</link>"
msgstr "<link=\"TRAVELTUBE\">أنبوب النقل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEENTRANCE.DESC"
msgid "Duplicants require access points to enter tubes, but not to exit them."
msgstr ""
"يحتاج النسخ إلى نقاط وصول للدخول إلى األنابيب، لكنها غير مطلوبة للخروج منها."

msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEENTRANCE.EFFECT"
msgid ""
"Allows Duplicants to enter the connected <link=\"TRAVELTUBE\">Transit Tube</link> system.\n"
"\n"
"Stops drawing <link=\"POWER\">Power</link> once fully charged."
msgstr ""
"يسمح للنسخ بالدخول إلى نظام <link=\"TRAVELTUBE\">أنابيب النقل</link>يتوقف عن استهالك \n"
"\n"
" المتصلة.<link=\"POWER\">الطاقة</link> بمجرد الشحن الكامل."

msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEENTRANCE.NAME"
msgid "<link=\"TRAVELTUBEENTRANCE\">Transit Tube Access</link>"
msgstr "<link=\"TRAVELTUBEENTRANCE\">الوصول إلى أنبوب النقل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEWALLBRIDGE.DESC"
msgid ""
"Tube crossings can run transit tubes through walls without leaking gas or "
"liquid."
msgstr ""
"يمكن لعبور األنابيب أن تمرر أنابيب النقل عبر الجدران دون تسرب الغاز أو "
"السوائل."

msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEWALLBRIDGE.EFFECT"
msgid ""
"Allows <link=\"TRAVELTUBE\">Transit Tubes</link> to be run through wall and floor tile.\n"
"\n"
"Functions as regular tile."
msgstr ""
"يسمح بأن تمر <link=\"TRAVELTUBE\">أنابيب النقل</link>يعمل كبالط عادي.\n"
" عبر جدار وبالط األرضية."

msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEWALLBRIDGE.NAME"
msgid "<link=\"TRAVELTUBEWALLBRIDGE\">Transit Tube Crossing</link>"
msgstr "<link=\"TRAVELTUBEWALLBRIDGE\">عبور أنبوب النقل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.UNCONSTRUCTEDROCKETMODULE.DESC"
msgid "Something useful could be put here someday"
msgstr "يمكن وضع شيء مفيد هنا يوما ما"

msgctxt "STRINGS.BUILDINGS.PREFABS.UNCONSTRUCTEDROCKETMODULE.EFFECT"
msgid "Can be changed into a different rocket module"
msgstr "يمكن تغييره إلى وحدة صاروخية مختلفة"

msgctxt "STRINGS.BUILDINGS.PREFABS.UNCONSTRUCTEDROCKETMODULE.NAME"
msgid "Empty Rocket Module"
msgstr "وحدة صاروخ فارغة"

msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERCRITTERCONDO.DESC"
msgid "Even wild critters are happier after they've had a little R&R."
msgstr "حتى الحيوانات البرية تكون أسعد بعد أن تحصل على بعض الراحة واالسترخاء."

msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERCRITTERCONDO.EFFECT"
msgid ""
"A fancy respite area for adult <link=\"CRABSPECIES\">Pokeshells</link> and "
"<link=\"PACUSPECIES\">Pacu</link>."
msgstr ""
"منطقة استراحة فاخرة للبالغين من <link=\"CRABSPECIES\">بوكسشيلز</link> "
"و<link=\"PACUSPECIES\">باتشو</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERCRITTERCONDO.NAME"
msgid "<link=\"UNDERWATERCRITTERCONDO\">Water Fort</link>"
msgstr "<link=\"UNDERWATERCRITTERCONDO\">حصن الماء</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.DESC"
msgid ""
"Enriched uranium is a specialized substance that can be used to fuel "
"powerful research reactors."
msgstr ""
"اليورانيوم المخصب هو مادة متخصصة يمكن استخدامها لتغذية المفاعالت البحثية "
"القوية."

msgctxt "STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.EFFECT"
msgid ""
"Extracts <link=\"ENRICHEDURANIUM\">Enriched Uranium</link> from <link=\"URANIUMORE\">Uranium Ore</link>.\n"
"\n"
"Outputs <link=\"DEPLETEDURANIUM\">Depleted Uranium</link> in molten form."
msgstr ""
"يستخرج <link=\"ENRICHEDURANIUM\">اليورانيوم المخصب</link> من <link=\"URANIUMORE\">خامة اليورانيوم</link>ينتج \n"
"\n"
".<link=\"DEPLETEDURANIUM\">اليورانيوم المستنفد</link> في شكل مصهور."

msgctxt "STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.NAME"
msgid "<link=\"URANIUMCENTRIFUGE\">Uranium Centrifuge</link>"
msgstr "<link=\"URANIUMCENTRIFUGE\">فاصل اليورانيوم</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.RECIPE_DESCRIPTION"
msgid "Convert Uranium ore to Molten Uranium and Enriched Uranium"
msgstr "تحويل خام اليورانيوم إلى يورانيوم منصهر ويورانيوم مخصب"

msgctxt "STRINGS.BUILDINGS.PREFABS.VENDINGMACHINE.DESC"
msgid "A pristine <link=\"FIELDRATION\">Nutrient Bar</link> dispenser."
msgstr "جهاز صرف <link=\"FIELDRATION\">لوح غذائي</link> نقي."

msgctxt "STRINGS.BUILDINGS.PREFABS.VENDINGMACHINE.NAME"
msgid "Vending Machine"
msgstr "آلة بيع"

msgctxt "STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.DESC"
msgid "Duplicants love the feeling of high-powered wind through their hair."
msgstr "يحب التوائم اإلحساس بالرياح القوية تتخلل شعرهم."

msgctxt "STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.DISPLACEMENTEFFECT"
msgid "Gas Displacement: {amount}"
msgstr "إزاحة الغاز: {amount}"

msgctxt ""
"STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.DISPLACEMENTEFFECT_TOOLTIP"
msgid "This building will displace {amount} Gas while in use."
msgstr "هذا المبنى سيحل محل {amount} غاز أثناء استخدامه."

msgctxt "STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.EFFECT"
msgid ""
"Must be connected to a <link=\"POWER\">Power Source</link>. To properly function, the area under this building must be left vacant.\n"
"\n"
"Increases Duplicants <link=\"MORALE\">Morale</link>."
msgstr ""
"يجب أن يكون متصال بـ <link=\"POWER\">مصدر طاقة</link>يزيد من \n"
"\n"
". لكي يعمل بشكل صحيح، يجب ترك المنطقة تحت هذا المبنى خالية.<link=\"MORALE\">معنويات</link> المكررين."

msgctxt "STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.NAME"
msgid "<link=\"VERTICALWINDTUNNEL\">Vertical Wind Tunnel</link>"
msgstr "<link=\"VERTICALWINDTUNNEL\">نفق الرياح العمودي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.WALLTOILET.DESC"
msgid ""
"Wall Toilets transmit fewer germs to Duplicants and require no emptying."
msgstr ""
"تنقل المراحيض الجدارية عددا أقل من الجراثيم إلى النسخ وتحتاج إلى عدم "
"التفريغ."

msgctxt "STRINGS.BUILDINGS.PREFABS.WALLTOILET.EFFECT"
msgid ""
"Gives Duplicants a place to relieve themselves. Empties directly on the other side of the wall.\n"
"\n"
"Spreads very few <link=\"DISEASE\">Germs</link>."
msgstr ""
"ينشر عددا قليال جدا من \n"
"يوفر للنسخ مكانا لقضاء حاجتهم. يفرغ مباشرة على الجانب اآلخر من الجدار.<link=\"DISEASE\">الجراثيم</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.WALLTOILET.NAME"
msgid "<link=\"WALLTOILET\">Wall Toilet</link>"
msgstr "<link=\"WALLTOILET\">مرحاض حائطي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITRECEIVER.DESC"
msgid "The tubes at the back disappear into nowhere."
msgstr "األنابيب في الخلف تختفي في العدم."

msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITRECEIVER.EFFECT"
msgid ""
"A machine capable of teleporting <link=\"ELEMENTSLIQUID\">Liquid</link>, <link=\"ELEMENTSSOLID\">Solid</link>, and <link=\"ELEMENTSGAS\">Gas</link> resources to another asteroid.\n"
"\n"
"It can be activated by a Duplicant with the <link=\"RESEARCHING2\">Field Research</link> skill.\n"
"\n"
"This is the receiving side."
msgstr ""
"آلة قادرة على نقل <link=\"ELEMENTSLIQUID\">السائل</link> ،<link=\"ELEMENTSSOLID\">الصلب</link>، و <link=\"ELEMENTSGAS\">الغاز</link>يمكن تفعيلها بواسطة نسخة طبق األصل تمتلك مهارة \n"
"\n"
" إلى كويكب آخر.<link=\"RESEARCHING2\">البحث الميداني</link>هذه هي الجهة المستقبلة.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITRECEIVER.NAME"
msgid "<link=\"WARPCONDUITRECEIVER\">Supply Teleporter Output</link>"
msgstr "<link=\"WARPCONDUITRECEIVER\">إخراج جهاز النقل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITSENDER.DESC"
msgid "The tubes at the back disappear into nowhere."
msgstr "األنابيب في الخلف تختفي في العدم."

msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITSENDER.EFFECT"
msgid ""
"A machine capable of teleporting <link=\"ELEMENTSLIQUID\">Liquid</link>, <link=\"ELEMENTSSOLID\">Solid</link>, and <link=\"ELEMENTSGAS\">Gas</link> resources to another asteroid.\n"
"\n"
"It can be activated by a Duplicant with the <link=\"RESEARCHING2\">Field Research</link> skill.\n"
"\n"
"This is the transmitting side."
msgstr ""
"آلة قادرة على نقل <link=\"ELEMENTSLIQUID\">السائل</link> ،<link=\"ELEMENTSSOLID\">الصلب</link>، و<link=\"ELEMENTSGAS\">الغاز</link>يمكن تفعيلها بواسطة نسخ شخصية تمتلك مهارة \n"
"\n"
" من الموارد إلى كويكب آخر.<link=\"RESEARCHING2\">البحث الميداني</link>هذا هو الجانب المرسل.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITSENDER.NAME"
msgid "<link=\"WARPCONDUITSENDER\">Supply Teleporter Input</link>"
msgstr "<link=\"WARPCONDUITSENDER\">إدخال هاتف النقل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.WARPPORTAL.DESC"
msgid ""
"The functional remnants of an intricate teleportation system.\n"
"\n"
"This is the outgoing side, and has one pre-programmed destination."
msgstr ""
"هذا هو الجانب الصادر، وله وجهة واحدة مبرمجة مسبقا.\n"
"\n"
"البقايا الوظيفية لنظام نقل معقد."

msgctxt "STRINGS.BUILDINGS.PREFABS.WARPPORTAL.NAME"
msgid "Teleporter Transmitter"
msgstr "مرسل الناقل عن بعد"

msgctxt "STRINGS.BUILDINGS.PREFABS.WARPRECEIVER.DESC"
msgid ""
"The functional remnants of an intricate teleportation system.\n"
"\n"
"This is the incoming side."
msgstr ""
"هذا هو الجانب الوارد.\n"
"\n"
"البقايا الوظيفية لنظام نقل معقد."

msgctxt "STRINGS.BUILDINGS.PREFABS.WARPRECEIVER.NAME"
msgid "Teleporter Receiver"
msgstr "جهاز استقبال الناقل عن بعد"

msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.DESC"
msgid "Sinks are plumbed and do not need to be manually emptied or refilled."
msgstr "األحواض موصلة بالسباكة وال تحتاج إلى التفريغ أو الملء اليدوي."

msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.EFFECT"
msgid ""
"Removes <link=\"DISEASE\">Germs</link> from Duplicants.\n"
"\n"
"Germ-covered Duplicants use Sinks when passing by in the selected direction."
msgstr ""
