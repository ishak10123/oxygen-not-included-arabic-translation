msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_TRIANGLE_LEMON_WHITE.NAME"
msgid "<link=\"EXTERIORWALL\">Brightslug Corner</link>"
msgstr "<link=\"EXTERIORWALL\">زاوية برايتسالگ</link>"

msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_TRIANGLE_SATSUMA_WHITE.DESC"
