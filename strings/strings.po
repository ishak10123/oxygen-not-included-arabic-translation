msgstr "بذرة"

msgctxt "STRINGS.MISC.TAGS.SLIPPERY"
msgid "<link=\"SLIPPERY\">Slippery</link>"
msgstr "<link=\"SLIPPERY\">زلق</link>"

msgctxt "STRINGS.MISC.TAGS.SLIPPERY_DESC"
msgid ""
"Some <link=\"ELEMENTSLIQUID\">liquids</link> and "
"<link=\"ELEMENTSSOLID\">solids</link> have a remarkably low coefficient of "
"friction. These present a safety hazard if left on the ground, as Duplicants"
" may slip and fall when traveling across them."
msgstr ""
"بعض <link=\"ELEMENTSLIQUID\">السوائل</link> و "
"<link=\"ELEMENTSSOLID\">الصلبات</link> لها معامل احتكاك منخفض بشكل ملحوظ. "
"هذا يشكل خطرا على السالمة إذا تركت على األرض، حيث قد ينزلق الدوبليكانت ويسقط"
" عند عبورهم عليها."

msgctxt "STRINGS.MISC.TAGS.SNOW"
