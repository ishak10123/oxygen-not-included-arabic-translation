msgid "<link=\"OILSPOUT\">Oil Spout</link>"
msgstr "<link=\"OILSPOUT\">فوهة الزيت</link>"

msgctxt "STRINGS.CREATURES.SPECIES.OXYFERN.DESC"
msgid ""
"Oxyferns absorb <link=\"CARBONDIOXIDE\">Carbon Dioxide Gas</link> and exude "
"breathable <link=\"OXYGEN\">Oxygen</link>."
msgstr ""
"تمتص نباتات األوكسي فرنس غاز <link=\"CARBONDIOXIDE\">ثاني أكسيد "
"الكربون</link> وتفرز <link=\"OXYGEN\">األكسجين</link> القابل للتنفس."

msgctxt "STRINGS.CREATURES.SPECIES.OXYFERN.DOMESTICATEDDESC"
msgid ""
"This plant converts <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> into "
"<link=\"OXYGEN\">Oxygen</link>."
msgstr ""
"تحول هذه النبتة <link=\"CARBONDIOXIDE\">ثاني أكسيد الكربون</link> إلى "
"<link=\"OXYGEN\">األكسجين</link>."

msgctxt "STRINGS.CREATURES.SPECIES.OXYFERN.NAME"
msgid "<link=\"OXYFERN\">Oxyfern</link>"
msgstr "<link=\"OXYFERN\">أوكسيفيرن</link>"

msgctxt "STRINGS.CREATURES.SPECIES.PACU.BABY.DESC"
msgid ""
"A wriggly little Pacu Fry.\n"
"\n"
"In time, it will mature into an adult <link=\"PACU\">Pacu</link>."
msgstr ""
"مع الوقت، ستنمو لتصبح \n"
"\n"
"يرقة باكو الصغيرة المتلوية.<link=\"PACU\">باكو</link> بالغ."

msgctxt "STRINGS.CREATURES.SPECIES.PACU.BABY.NAME"
msgid "<link=\"PACU\">Pacu Fry</link>"
msgstr "<link=\"PACU\">صغار الباكو</link>"

msgctxt "STRINGS.CREATURES.SPECIES.PACU.DESC"
msgid ""
"Pacus are aquatic creatures that can live in any liquid, such as <link=\"WATER\">Water</link> or <link=\"DIRTYWATER\">Polluted Water</link>.\n"
"\n"
"Every organism in the known universe finds the Pacu extremely delicious."
msgstr ""
"الباكوس هي مخلوقات مائية يمكنها العيش في أي سائل، مثل <link=\"WATER\">الماء</link> أو <link=\"DIRTYWATER\">المياه الملوثة</link>كل الكائنات في الكون المعروف تجد الباكوس لذيذة للغاية.\n"
"\n"
"."

msgctxt "STRINGS.CREATURES.SPECIES.PACU.EGG_NAME"
msgid "<link=\"PACU\">Pacu Egg</link>"
msgstr "<link=\"PACU\">بيضة باكو</link>"

msgctxt "STRINGS.CREATURES.SPECIES.PACU.NAME"
msgid "<link=\"PACU\">Pacu</link>"
msgstr "<link=\"PACU\">باكو</link>"

msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.BABY.DESC"
msgid ""
"A wriggly little Gulp Fry.\n"
"\n"
"In time, it will mature into an adult <link=\"PACUCLEANER\">Gulp Fish</link>."
msgstr ""
"مع مرور الوقت، ستنمو لتصبح \n"
"\n"
"سمكة جلب صغيرة متلوية.<link=\"PACUCLEANER\">سمكة الجلب البالغة</link>."

msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.BABY.NAME"
msgid "<link=\"PACUCLEANER\">Gulp Fry</link>"
msgstr "<link=\"PACUCLEANER\">جولب فراي</link>"

msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.DESC"
msgid ""
"Gulp Fishes are aquatic critters who inhabit cold liquid pools.\n"
"\n"
"Their gills filter <link=\"DIRTYWATER\">Polluted Water</link> into <link=\"WATER\">Water</link>."
msgstr ""
"تقوم خياشيمها بترشيح \n"
"\n"
"أسماك الغالب هي كائنات مائية تعيش في برك السوائل الباردة.<link=\"DIRTYWATER\">المياه الملوثة</link> إلى <link=\"WATER\">مياه</link>."

msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.EGG_NAME"
msgid "<link=\"PACUCLEANER\">Gulp Fish Egg</link>"
msgstr "<link=\"PACUCLEANER\">بيض سمك غالب</link>"

msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.NAME"
msgid "<link=\"PACUCLEANER\">Gulp Fish</link>"
msgstr "<link=\"PACUCLEANER\">اغمض السمك</link>"

msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.BABY.DESC"
msgid ""
"A wriggly little Tropical Fry.\n"
"\n"
"In time it will mature into an adult Pacu morph, the <link=\"PACUTROPICAL\">Tropical Pacu</link>."
msgstr ""
"مع مرور الوقت سيتحول إلى شكل باسو بالغ، \n"
"\n"
"صغير استوائي يلتف.<link=\"PACUTROPICAL\">باسو استوائي</link>."

