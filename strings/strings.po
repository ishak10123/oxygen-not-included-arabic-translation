msgid "<link=\"POWER\">Power</link>"
msgstr "<link=\"POWER\">ﺓﻮﻘﻟﺍ</link>"

msgctxt "STRINGS.CODEX.POWER_STATION_TOOLS.BODY.CONTAINER1"
msgid ""
"Microchips are engineered tools containing countless lines of proprietary "
"code. New applications are still being discovered."
msgstr ""
".ﺎﻬﻟ ﺓﺪﻳﺪﺟ ﺕﺎﻘﻴﺒﻄﺗ ﻑﺎﺸﺘﻛﺍ ﻢﺘﻳ ﻝﺍﺰﻳ ﻻ .ﺔﻛﻮﻠﻤﻤﻟﺍ ﺓﺮﻔﻴﺸﻟﺍ ﺮﻄﺳﺃ ﻦﻣ ﻰﺼﺤﻳ ﻻ ﺩﺪﻋ "
"ﻰﻠﻋ ﻱﻮﺘﺤﺗ ﺔﻤﻤﺼﻣ ﺕﺍﻭﺩﺃ ﻲﻫ ﺔﻘﻴﻗﺪﻟﺍ ﻖﺋﺎﻗﺮﻟﺍ"

msgctxt "STRINGS.CODEX.POWER_STATION_TOOLS.SUBTITLE"
msgid "Specialized Equipment"
