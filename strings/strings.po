msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGAS.DESC"
msgid "Rockets must be landed to load or unload resources."
msgstr ".ﺩﺭﺍﻮﻤﻟﺍ ﻎﻳﺮﻔﺗ ﻭﺃ ﻞﻴﻤﺤﺘﻟ ﺦﻳﺭﺍﻮﺼﻟﺍ ﻁﻮﺒﻫ ﺐﺠﻳ"

msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGAS.EFFECT"
msgid ""
"Loads <link=\"ELEMENTSGAS\">Gases</link> to the storage of a linked rocket.\n"
"\n"
"Automatically links when built to the side of a <link=\"LAUNCHPAD\">Rocket Platform</link> or another <link=\"MODULARLAUNCHPADPORTSOLID\">Rocket Port</link>.\n"
"\n"
"Uses the gas filters set on the rocket's cargo bays."
msgstr ""
" ﻞﻤﺤﻳ<link=\"ELEMENTSGAS\">ﺕﺍﺯﺎﻐﻟﺍ</link>.ﻂﺒﺗﺮﻤﻟﺍ ﺥﻭﺭﺎﺼﻟﺍ ﻥﺰﺨﻣ ﻰﻟﺇ \n"
"\n"
" ﺐﻧﺎﺠﺑ ﺀﺎﻨﺒﻟﺍ ﺪﻨﻋ ﺎﻴﺋﺎﻘﻠﺗ ﻂﺒﺗﺮﻳ<link=\"LAUNCHPAD\">ﺥﻭﺭﺎﺼﻟﺍ ﺔﺼﻨﻣ</link> ﻭﺃ <link=\"MODULARLAUNCHPADPORTSOLID\">ﺮﺧﺁ ﺥﻭﺭﺎﺻ ﺬﻔﻨﻣ</link>.\n"
"\n"
".ﺥﻭﺭﺎﺼﻟﺍ ﻦﺤﺷ ﺕﺎﻧﺍﺰﺧ ﻲﻓ ﺔﻃﻮﺒﻀﻤﻟﺍ ﺯﺎﻐﻟﺍ ﺮﺗﻼﻓ ﻡﺪﺨﺘﺴﻳ"

msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGAS.NAME"
msgid "<link=\"MODULARLAUNCHPADPORTGAS\">Gas Rocket Port Loader</link>"
msgstr "<link=\"MODULARLAUNCHPADPORTGAS\">ﺯﺎﻐﻟﺍ ﺥﻭﺭﺎﺻ ﻞﻤﺤﻣ</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGASUNLOADER.DESC"
msgid "Rockets must be landed to load or unload resources."
msgstr ".ﺩﺭﺍﻮﻤﻟﺍ ﻎﻳﺮﻔﺗ ﻭﺃ ﻞﻴﻤﺤﺘﻟ ﺦﻳﺭﺍﻮﺼﻟﺍ ﻁﻮﺒﻫ ﺐﺠﻳ"

msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGASUNLOADER.EFFECT"
msgid ""
"Unloads <link=\"ELEMENTSGAS\">Gases</link> from the storage of a linked rocket.\n"
"\n"
"Automatically links when built to the side of a <link=\"LAUNCHPAD\">Rocket Platform</link> or another <link=\"MODULARLAUNCHPADPORTSOLID\">Rocket Port</link>.\n"
"\n"
"Uses the gas filters set on this unloader."
msgstr ""
" ﻍﺮﻔﻳ<link=\"ELEMENTSGAS\">ﺕﺍﺯﺎﻐﻟﺍ</link>.ﻂﺒﺗﺮﻣ ﺥﻭﺭﺎﺻ ﻦﻳﺰﺨﺗ ﻦﻣ \n"
"\n"
" ﺐﻧﺎﺠﺑ ﻪﺋﺎﻨﺑ ﺪﻨﻋ ﺎﻴﺋﺎﻘﻠﺗ ﻂﺒﺗﺮﻳ<link=\"LAUNCHPAD\">ﺦﻳﺭﺍﻮﺼﻟﺍ ﻕﻼﻃﺇ ﺔﺼﻨﻣ</link> ﻭﺃ <link=\"MODULARLAUNCHPADPORTSOLID\">ﺮﺧﺁ ﺥﻭﺭﺎﺻ ﺬﻔﻨﻣ</link>.\n"
"\n"
".ﻚﻜﻔﻤﻟﺍ ﺍﺬﻫ ﻰﻠﻋ ﺔﻃﻮﺒﻀﻤﻟﺍ ﺯﺎﻐﻟﺍ ﺮﺗﻼﻓ ﻡﺪﺨﺘﺴﻳ"

msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGASUNLOADER.NAME"
msgid "<link=\"MODULARLAUNCHPADPORTGASUNLOADER\">Gas Rocket Port Unloader</link>"
msgstr ""
"<link=\"MODULARLAUNCHPADPORTGASUNLOADER\">ﺀﺎﻨﻴﻤﻟﺍ ﻲﻓ ﺯﺎﻐﻟﺍ ﺥﻭﺭﺎﺻ ﻎﻳﺮﻔﺗ "
