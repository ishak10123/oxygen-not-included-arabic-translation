msgctxt "STRINGS.MISC.TAGS.PRECIOUSMETAL"
msgid "<link=\"PRECIOUSMETAL\">Precious Metal</link>"
msgstr "<link=\"PRECIOUSMETAL\">المعدن الثمين</link>"

msgctxt "STRINGS.MISC.TAGS.PRECIOUSROCK"
msgid "<link=\"PRECIOUSROCK\">Precious Rock</link>"
msgstr "<link=\"PRECIOUSROCK\">الصخرة الثمينة</link>"

msgctxt "STRINGS.MISC.TAGS.PRECIOUSROCK_DESC"
msgid ""
"Precious rocks are raw minerals. Their extreme hardness produces durable <link=\"DECOR\">Decor</link>.\n"
"\n"
"Some precious rocks are inherently attractive even in their natural, unfinished form."
msgstr ""
"األحجار الكريمة هي معادن خام. صالبتها الشديدة تنتج <link=\"DECOR\">ديكور</link>بعض األحجار الكريمة جذابة بطبيعتها حتى في شكلها الطبيعي وغير المصقول.\n"
"\n"
" متين."

