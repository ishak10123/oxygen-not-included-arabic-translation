msgid "Tutorial: Atmo Suits"
msgstr "ﺀﺍﻮﺟﻷﺍ ﺕﻻﺪﺑ :ﻞﻴﻟﺩ"

msgctxt "STRINGS.MISC.NOTIFICATIONS.SUITS.TOOLTIP"
msgid "Notes on using atmo suits"
