msgid "<link=\"STATERPILLAR\">Plug Sluglet</link>"
msgstr "<link=\"STATERPILLAR\">سدادة القابس</link>"

msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.DESC"
msgid ""
"Plug Slugs are dynamic creatures that generate electrical <link=\"POWER\">Power</link> during the night.\n"
"\n"
"Their power can be harnessed by leaving an exposed wire near areas where they like to sleep."
msgstr ""
"سلج القوابس هي مخلوقات ديناميكية تولد <link=\"POWER\">الطاقة</link> "
"الكهربائية خالل الليل. يمكن استغالل طاقتهم عن طريق ترك سلك مكشوف بالقرب من "
"األماكن التي يفضلون النوم فيها."

msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.EGG_NAME"
msgid "<link=\"STATERPILLAR\">Plug Slug Egg</link>"
msgstr "<link=\"STATERPILLAR\">سدادة البيضة</link>"

