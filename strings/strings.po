msgid ""
"Insulite reduces <link=\"HEAT\">Heat Transfer</link> and is composed of "
"recrystallized <link=\"KATAIRITE\">Abyssalite</link>."
msgstr ""
" ﻦﻣ ﻞﻠﻘﻳ ﺖﻴﻟﻮﺴﻧﺇ<link=\"HEAT\">ﺓﺭﺍﺮﺤﻟﺍ ﻞﻘﻧ</link> ﻦﻣ ﻥﻮﻜﺘﻳﻭ "
"<link=\"KATAIRITE\">ﺖﻴﻟﺎﺴﺑﺃ</link>.ﻩﺭﻮﻠﺒﺗ ﺩﺎﻌﻤﻟﺍ "

msgctxt "STRINGS.ELEMENTS.SUPERINSULATOR.NAME"
msgid "<link=\"SUPERINSULATOR\">Insulite</link>"
msgstr "<link=\"SUPERINSULATOR\">ﺖﻳﻻﻮﺴﻧﺇ</link>"

msgctxt "STRINGS.ELEMENTS.SYNGAS.DESC"
msgid ""
"Synthesis Gas is an artificial, unbreathable <link=\"ELEMENTSGAS\">Gas</link>.\n"
"\n"
"It can be converted into an efficient fuel."
msgstr ""
" ﺲﻔﻨﺘﻠﻟ ﺢﻟﺎﺻ ﺮﻴﻏ ﻲﻋﺎﻨﺻ ﺯﺎﻏ ﻮﻫ ﻲﻋﺎﻨﻄﺻﻻﺍ ﺯﺎﻐﻟﺍ<link=\"ELEMENTSGAS\">Gas</link>.\n"
"\n"
".ﻝﺎﻌﻓ ﺩﻮﻗﻭ ﻰﻟﺇ ﻪﻠﻳﻮﺤﺗ ﻦﻜﻤﻳ"

msgctxt "STRINGS.ELEMENTS.SYNGAS.NAME"
msgid "<link=\"SYNGAS\">Synthesis Gas</link>"
msgstr "<link=\"SYNGAS\">ﻖﻴﻠﺨﺘﻟﺍ ﺯﺎﻏ</link>"

msgctxt "STRINGS.ELEMENTS.TALLOW.DESC"
msgid ""
"A chunk of raw grease that can be used in <link=\"FOOD\">Food</link> "
"production or industrial processes."
msgstr ""
" ﺝﺎﺘﻧﺇ ﻲﻓ ﺎﻬﻣﺍﺪﺨﺘﺳﺍ ﻦﻜﻤﻳ ﻡﺎﺨﻟﺍ ﻢﺤﺸﻟﺍ ﻦﻣ "
"ﺔﻠﺘﻛ<link=\"FOOD\">ﻡﺎﻌﻄﻟﺍ</link>.ﺔﻴﻋﺎﻨﺼﻟﺍ ﺕﺎﻴﻠﻤﻌﻟﺍ ﻭﺃ "

