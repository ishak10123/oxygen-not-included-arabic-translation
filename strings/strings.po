msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_TRIANGLE_CHILLI_WHITE.NAME"
msgid "<link=\"EXTERIORWALL\">Chili Corner</link>"
msgstr "<link=\"EXTERIORWALL\">زاوية الشيلي</link>"

msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_TRIANGLE_COBALT_WHITE.DESC"
