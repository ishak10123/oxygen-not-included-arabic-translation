msgstr "<link=\"SEAL\">جرو سبايجوت</link>"

msgctxt "STRINGS.CREATURES.SPECIES.SEAL.DESC"
msgid ""
"Spigot Seals are charismatic creatures who produce <link=\"ETHANOL\">Ethanol</link>.\n"
"\n"
"They eat <link=\"SUCROSE\">Sucrose</link>, and drink <link=\"SUGARWATER\">Nectar</link> straight from the <link=\"SPACETREE\">Bonbon Tree</link>."
msgstr ""
"ختم سبtogi هي مخلوقات جذابة تنتج <link=\"ETHANOL\">اإليثانول</link>إنها تأكل \n"
"\n"
".<link=\"SUCROSE\">السكروز</link> وتشرب <link=\"SUGARWATER\">الرحيق</link> مباشرة من <link=\"SPACETREE\">شجرة بونبون</link>."

