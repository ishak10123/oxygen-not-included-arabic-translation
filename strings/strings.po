msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_TRIANGLE_COBALT_WHITE.NAME"
msgid "<link=\"EXTERIORWALL\">Cobalt Corner</link>"
msgstr "<link=\"EXTERIORWALL\">زاوية الكوبالت</link>"

msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_TRIANGLE_FLAMINGO_WHITE.DESC"
