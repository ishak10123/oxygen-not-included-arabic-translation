msgid "<link=\"CHAMELEON\">Dartlet</link>"
msgstr "<link=\"CHAMELEON\">دارلت</link>"

msgctxt "STRINGS.CREATURES.SPECIES.CHAMELEON.DESC"
msgid ""
"Dartles are non-hostile critters who eat <link=\"DEWDRIP\">Dewdrips</link> and excrete <link=\"BLEACHSTONE\">Bleach Stone</link> and <link=\"CHLORINEGAS\">Chlorine Gas</link> .\n"
"\n"
"They are preyed on by <link=\"RAPTOR\">Rhexes</link>."
msgstr ""
"دارتلز هي مخلوقات غير عدائية تأكل <link=\"DEWDRIP\">درودريبس</link> وتطرح <link=\"BLEACHSTONE\">حجر التبييض</link> و <link=\"CHLORINEGAS\">غاز الكلور</link>ويفترسها \n"
"\n"
".<link=\"RAPTOR\">ريكسيس</link>."

msgctxt "STRINGS.CREATURES.SPECIES.CHAMELEON.EGG_NAME"
msgid "<link=\"CHAMELEON\">Dartle Egg</link>"
msgstr "<link=\"CHAMELEON\">بيضة دارثل</link>"

msgctxt "STRINGS.CREATURES.SPECIES.CHAMELEON.NAME"
msgid "<link=\"CHAMELEON\">Dartle</link>"
msgstr "<link=\"CHAMELEON\">دارتل</link>"

msgctxt "STRINGS.CREATURES.SPECIES.CHLORINEGEYSER.DESC"
msgid ""
"A highly pressurized geyser that periodically erupts with "
"<link=\"CHLORINEGAS\">Chlorine Gas</link>."
msgstr ""
"نافورة مرتفعة الضغط تنفجر بشكل دوري مع <link=\"CHLORINEGAS\">غاز "
"الكلور</link>."

