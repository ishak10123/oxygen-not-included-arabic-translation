msgid "Just Ate"
msgstr "لقد أكلت للتو"

msgctxt "STRINGS.CREATURES.MODIFIERS.RAPTORWELLFED.TOOLTIP"
msgid "This critter's recent meal is boosting their feather growth"
msgstr "وجبة هذا المخلوق األخيرة تعزز نمو ريشه"

msgctxt "STRINGS.CREATURES.MODIFIERS.SCALE_GROWTH_RATE.NAME"
