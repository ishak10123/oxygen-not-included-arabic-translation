msgstr ""
"تم انسداد <style=\"KKeyword\">األنبوب</style> ويمنع "
"<style=\"KKeyword\">السوائل</style> أو <style=\"KKeyword\">الغازات</style> "
"من التدفق إلى هذا الفتحة الجغرافية"

msgctxt ""
"STRINGS.COLONY_ACHIEVEMENTS.ACTIVATEGEOTHERMALPLANT.STATUSITEMS.VENT.DISCONNECTED_NAME"
