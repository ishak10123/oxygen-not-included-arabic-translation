msgid "Shiny Coprolite"
msgstr "روث متحجر المع"

msgctxt "STRINGS.UI.KEEPSAKES.HIJACK_HEADQUARTERS.DESCRIPTION"
msgid ""
"A vintage follicle styling tool.\n"
"\n"
"The handle bears a small engraving that reads: \"To N.T., from N.T.\""
msgstr ""
"المقبض يحمل نقشا صغيرا مكتوب عليه: \"إلى T.N.، من T.N.\"\n"
"\n"
"أداة تصفيف شعور عتيقة."

