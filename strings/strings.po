msgid "<link=\"CYLINDRICA\">Bliss Burst</link>"
msgstr "<link=\"CYLINDRICA\">انفجار النعيم</link>"

msgctxt "STRINGS.CREATURES.SPECIES.CYLINDRICA.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "عقوبة الذبول"

msgctxt "STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DESC"
msgid ""
"Dew Drippers produce <link=\"DEWDRIP\">Dewdrips</link> that can be crushed "
"into <link=\"MILK\">Brackene</link>."
msgstr ""
"ينتج مبردو الندى <link=\"DEWDRIP\">قطرات الندى</link> التي يمكن سحقها إلى "
"<link=\"MILK\">براكني</link>."

msgctxt "STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DOMESTICATEDDESC"
