msgstr "<link=\"BUILDABLERAW\">المعدن الخام</link> إلى <link=\"SAND\">الرمل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCOMMANDCONSOLE.DESC"
msgid "Looks kinda fun."
msgstr "يبدو ممتعا نوعا ما."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCOMMANDCONSOLE.EFFECT"
msgid ""
"Allows a Duplicant to pilot a rocket.\n"
"\n"
"Cargo rockets must possess a Rocket Cockpit in order to function."
msgstr ""
"يجب أن تمتلك صواريخ الشحن قمرة قيادة صاروخية لتعمل.\n"
"يتيح للمضاعف قيادة صاروخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCOMMANDCONSOLE.NAME"
msgid "<link=\"ROCKETCOMMANDCONSOLE\">Rocket Cockpit</link>"
msgstr "<link=\"ROCKETCOMMANDCONSOLE\">قمرة الصواريخ</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.DESC"
msgid ""
"Someone needs to be around to jiggle the controls when the screensaver comes"
" on."
msgstr "يحتاج شخص ما ألن يكون قريبا لتحريك التحكمات عندما يظهر حامي الشاشة."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.EFFECT"
msgid ""
"Allows Duplicants to use pilot-operated rockets and control access to interior buildings.\n"
"\n"
"Assigned Duplicants must have the <link=\"ROCKETPILOTING1\">Rocket Piloting</link> skill."
msgstr ""
"يجب أن يمتلك النسخ المكلفون بهذه المهمة مهارة \n"
"\n"
"يسمح للنسخ باستخدام الصواريخ التي يتم تشغيلها بواسطة الطيارين والتحكم في الوصول إلى المباني الداخلية.<link=\"ROCKETPILOTING1\">قيادة الصواريخ</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.LOGIC_PORT"
msgid "Restrict Building Usage"
msgstr "تقييد استخدام المبنى"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.LOGIC_PORT_ACTIVE"
msgid ""
"<b><style=\"logic_on\">Green Signal</style></b>: Restrict access to interior"
" buildings"
msgstr ""
"<b><style=\"logic_on\">إشارة خضراء</style></b>: تقييد الوصول إلى المباني "
"الداخلية"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.LOGIC_PORT_INACTIVE"
msgid ""
"<b><style=\"logic_off\">Red Signal</style></b>: Unrestrict access to "
"interior buildings"
msgstr ""
"<b><style=\"logic_off\">إشارة حمراء</style></b>: إلغاء تقييد الوصول إلى "
"المباني الداخلية"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.NAME"
msgid "<link=\"ROCKETCONTROLSTATION\">Rocket Control Station</link>"
msgstr "<link=\"ROCKETCONTROLSTATION\">محطة التحكم في الصواريخ</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPETILE.DESC"
msgid "Keeps the space out."
msgstr "يمنع دخول الغبار."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPETILE.EFFECT"
msgid "The walls of a rocket."
msgstr "جدران الصاروخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPETILE.NAME"
msgid "<link=\"ROCKETENVELOPETILE\">Rocket</link>"
msgstr "<link=\"ROCKETENVELOPETILE\">صاروخ</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPEWINDOWTILE.DESC"
msgid "I can see my asteroid from here!"
msgstr "يمكنني رؤية كويكبي من هنا!"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPEWINDOWTILE.EFFECT"
msgid "The window of a rocket."
msgstr "نافذة صاروخ"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPEWINDOWTILE.NAME"
msgid "<link=\"ROCKETENVELOPEWINDOWTILE\">Rocket Window</link>"
msgstr "<link=\"ROCKETENVELOPEWINDOWTILE\">نافذة الصاروخ</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUT.DESC"
msgid "It's basically central-vac."
msgstr "إنه في األساس مكنسة مركزية."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUT.EFFECT"
msgid ""
"Allows <link=\"ELEMENTSGAS\">Gases</link> to be pumped into rocket storage via <link=\"GASCONDUIT\">Pipes</link>.\n"
"\n"
"Sends gas to the first Rocket Module with available space.\n"
"\n"
"Must be built within the interior of a Rocket Module."
msgstr ""
"يتيح ضخ <link=\"ELEMENTSGAS\">الغازات</link> إلى تخزين الصاروخ عبر <link=\"GASCONDUIT\">األنابيب</link>يجب بناؤه داخل الجزء الداخلي من وحدة الصاروخ.\n"
"\n"
"يرسل الغاز إلى أول وحدة صاروخية بها مساحة متاحة.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUT.NAME"
msgid "<link=\"ROCKETINTERIORGASINPUT\">Gas Intake Fitting</link>"
msgstr "<link=\"ROCKETINTERIORGASINPUT\">موصل مدخل الغاز</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUTPORT.DESC"
msgid ""
"A direct attachment leading to the output port on the exterior of the "
"rocket."
msgstr "وصل مباشر يؤدي إلى منفذ اإلخراج على الجزء الخارجي للصاروخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUTPORT.EFFECT"
msgid ""
"Allows a direct conduit connection out of the <link=\"HABITATMODULEMEDIUM\">Spacefarer Module</link> of the rocket.\n"
"Can be used to vent <link=\"ELEMENTSGAS\">Gasses</link> to space during flight."
msgstr ""
"يسمح باتصال مباشر عبر القناة خارج <link=\"HABITATMODULEMEDIUM\">وحدة المسافر"
" الفضائي</link> للصاروخ. يمكن استخدامه لتفريغ "
"<link=\"ELEMENTSGAS\">الغازات</link> إلى الفضاء أثناء الطيران."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUTPORT.NAME"
msgid "<link=\"ROCKETINTERIORGASINPUTPORT\">Gas Spacefarer Input Port</link>"
msgstr ""
"<link=\"ROCKETINTERIORGASINPUTPORT\">منفذ إدخال الغاز للمسافر الفضائي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUT.DESC"
msgid "Refreshing breezes, on-demand."
msgstr "نسيم منعش، عند الطلب."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUT.EFFECT"
msgid ""
"Allows <link=\"ELEMENTSGAS\">Gases</link> to be drawn from rocket storage via <link=\"GASCONDUIT\">Pipes</link>.\n"
"\n"
"Draws gas from the first Rocket Module with the requested material.\n"
"\n"
"Must be built within the interior of a Rocket Module."
msgstr ""
"يسمح بسحب <link=\"ELEMENTSGAS\">الغازات</link> من تخزين الصواريخ عبر <link=\"GASCONDUIT\">األنابيب</link>يجب بناؤه داخل الجزء الداخلي لوحدة الصاروخ.\n"
"\n"
"يسحب الغاز من أول وحدة صاروخ تحتوي على المادة المطلوبة.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUT.NAME"
msgid "<link=\"ROCKETINTERIORGASOUTPUT\">Gas Output Fitting</link>"
msgstr "<link=\"ROCKETINTERIORGASOUTPUT\">موصل إخراج الغاز</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUTPORT.DESC"
msgid "A direct attachment to the input port on the exterior of a rocket."
msgstr "ارتباط مباشر بمنفذ اإلدخال على الخارج لصاروخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUTPORT.EFFECT"
msgid ""
"Allows a direct conduit connection into the "
"<link=\"HABITATMODULEMEDIUM\">Spacefarer Module</link> of a rocket."
msgstr ""
"يسمح باتصال مباشر عبر القناة إلى <link=\"HABITATMODULEMEDIUM\">وحدة المسافر "
"الفضائي</link> للصاروخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUTPORT.NAME"
msgid "<link=\"ROCKETINTERIORGASOUTPUTPORT\">Gas Spacefarer Output Port</link>"
msgstr ""
"<link=\"ROCKETINTERIORGASOUTPUTPORT\">منفذ إخراج الغاز للمسافر "
"الفضائي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUT.DESC"
msgid "Begone, foul waters!"
msgstr "انصرفوا، أيها المياه القذرة!"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUT.EFFECT"
msgid ""
"Allows <link=\"ELEMENTSLIQUID\">Liquids</link> to be pumped into rocket storage via <link=\"LIQUIDCONDUIT\">Pipes</link>.\n"
"\n"
"Sends liquid to the first Rocket Module with available space.\n"
"\n"
"Must be built within the interior of a Rocket Module."
msgstr ""
"يسمح <link=\"ELEMENTSLIQUID\">ضخ السوائل</link> إلى تخزين الصواريخ عبر <link=\"LIQUIDCONDUIT\">أنابيب</link>يجب بناؤه داخل الجزء الداخلي لوحدة الصاروخ.\n"
"\n"
"يرسل السائل إلى أول وحدة صاروخية بها مساحة متاحة.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUT.NAME"
msgid "<link=\"ROCKETINTERIORLIQUIDINPUT\">Liquid Intake Fitting</link>"
msgstr "<link=\"ROCKETINTERIORLIQUIDINPUT\">وصلة دخول السائل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUTPORT.DESC"
msgid "A direct attachment to the output port on the exterior of a rocket."
msgstr "ارتباط مباشر بمنفذ اإلخراج على الجزء الخارجي من الصاروخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUTPORT.EFFECT"
msgid ""
"Allows a direct conduit connection out of the <link=\"HABITATMODULEMEDIUM\">Spacefarer Module</link> of a rocket.\n"
"Can be used to vent <link=\"ELEMENTSLIQUID\">Liquids</link> to space during flight."
msgstr ""
"يسمح باتصال مباشر بالقناة خارج <link=\"HABITATMODULEMEDIUM\">وحدة المسافر "
"الفضائي</link> للصاروخ. يمكن استخدامه لتفريغ "
"<link=\"ELEMENTSLIQUID\">السوائل</link> إلى الفضاء أثناء الطيران."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUTPORT.NAME"
msgid ""
"<link=\"ROCKETINTERIORLIQUIDINPUTPORT\">Liquid Spacefarer Input Port</link>"
msgstr ""
"<link=\"ROCKETINTERIORLIQUIDINPUTPORT\">منفذ إدخال السوائل للمسافر "
"الفضائي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUT.DESC"
msgid "Now if only we had some water balloons..."
msgstr "اآلن لو كان لدينا بعض بالونات الماء..."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUT.EFFECT"
msgid ""
"Allows <link=\"ELEMENTSLIQUID\">Liquids</link> to be drawn from rocket storage via <link=\"LIQUIDCONDUIT\">Pipes</link>.\n"
"\n"
"Draws liquid from the first Rocket Module with the requested material.\n"
"\n"
"Must be built within the interior of a Rocket Module."
msgstr ""
"يتيح <link=\"ELEMENTSLIQUID\">السوائل</link> أن تسحب من تخزين الصواريخ عبر <link=\"LIQUIDCONDUIT\">األنابيب</link>يجب أن يبنى ضمن داخل وحدة الصاروخ.\n"
"\n"
"يسحب السائل من أول وحدة صاروخ تحتوي على المادة المطلوبة.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUT.NAME"
msgid "<link=\"ROCKETINTERIORLIQUIDOUTPUT\">Liquid Output Fitting</link>"
msgstr "<link=\"ROCKETINTERIORLIQUIDOUTPUT\">وصلة مخرج السائل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUTPORT.DESC"
msgid "A direct attachment to the input port on the exterior of a rocket."
msgstr "ارتباط مباشر بمنفذ اإلدخال على الخارج لصاروخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUTPORT.EFFECT"
msgid ""
"Allows a direct conduit connection into the "
"<link=\"HABITATMODULEMEDIUM\">Spacefarer Module</link> of a rocket."
msgstr ""
"يسمح باتصال مباشر عبر القناة إلى <link=\"HABITATMODULEMEDIUM\">وحدة المسافر "
"الفضائي</link> للصاروخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUTPORT.NAME"
msgid ""
"<link=\"ROCKETINTERIORLIQUIDOUTPUTPORT\">Liquid Spacefarer Output "
"Port</link>"
msgstr ""
"<link=\"ROCKETINTERIORLIQUIDOUTPUTPORT\">منفذ إخراج السوائل للمسافر "
"الفضائي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORPOWERPLUG.DESC"
msgid ""
"Outlets conveniently power buildings inside a cockpit using their rocket's "
"power stores."
msgstr ""
"توفر المخارج الطاقة بشكل مالئم للمباني داخل قمرة القيادة باستخدام مخازن طاقة"
" الصاروخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORPOWERPLUG.EFFECT"
msgid ""
"Provides <link=\"POWER\">Power</link> to connected buildings.\n"
"\n"
"Pulls power from <link=\"BATTERYMODULE\">Battery Modules</link> and Rocket Engines.\n"
"\n"
"Must be built within the interior of a Rocket Module."
msgstr ""
"يوفر <link=\"POWER\">الطاقة</link>يستمد الطاقة من \n"
"\n"
" للمباني المتصلة.<link=\"BATTERYMODULE\">وحدات البطارية</link>يجب بناؤه داخل الجزء الداخلي من وحدة الصاروخ.\n"
"\n"
" ومحركات الصواريخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORPOWERPLUG.NAME"
msgid "<link=\"ROCKETINTERIORPOWERPLUG\">Power Outlet Fitting</link>"
msgstr "<link=\"ROCKETINTERIORPOWERPLUG\">تركيب مأخذ الطاقة</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDINPUT.DESC"
msgid "Why organize your shelves when you can just shove everything in here?"
msgstr "لماذا تنظم رفوفك بينما يمكنك فقط دفع كل شيء هنا؟"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDINPUT.EFFECT"
msgid ""
"Allows <link=\"ELEMENTSSOLID\">Solid Materials</link> to be moved into rocket storage via <link=\"SOLIDCONDUIT\">Conveyor Rails</link>.\n"
"\n"
"Sends solid material to the first Rocket Module with available space.\n"
"\n"
"Must be built within the interior of a Rocket Module."
msgstr ""
"يتيح لـ <link=\"ELEMENTSSOLID\">المواد الصلبة</link> أن تنقل إلى تخزين الصواريخ عبر <link=\"SOLIDCONDUIT\">سكة النقل</link>يجب بناؤه داخل الجزء الداخلي للوحدة الصاروخية.\n"
"\n"
"يرسل المادة الصلبة إلى أول وحدة صاروخية تحتوي على مساحة متاحة.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDINPUT.NAME"
msgid "<link=\"ROCKETINTERIORSOLIDINPUT\">Conveyor Receptacle Fitting</link>"
msgstr "<link=\"ROCKETINTERIORSOLIDINPUT\">تركيب وعاء الناقل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDOUTPUT.DESC"
msgid "For accessing your stored luggage mid-flight."
msgstr "للوصول إلى أمتعتك المخزنة أثناء الرحلة."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDOUTPUT.EFFECT"
msgid ""
"Allows <link=\"ELEMENTSSOLID\">Solid Materials</link> to be moved out of rocket storage via <link=\"SOLIDCONDUIT\">Conveyor Rails</link>.\n"
"\n"
"Draws solid material from the first Rocket Module with the requested material.\n"
"\n"
"Must be built within the interior of a Rocket Module."
msgstr ""
"يسمح <link=\"ELEMENTSSOLID\">المواد الصلبة</link> بأن تنقل خارج تخزين الصواريخ عبر <link=\"SOLIDCONDUIT\">السكك الناقلة</link>يجب أن يبنى داخل الجزء الداخلي للوحدة الصاروخية.\n"
"\n"
"يسحب المواد الصلبة من أول وحدة صاروخية تحتوي على المادة المطلوبة.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDOUTPUT.NAME"
msgid "<link=\"ROCKETINTERIORSOLIDOUTPUT\">Conveyor Loader Fitting</link>"
