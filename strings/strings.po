msgctxt "STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_SCREW_BRASS.NAME"
msgid "<link=\"ITEMPEDESTAL\">Brass Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">قاعدة نحاسية</link>"

msgctxt "STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_SCREW_CHROME.DESC"
msgid "A display stand with a cool, steely industrial aesthetic."
msgstr "حامل عرض ذو جمالية صناعية باردة وفوالذية."

msgctxt "STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_SCREW_CHROME.NAME"
msgid "<link=\"ITEMPEDESTAL\">Chrome Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">قاعدة كروم</link>"

msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_BIOCIRCUIT_WILDBERRY.DESC"
msgid "This plush onesie soothes workers who feel really wired."
msgstr "هذا البدلة الناعمة تهدئ العمال الذين يشعرون بالتوتر الشديد."

msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_BIOCIRCUIT_WILDBERRY.NAME"
msgid "Bionic Jammies"
msgstr "بيونيك جاميز"

msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_DINO.DESC"
msgid "Pajamas for the sleepy paleontology buffs in the colony."
msgstr "بيجامات لمحبي علم الحفريات النائمين في المستعمرة."

msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_DINO.NAME"
msgid "Jurassic Jammies"
msgstr "بيجامات الجوراسي"

msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_DINO2.DESC"
msgid ""
"If all beds were part of a single bed mass, colony life would be one big "
"slumber party."
msgstr ""
"إذا كانت جميع األسرة جزءا من كتلة سرير واحدة، لكانت حياة المستعمرة حفلة نوم "
"كبيرة."

