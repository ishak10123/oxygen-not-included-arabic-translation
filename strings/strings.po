"ينتج <link=\"WATER\">الماء</link> النظيف من <link=\"DIRTYWATER\">الماء الملوث</link> باستخدام <link=\"SAND\">الرمل</link>ينتج \n"
"\n"
".<link=\"TOXICSAND\">األوساخ الملوثة</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.WATERPURIFIER.NAME"
msgid "<link=\"WATERPURIFIER\">Water Sieve</link>"
