msgctxt "STRINGS.MISC.TAGS.COMBUSTIBLEGAS_DESC"
msgid ""
"Combustible Gases can be burned as fuel to be used in the production of "
"<link=\"POWER\">Power</link> and <link=\"FOOD\">Food</link>."
