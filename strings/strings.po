msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_TRIANGLE_KELLY_WHITE.NAME"
msgid "<link=\"EXTERIORWALL\">Algae Corner</link>"
msgstr "<link=\"EXTERIORWALL\">زاوية الطحالب</link>"

msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_TRIANGLE_LEMON_WHITE.DESC"
