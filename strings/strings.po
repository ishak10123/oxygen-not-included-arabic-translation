msgid "<link=\"CRABWOOD\">Oakshell</link>"
msgstr "<link=\"CRABWOOD\">أوكشيل</link>"

msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.DESC"
msgid ""
"Critter Traps are carnivorous plants that consume small-to-medium-sized "
"critters and release <link=\"HYDROGEN\">Hydrogen Gas</link> as waste."
msgstr ""
"فخاخ المخلوقات هي نباتات آكلة للحوم تستهلك المخلوقات صغيرة إلى متوسطة الحجم "
"وتطلق <link=\"HYDROGEN\">غاز الهيدروجين</link> كمواد نفاية."

msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.DOMESTICATEDDESC"
msgid ""
"This plant eats small critters and produces <link=\"HYDROGEN\">Hydrogen "
"Gas</link>."
msgstr ""
"تأكل هذه النبتة الكائنات الصغيرة وتنتج <link=\"HYDROGEN\">غاز "
"الهيدروجين</link>."

msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.HUNGRY"
msgid "Hungry"
msgstr "جائع"

msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.NAME"
