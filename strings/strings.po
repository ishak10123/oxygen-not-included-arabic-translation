msgid "<link=\"BLUEGRASS\">Alveo Vera</link>"
msgstr "<link=\"BLUEGRASS\">ﺍﺮﻴﻓ ﻮﻴﻔﻟﺃ</link>"

msgctxt "STRINGS.CREATURES.SPECIES.BULBPLANT.DESC"
msgid ""
"Buddy Buds are leafy plants that have a positive effect on "
"<link=\"MORALE\">Morale</link>, much like a friend."
msgstr ""
" ﻰﻠﻋ ﻲﺑﺎﺠﻳﺇ ﺮﻴﺛﺄﺗ ﺎﻬﻟ ﺔﻴﻗﺭﻭ Buddy Buds "
"ﺕﺎﺗﺎﺒﻧ<link=\"MORALE\">ﺕﺎﻳﻮﻨﻌﻤﻟﺍ</link>.ﻖﻳﺪﺼﻟﺍ ﻞﺜﻣ ﺎﻣﺎﻤﺗ ،"

