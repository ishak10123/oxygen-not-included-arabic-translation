msgid "<link=\"CRABWOOD\">Oakshell Spawn</link>"
msgstr "<link=\"CRABWOOD\">ﻁﻮﻠﺒﻟﺍ ﺔﻓﺪﺻ ﺕﺎﺒﻨﺘﺳﺇ</link>"

msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.DESC"
msgid ""
"Oakshells are nonhostile critters unless their eggs are nearby.\n"
"\n"
"They eat <link=\"TOXICSAND\">Polluted Dirt</link>, <link=\"SLIMEMOLD\">Slime</link> and <link=\"COMPOST\">Rot Piles</link>.\n"
"\n"
"The shells they leave behind after molting can be crushed into <link=\"WOOD\">Wood</link>.\n"
"\n"
"Oakshells thrive in <link=\"ETHANOL\">Ethanol</link>."
msgstr ""
".ﺔﺒﻳﺮﻗ ﺎﻬﺗﺎﻀﻴﺑ ﻦﻜﺗ ﻢﻟ ﺎﻣ ﺔﻴﺋﺍﺪﻋ ﺮﻴﻏ ﺕﺎﻗﻮﻠﺨﻣ ﻲﻫ ﻁﻮﻠﺒﻟﺍ ﻑﺍﺪﺻﺃ\n"
"\n"
" ﻞﻛﺄﺗ<link=\"TOXICSAND\">ﺔﺛﻮﻠﻤﻟﺍ ﺥﺎﺳﻭﻷﺍ</link>، <link=\"SLIMEMOLD\">ﻞﺣﻮﻟﺍ</link>ﻭ <link=\"COMPOST\">ﻦﻔﻌﺘﻟﺍ ﻡﺍﻮﻛﺃ</link>.\n"
"\n"
" ﻰﻟﺇ ﺎﻬﻘﺤﺳ ﻦﻜﻤﻳ ﺪﻠﺠﻟﺍ ﺡﺮﻃ ﺪﻌﺑ ﺎﻬﻛﺮﺘﺗ ﻲﺘﻟﺍ ﺭﻮﺸﻘﻟﺍ<link=\"WOOD\">ﺐﺸﺧ</link>.\n"
"\n"
" ﻲﻓ ﺮﻫﺩﺰﺗ ﻁﻮﻠﺒﻟﺍ ﻑﺍﺪﺻﺃ<link=\"ETHANOL\">ﻝﻮﻧﺎﺜﻳﻹﺍ</link>."

msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.EGG_NAME"
msgid "<link=\"CRABWOOD\">Oakshell Roe</link>"
msgstr "<link=\"CRABWOOD\">ﻞﻴﺸﺴﻛﻭﺃ ﻭﺭ</link>"

