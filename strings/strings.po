msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_L.NAME"
msgid "Shove Vole Top"
msgstr "دفع فأر الحقل األعلى"

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_M.DESC"
msgid "A great-monument-sized Gassy Moo. Gassier and moo-ier than ever."
msgstr "مو غازي كبير بحجم نصب تذكاري. أكثر غازا وميوا من أي وقت مضى."

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_M.NAME"
msgid "Gassy Moo Top"
msgstr "مو غازي توب"

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_N.DESC"
msgid "A great-monument-sized Morb."
msgstr "مورب بحجم نصب تذكاري عظيم."

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_N.NAME"
msgid "Morb Top"
msgstr "مورب توب"

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_O.DESC"
msgid "A great-monument-sized Shine Bug."
msgstr "حشرة المعة بحجم نصب تذكاري عظيم."

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_O.NAME"
msgid "Shine Bug Top"
msgstr "أعلى بهرة اللمعان"

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_P.DESC"
msgid "A great-monument-sized Slickster."
msgstr "سليكسستر بحجم نصب تذكاري عظيم."

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_P.NAME"
msgid "Slickster Top"
msgstr "سليكسستر توب"

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_Q.DESC"
msgid "A great-monument-sized underbite."
msgstr "عضة سفلى كبيرة بحجم نصب تذكاري."

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_Q.NAME"
msgid "Pacu Top"
msgstr "باتسو توب"

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_R.DESC"
msgid "A great-monument-sized Beeta."
msgstr "بيتا بحجم نصب تذكاري عظيم."

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_R.NAME"
msgid "Beeta Top"
msgstr "بيتا توب"

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_S.DESC"
msgid "A great-monument-sized Sweetle."
msgstr "سويتل بحجم نصب تذكاري عظيم."

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_S.NAME"
msgid "Sweetle Top"
msgstr "سويتل توب"

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_T.DESC"
msgid "A great-monument-sized Plug Slug. Does not require a power source."
msgstr "دودة قابس بحجم نصب تذكاري كبير. ال تتطلب مصدر طاقة."

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_T.NAME"
msgid "Plug Slug Top"
msgstr "غطاء سدادة القابس"

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_U.DESC"
msgid "A great-monument-sized garden critter."
msgstr "مخلوق حديقة بحجم نصب تذكاري عظيم."

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_U.NAME"
msgid "Grubgrub Top"
msgstr "جراب جرب األعلى"

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_V.DESC"
msgid "It has no mouth, but still looks like it's smiling."
msgstr "ليس له فم، لكنه ما زال يبدو وكأنه يبتسم."

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_V.NAME"
msgid "Rover Top"
msgstr "روفر توب"

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_W.DESC"
msgid "A visual reminder about radiation safety."
msgstr "تذكير بصري حول سالمة اإلشعاع."

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_W.NAME"
msgid "Radsick Top I"
msgstr "رادسيك توب I"

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_X.DESC"
msgid "Progress comes at a price."
msgstr "التقدم يأتي بسعر."

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_X.NAME"
msgid "Radsick Top II"
msgstr "رادسيك توب II"

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_Y.DESC"
msgid "A cautionary tale for careless Duplicants."
msgstr "قصة تحذيرية للنسخ المتماثلة المهملة."

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_Y.NAME"
msgid "Radsick Top III"
msgstr "رادسيك توب ٣"

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_Z.DESC"
msgid "Excellent choice of decor for the entrance to highly radioactive site."
msgstr "اختيار ممتاز للديكور لمدخل موقع عالي اإلشعاع."

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.FACADES.OPTION_Z.NAME"
msgid "Radsick Top IV"
msgstr "رادسيك توب الرابع"

msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.NAME"
msgid "<link=\"MONUMENTTOP\">Monument Top</link>"
msgstr "<link=\"MONUMENTTOP\">قمة النصب التذكاري</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.MORBROVERMAKER.DESC"
msgid ""
"Allows a skilled Duplicant to manufacture a steady supply of icky yet "
"effective bots."
msgstr ""
"يسمح لشخص متمرس من النسخ المصنعة بإنتاج إمداد ثابت من الروبوتات المزعجة "
"لكنها فعالة."

msgctxt "STRINGS.BUILDINGS.PREFABS.MORBROVERMAKER.EFFECT"
msgid ""
"Uses <link=\"ZOMBIESPORES\">Zombie Spores</link> and <link=\"STEEL\">Steel</link> to craft biofueled machines that can be sent into hostile environments.\n"
"\n"
"Defunct <link=\"STORYTRAITMORBROVER\">Biobots</link> drop harvestable <link=\"STEEL\">Steel</link>."
msgstr ""
"يستخدم <link=\"ZOMBIESPORES\">بوغ الزومبي</link> و <link=\"STEEL\">الصلب</link>تسقط \n"
"\n"
" لصنع آالت تعمل بالوقود الحيوي يمكن إرسالها إلى بيائت معادية.<link=\"STORYTRAITMORBROVER\">البيوبوتات</link> المتوقفة <link=\"STEEL\">الصلب</link> القابل للحصاد."

msgctxt "STRINGS.BUILDINGS.PREFABS.MORBROVERMAKER.NAME"
msgid "<link=\"STORYTRAITMORBROVER\">Biobot Builder</link>"
msgstr "<link=\"STORYTRAITMORBROVER\">منشئ البيوبوت</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.MOULDINGTILE.DESC"
msgid "Trimming is used as purely decorative lining for walls and structures."
msgstr "يستخدم التشطيب كغطاء زخرفي بحت للجدران والهياكل."

msgctxt "STRINGS.BUILDINGS.PREFABS.MOULDINGTILE.EFFECT"
msgid ""
"Used to build the walls and floors of rooms.\n"
"\n"
"Increases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>."
msgstr ""
"يزيد من \n"
"\n"
"يستخدم لبناء جدران وأرضيات الغرف.<link=\"DECOR\">الديكور</link>، مما يساهم في <link=\"MORALE\">المعنويات</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.MOULDINGTILE.NAME"
msgid "<link=\"MOUDLINGTILE\">Trimming Tile</link>"
msgstr "<link=\"MOUDLINGTILE\">بالط تشذيب</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.MULTIMINIONDININGTABLE.DESC"
msgid "Given the option, Duplicants prefer to dine with friends."
msgstr "باالختيار، يفضل النسخ تناول الطعام مع األصدقاء."

msgctxt "STRINGS.BUILDINGS.PREFABS.MULTIMINIONDININGTABLE.EFFECT"
msgid ""
"Gives three Duplicants a place to eat.\n"
"\n"
"Sharing a meal with one or more companions provides a <link=\"MORALE\">Morale</link> boost."
msgstr ""
"مشاركة وجبة مع واحد أو أكثر من الرفاق توفر تعزيزا في \n"
"\n"
"يوفر مكانا لثالثة نسخ للطعام.<link=\"MORALE\">المعنويات</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.MULTIMINIONDININGTABLE.NAME"
msgid "<link=\"MULTIMINIONDININGTABLE\">Communal Table</link>"
msgstr "<link=\"MULTIMINIONDININGTABLE\">طاولة مشتركة</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.NOSECONEBASIC.DESC"
msgid "Every rocket requires a nosecone to fly."
msgstr "كل صاروخ يحتاج إلى مخروط أنفي للطيران."

msgctxt "STRINGS.BUILDINGS.PREFABS.NOSECONEBASIC.EFFECT"
msgid ""
"Protects a rocket during takeoff and entry, enabling space travel.\n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>, and built at the top of a rocket."
msgstr ""
"يجب بناؤه عبر \n"
"\n"
"يحمي الصاروخ أثناء اإلقالع والدخول، مما يتيح السفر إلى الفضاء.<link=\"LAUNCHPAD\">منصة الصاروخ</link>، ويجب بناؤه في أعلى الصاروخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.NOSECONEBASIC.NAME"
msgid "<link=\"NOSECONEBASIC\">Basic Nosecone</link>"
msgstr "<link=\"NOSECONEBASIC\">مقدمة أنفية أساسية</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.NOSECONEHARVEST.DESC"
msgid "Collecting the drilled-out resources requires a storage module."
msgstr "جمع الموارد المحفورة يتطلب وحدة تخزين."

msgctxt "STRINGS.BUILDINGS.PREFABS.NOSECONEHARVEST.EFFECT"
msgid ""
"Enables a rocket to drill into interstellar debris to free up <link=\"ELEMENTSGAS\">gas</link>, <link=\"ELEMENTSLIQUID\">liquid</link> and <link=\"ELEMENTSSOLID\">solid</link> resources in space.\n"
"\n"
"Engine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>. \n"
"\n"
"Must be built at the top of a rocket with <link=\"ELEMENTSGAS\">gas</link>, <link=\"ELEMENTSLIQUID\">liquid</link> or <link=\"ELEMENTSSOLID\">solid</link> Cargo Module attached to store the appropriate resources."
msgstr ""
"يتيح للصاروخ الحفر في الحطام بين النجوم لتحرير <link=\"ELEMENTSGAS\">الغاز</link> ،<link=\"ELEMENTSLIQUID\">السائل</link> و <link=\"ELEMENTSSOLID\">المواد الصلبة</link>يجب بناء المحرك عبر \n"
"\n"
" في الفضاء.<link=\"LAUNCHPAD\">منصة اإلطالق</link>يجب بناؤه في أعلى الصاروخ مع ربط \n"
"\n"
".<link=\"ELEMENTSGAS\">وحدة حمولة الغاز</link> ،<link=\"ELEMENTSLIQUID\">وحدة حمولة السائل</link> أو <link=\"ELEMENTSSOLID\">وحدة حمولة المواد الصلبة</link> لتخزين الموارد المناسبة."

msgctxt "STRINGS.BUILDINGS.PREFABS.NOSECONEHARVEST.NAME"
msgid "<link=\"NOSECONEHARVEST\">Drillcone</link>"
msgstr "<link=\"NOSECONEHARVEST\">مخروط الحفر</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.DESC"
msgid ""
"Radbolt generators and reflectors make radiation usable by other buildings."
msgstr ""
"تجعل مولدات وأجهزة عكس األشعة الراديوية اإلشعاع قابال لالستخدام من قبل "
"المباني األخرى."

msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.EFFECT"
msgid ""
"Uses <link=\"ENRICHEDURANIUM\">Enriched Uranium</link> to produce <link=\"RADIATION\">Radiation</link> for Radbolt production.\n"
"\n"
"Generates a massive amount of <link=\"HEAT\">Heat</link>. Overheating will result in an explosive meltdown."
msgstr ""
"يستخدم <link=\"ENRICHEDURANIUM\">اليورانيوم المخصب</link> إلنتاج <link=\"RADIATION\">اإلشعاع</link>يولد كمية هائلة من \n"
"\n"
" إلنتاج tlobdaR.<link=\"HEAT\">الحرارة</link>. السخونة الزائدة ستؤدي إلى انصهار متفجر."

msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.INPUT_PORT_ACTIVE"
msgid "Fuel Delivery Enabled"
msgstr "تم تمكين توصيل الوقود"

msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.INPUT_PORT_INACTIVE"
msgid "Fuel Delivery Disabled"
msgstr "تم تعطيل توصيل الوقود"

msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.LOGIC_PORT"
msgid "Fuel Delivery Control"
msgstr "التحكم في تسليم الوقود"

msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.NAME"
msgid "<link=\"NUCLEARREACTOR\">Research Reactor</link>"
msgstr "<link=\"NUCLEARREACTOR\">مفاعل بحثي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARRESEARCHCENTER.DESC"
msgid "Comes with a few ions thrown in, free of charge."
msgstr "يأتي مع بعض األيونات مضافة، مجانا."

msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARRESEARCHCENTER.EFFECT"
msgid ""
"Conducts <link=\"RESEARCHDLC1\">Materials Science Research</link> to unlock new technologies.\n"
"\n"
"Consumes Radbolts.\n"
"\n"
"Assigned Duplicants must possess the <link=\"ATOMICRESEARCH\">Applied Sciences Research</link> skill."
msgstr ""
"يجري <link=\"RESEARCHDLC1\">بحث علوم المواد</link>يجب أن يمتلك النسخ المخصص لها مهارة \n"
"\n"
"يستهلك stlobdaR.\n"
"\n"
" لفتح تقنيات جديدة.<link=\"ATOMICRESEARCH\">بحث العلوم التطبيقية</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARRESEARCHCENTER.NAME"
msgid "<link=\"NUCLEARRESEARCHCENTER\">Materials Study Terminal</link>"
msgstr "<link=\"NUCLEARRESEARCHCENTER\">محطة دراسة المواد</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.DESC"
msgid ""
"Automatic dispensers will store and drop resources in small quantities."
msgstr "ستقوم الموزعات التلقائية بتخزين الموارد وإسقاطها بكميات صغيرة."

msgctxt "STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.EFFECT"
msgid ""
"Stores any <link=\"ELEMENTSSOLID\">Solid Materials</link> delivered to it by Duplicants.\n"
"\n"
"Dumps stored materials back into the world when it receives a <b><style=\"logic_on\">Green Signal</style></b>."
msgstr ""
"يخزن أي <link=\"ELEMENTSSOLID\">مواد صلبة</link>يقوم بإفراغ المواد المخزنة مرة أخرى في العالم عندما يتلقى \n"
"\n"
" يتم تسليمها إليه بواسطة النسخ المتماثلة.<b><style=\"logic_on\">إشارة خضراء</style></b>."

msgctxt "STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.LOGIC_PORT"
msgid "Dump Trigger"
msgstr "زناد التفريغ"

msgctxt "STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Dump all stored materials"
msgstr ""
"<b><style=\"logic_on\">إشارة خضراء</style></b>: قم بتفريغ جميع المواد "
"المخزنة"

msgctxt "STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Store materials"
msgstr "<b><style=\"logic_off\">إشارة حمراء</style></b>: تخزين المواد"

msgctxt "STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.NAME"
msgid "<link=\"OBJECTDISPENSER\">Automatic Dispenser</link>"
msgstr "<link=\"OBJECTDISPENSER\">موزع تلقائي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.OILCHANGER.DESC"
msgid "A fresh supply of oil keeps the ol' joints from getting too creaky."
msgstr ""
"إمداد جديد من الزيت يحافظ على مفاصل العجالت القديمة من أن تصبح صريرها شديدا."

msgctxt "STRINGS.BUILDINGS.PREFABS.OILCHANGER.EFFECT"
msgid ""
"Uses <link=\"LUBRICATINGOIL\">Gear Oil</link> to keep Duplicants' bionic "
"parts running smoothly."
msgstr ""
"يستخدم <link=\"LUBRICATINGOIL\">زيت التروس</link> للحفاظ على تشغيل األجزاء "
"البيونية للنسخ بسالسة."

msgctxt "STRINGS.BUILDINGS.PREFABS.OILCHANGER.NAME"
msgid "<link=\"OILCHANGER\">Lubrication Station</link>"
msgstr "<link=\"OILCHANGER\">محطة التزييت</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.OILREFINERY.DESC"
msgid "Petroleum can only be produced from the refinement of crude oil."
msgstr "يمكن إنتاج البترول فقط من تكرير النفط الخام."

msgctxt "STRINGS.BUILDINGS.PREFABS.OILREFINERY.EFFECT"
msgid ""
"Converts <link=\"CRUDEOIL\">Crude Oil</link> into "
"<link=\"PETROLEUM\">Petroleum</link> and <link=\"METHANE\">Natural "
"Gas</link>."
msgstr ""
"يحول <link=\"CRUDEOIL\">النفط الخام</link> إلى "
"<link=\"PETROLEUM\">البترول</link> و <link=\"METHANE\">الغاز الطبيعي</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.OILREFINERY.NAME"
msgid "<link=\"OILREFINERY\">Oil Refinery</link>"
msgstr "<link=\"OILREFINERY\">مصنع تكرير النفط</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.OILWELLCAP.DESC"
msgid "Water pumped into an oil reservoir cannot be recovered."
msgstr "الماء الذي يضخ في خزان النفط ال يمكن استعادته."

msgctxt "STRINGS.BUILDINGS.PREFABS.OILWELLCAP.EFFECT"
msgid ""
"Extracts <link=\"CRUDEOIL\">Crude Oil</link> using clean <link=\"WATER\">Water</link>.\n"
"\n"
"Must be built atop an <link=\"OILWELL\">Oil Reservoir</link>."
msgstr ""
"يستخرج <link=\"CRUDEOIL\">النفط الخام</link> باستخدام <link=\"WATER\">الماء النظيف</link>يجب أن يبنى فوق \n"
"\n"
".<link=\"OILWELL\">خزان النفط</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.OILWELLCAP.NAME"
msgid "<link=\"OILWELLCAP\">Oil Well</link>"
msgstr "<link=\"OILWELLCAP\">بئر نفط</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ORBITALCARGOMODULE.DESC"
msgid ""
"It's a generally good idea to pack some supplies when exploring unknown "
"worlds."
msgstr "من الجيد بشكل عام حمل بعض اإلمدادات عند استكشاف عوالم غير معروفة."

msgctxt "STRINGS.BUILDINGS.PREFABS.ORBITALCARGOMODULE.EFFECT"
msgid ""
"Delivers cargo to the surface of Planetoids that do not yet have a <link=\"LAUNCHPAD\">Rocket Platform</link>. \n"
"\n"
"Must be built via Rocket Platform."
msgstr ""
"يوصل البضائع إلى سطح الكواكب الصغيرة التي ال تمتلك بعد <link=\"LAUNCHPAD\">منصة صواريخ</link>يجب بناؤه عبر منصة الصواريخ.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.ORBITALCARGOMODULE.NAME"
msgid "<link=\"ORBITALCARGOMODULE\">Orbital Cargo Module</link>"
msgstr "<link=\"ORBITALCARGOMODULE\">وحدة الشحن المدارية</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ORBITALRESEARCHCENTER.DESC"
msgid ""
"Orbital Data Collection Labs record data while orbiting a Planetoid and "
"write it to a <link=\"ORBITALRESEARCHDATABANK\">Data Bank</link>. "
msgstr ""
"تقوم مختبرات جمع البيانات المدارية بتسجيل البيانات أثناء دورانها حول جرم "
"كوكبي وتكتبها في <link=\"ORBITALRESEARCHDATABANK\">بنك البيانات</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.ORBITALRESEARCHCENTER.EFFECT"
msgid ""
"Creates <link=\"ORBITALRESEARCHDATABANK\">Data Banks</link> that can be consumed at a <link=\"DLC1COSMICRESEARCHCENTER\">Virtual Planetarium</link> to unlock new technologies.\n"
"\n"
"Consumes <link=\"POLYPROPYLENE\">Plastic</link> and <link=\"POWER\">Power</link>."
msgstr ""
"ينشئ <link=\"ORBITALRESEARCHDATABANK\">بنوك البيانات</link> التي يمكن استخدامها في <link=\"DLC1COSMICRESEARCHCENTER\">الكوكب االفتراضي</link>يستهلك \n"
"\n"
" لفتح التقنيات الجديدة.<link=\"POLYPROPYLENE\">البالستيك</link> و <link=\"POWER\">الطاقة</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.ORBITALRESEARCHCENTER.NAME"
msgid "<link=\"ORBITALRESEARCHCENTER\">Orbital Data Collection Lab</link>"
msgstr "<link=\"ORBITALRESEARCHCENTER\">مختبر جمع البيانات المدارية</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.ORESCRUBBER.DESC"
msgid ""
"Scrubbers sanitize freshly mined materials before they're brought into the "
"colony."
msgstr ""
"تقوم أجهزة التنظيف بتعقيم المواد المستخرجة حديثا قبل أن تدخل إلى المستعمرة."

msgctxt "STRINGS.BUILDINGS.PREFABS.ORESCRUBBER.EFFECT"
msgid ""
"Kills a significant amount of <link=\"DISEASE\">Germs</link> present on "
"<link=\"RAWMINERAL\">Raw Ore</link>."
msgstr ""
"يقضي على كمية كبيرة من <link=\"DISEASE\">الجراثيم</link> الموجودة على "
"<link=\"RAWMINERAL\">الخامات الخام</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.ORESCRUBBER.NAME"
msgid "<link=\"ORESCRUBBER\">Ore Scrubber</link>"
msgstr "<link=\"ORESCRUBBER\">منقي الخام</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANK.DESC"
msgid ""
"Solid oxidizers allows rocket fuel to be efficiently burned in the vacuum of"
" space."
msgstr "المؤكسدات الصلبة تسمح بحرق وقود الصواريخ بكفاءة في فراغ الفضاء."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANK.EFFECT"
msgid ""
"Stores <link=\"OXYROCK\">Oxylite</link> and other oxidizers for burning "
"rocket fuels."
msgstr "يخزن <link=\"OXYROCK\">أوكسايلت</link> وأكسدة أخرى الشتعال وقود الصواريخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANK.NAME"
msgid "<link=\"OXIDIZERTANK\">Solid Oxidizer Tank</link>"
msgstr "<link=\"OXIDIZERTANK\">خزان المؤكسد الصلب</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANK.UI_FILTER_CATEGORY"
msgid "Accepted Oxidizers"
msgstr "المؤكسدات المقبولة"

msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKCLUSTER.DESC"
msgid ""
"Solid oxidizers allows rocket fuel to be efficiently burned in the vacuum of"
" space."
msgstr "المؤكسدات الصلبة تسمح بحرق وقود الصواريخ بكفاءة في فراغ الفضاء."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKCLUSTER.EFFECT"
msgid ""
"Stores <link=\"OXYROCK\">Oxylite</link> and other oxidizers for burning rocket fuels.\n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr ""
"يخزن <link=\"OXYROCK\">أوكساياليت</link>يجب بناؤه عبر \n"
"\n"
" وأكسيدات أخرى لوقود الصواريخ القابل لالشتعال.<link=\"LAUNCHPAD\">منصة الصواريخ</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKCLUSTER.NAME"
msgid "<link=\"OXIDIZERTANKCLUSTER\">Large Solid Oxidizer Tank</link>"
msgstr "<link=\"OXIDIZERTANKCLUSTER\">خزان مؤكسد صلب كبير</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKCLUSTER.UI_FILTER_CATEGORY"
msgid "Accepted Oxidizers"
msgstr "المؤكسدات المقبولة"

msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUID.DESC"
msgid "Liquid oxygen improves the thrust-to-mass ratio of rocket fuels."
msgstr "األكسجين السائل يحسن نسبة الدفع إلى الكتلة في وقود الصواريخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUID.EFFECT"
msgid ""
"Stores <link=\"LIQUIDOXYGEN\">Liquid Oxygen</link> for burning rocket fuels."
msgstr "يخزن <link=\"LIQUIDOXYGEN\">األكسجين السائل</link> لحرق وقود الصواريخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUID.NAME"
msgid "<link=\"OXIDIZERTANKLIQUID\">Liquid Oxidizer Tank</link>"
msgstr "<link=\"OXIDIZERTANKLIQUID\">خزان المؤكسد السائل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUIDCLUSTER.DESC"
msgid "Liquid oxygen improves the thrust-to-mass ratio of rocket fuels."
msgstr "األكسجين السائل يحسن نسبة الدفع إلى الكتلة في وقود الصواريخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUIDCLUSTER.EFFECT"
msgid ""
"Stores <link=\"LIQUIDOXYGEN\">Liquid Oxygen</link> for burning rocket fuels. \n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr ""
"يخزن <link=\"LIQUIDOXYGEN\">األكسجين السائل</link>يجب بناؤه عبر \n"
"\n"
" لحرق وقود الصواريخ.<link=\"LAUNCHPAD\">منصة اإلطالق</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUIDCLUSTER.NAME"
msgid "<link=\"OXIDIZERTANKLIQUIDCLUSTER\">Liquid Oxidizer Tank</link>"
msgstr "<link=\"OXIDIZERTANKLIQUIDCLUSTER\">خزان المؤكسد السائل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKLOCKER.DESC"
msgid ""
"An oxygen mask dock will store and refill masks while they're not in use."
msgstr ""
"سوف يقوم رصيف قناع األكسجين بتخزين وإعادة تعبئة األقنعة أثناء عدم استخدامها."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKLOCKER.EFFECT"
msgid ""
"Stores <link=\"OXYGENMASK\">Oxygen Masks</link> and refuels them with <link=\"OXYGEN\">Oxygen</link>.\n"
"\n"
"Build next to an <link=\"OXYGENMASKMARKER\">Oxygen Mask Checkpoint</link> to make Duplicants put on masks when passing by."
msgstr ""
"يخزن <link=\"OXYGENMASK\">أقنعة األكسجين</link> ويزودها بالوقود باستخدام <link=\"OXYGEN\">األكسجين</link>قم بالبناء بجانب \n"
"\n"
".<link=\"OXYGENMASKMARKER\">نقطة فحص قناع األكسجين</link> لجعل الدوبليكانت يضعون األقنعة عند المرور بها."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKLOCKER.NAME"
msgid "<link=\"OXYGENMASKLOCKER\">Oxygen Mask Dock</link>"
msgstr "<link=\"OXYGENMASKLOCKER\">وحدة قناع األكسجين</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKMARKER.DESC"
msgid ""
"A checkpoint must have a correlating dock built on the opposite side its "
"arrow faces."
msgstr ""
"يجب أن يكون لنقطة التفتيش رصيف مطابق مبني على الجانب المقابل لالتجاه الذي "
"تشير إليه السهم."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKMARKER.EFFECT"
msgid ""
"Marks a threshold where Duplicants must put on or take off an <link=\"OXYGENMASK\">Oxygen Mask</link>.\n"
"\n"
"Must be built next to an <link=\"OXYGENMASKLOCKER\">Oxygen Mask Dock</link>.\n"
"\n"
"Can be rotated before construction."
msgstr ""
"يشير إلى عتبة حيث يجب على النسخ ارتداء أو خلع <link=\"OXYGENMASK\">قناع األكسجين</link>يجب بناؤه بجانب \n"
"\n"
".<link=\"OXYGENMASKLOCKER\">مرسى قناع األكسجين</link>يمكن تدويره قبل البناء.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKMARKER.NAME"
msgid "<link=\"OXYGENMASKMARKER\">Oxygen Mask Checkpoint</link>"
msgstr "<link=\"OXYGENMASKMARKER\">نقطة فحص قناع األكسجين</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKSTATION.DESC"
msgid ""
"Duplicants can't pass by a station if it lacks enough oxygen to fill a mask."
msgstr ""
"ال يستطيع النسخ المزدوج المرور بمحطة إذا كانت تفتقر إلى ما يكفي من األكسجين "
"لملء القناع."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKSTATION.EFFECT"
msgid ""
"Uses designated <link=\"METAL\">Metal Ores</link> from filter settings to create <link=\"OXYGENMASK\">Oxygen Masks</link>.\n"
"\n"
"Automatically draws in ambient <link=\"OXYGEN\">Oxygen</link> to fill masks.\n"
"\n"
"Marks a threshold where Duplicants must put on or take off a mask.\n"
"\n"
"Can be rotated before construction."
msgstr ""
"يستخدم <link=\"METAL\">خامات المعدن</link> المحددة من إعدادات الفلتر لصنع <link=\"OXYGENMASK\">أقنعة األكسجين</link>يقوم تلقائيا بسحب \n"
"\n"
".<link=\"OXYGEN\">األكسجين</link>يمكن تدويره قبل البناء.\n"
"\n"
"يحدد حدا حيث يجب على النسخ ارتداء القناع أو خلعه.\n"
"\n"
" المحيط لملء األقنعة."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKSTATION.NAME"
msgid "<link=\"OXYGENMASKSTATION\">Oxygen Mask Station</link>"
msgstr "<link=\"OXYGENMASKSTATION\">محطة أقنعة األكسجين</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.OXYLITEREFINERY.DESC"
msgid ""
"Oxylite is a solid and easily transportable source of consumable oxygen."
msgstr "أوكساياليت هو مصدر صلب وسهل النقل لألكسجين القابل لالستهالك."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXYLITEREFINERY.EFFECT"
msgid ""
"Synthesizes <link=\"OXYROCK\">Oxylite</link> using "
"<link=\"OXYGEN\">Oxygen</link> and a small amount of "
"<link=\"GOLD\">Gold</link>."
msgstr ""
"يصنع <link=\"OXYROCK\">أوكسياليت</link> باستخدام "
"<link=\"OXYGEN\">األكسجين</link> وكمية صغيرة من <link=\"GOLD\">الذهب</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXYLITEREFINERY.NAME"
msgid "<link=\"OXYLITEREFINERY\">Oxylite Refinery</link>"
msgstr "<link=\"OXYLITEREFINERY\">مصنع أوكساليت</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.OXYSCONCE.DESC"
msgid "Sconces prevent diffused oxygen from being wasted inside storage bins."
msgstr ""
"تمنع األباجورات الهيموكسيد انتشار األوكسجين المهدور داخل صناديق التخزين."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXYSCONCE.EFFECT"
msgid ""
"Stores a small chunk of <link=\"OXYROCK\">Oxylite</link> which gradually "
"releases <link=\"OXYGEN\">Oxygen</link> into the environment."
msgstr ""
"يخزن قطعة صغيرة من <link=\"OXYROCK\">أوكساياليت</link> التي تطلق تدريجيا "
"<link=\"OXYGEN\">األكسجين</link> في البيئة."

msgctxt "STRINGS.BUILDINGS.PREFABS.OXYSCONCE.NAME"
msgid "<link=\"OXYSCONCE\">Oxylite Sconce</link>"
msgstr "<link=\"OXYSCONCE\">شمعدان أوكسيليت</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PARKSIGN.DESC"
msgid "Passing through parks will increase Duplicant Morale."
msgstr "المرور عبر الحدائق سيزيد من معنويات الدوبليكانت."

msgctxt "STRINGS.BUILDINGS.PREFABS.PARKSIGN.EFFECT"
msgid "Classifies an area as a Park or Nature Reserve."
msgstr "يصنف منطقة كمتنزه أو محمية طبيعية."

msgctxt "STRINGS.BUILDINGS.PREFABS.PARKSIGN.NAME"
msgid "<link=\"PARKSIGN\">Park Sign</link>"
msgstr "<link=\"PARKSIGN\">الفتة المنتزه</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PARTYCAKE.DESC"
msgid "Any way you slice it, that's a good looking cake."
msgstr "بأي طريقة تقطعها، هذه كعكة جميلة المظهر."

msgctxt "STRINGS.BUILDINGS.PREFABS.PARTYCAKE.EFFECT"
msgid ""
"Increases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>.\n"
"\n"
"Adds a <link=\"MORALE\">Morale</link> bonus to Duplicants' parties."
msgstr ""
"يزيد <link=\"DECOR\">الديكور</link>، مما يساهم في <link=\"MORALE\">المعنويات</link>يضيف مكافأة \n"
"\n"
".<link=\"MORALE\">المعنويات</link> لحفالت النسخ."

msgctxt "STRINGS.BUILDINGS.PREFABS.PARTYCAKE.NAME"
msgid "<link=\"PARTYCAKE\">Triple Decker Cake</link>"
msgstr "<link=\"PARTYCAKE\">كعكة ثالثية الطبقات</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PEATGENERATOR.DESC"
msgid ""
"It gives off an aroma that some Duplicants find inexplicably nostalgic."
msgstr "ينبعث منه عطر يجد بعض النسخ فيه شعورا حنينا غير مفسر."

msgctxt "STRINGS.BUILDINGS.PREFABS.PEATGENERATOR.EFFECT"
msgid ""
"Burns <link=\"PEAT\">Peat</link> to produce electrical <link=\"POWER\">Power</link>.\n"
"\n"
"Produces a small amount of <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> and <link=\"DIRTYWATER\">Polluted Water</link>."
msgstr ""
"يحرق <link=\"PEAT\">الماس</link> إلنتاج <link=\"POWER\">الطاقة الكهربائية</link>ينتج كمية صغيرة من \n"
"\n"
".<link=\"CARBONDIOXIDE\">ثاني أكسيد الكربون</link> و<link=\"DIRTYWATER\">المياه الملوثة</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.PEATGENERATOR.NAME"
msgid "<link=\"PEATGENERATOR\">Peat Burner</link>"
msgstr "<link=\"PEATGENERATOR\">موقد الخث</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PETROLEUMGENERATOR.DESC"
msgid ""
"Petroleum generators have a high energy output but produce a great deal of "
"waste."
msgstr ""
"تتمتع مولدات البترول بمعدل طاقة مرتفع لكنها تنتج قدرا كبيرا من النفايات."

msgctxt "STRINGS.BUILDINGS.PREFABS.PETROLEUMGENERATOR.EFFECT"
msgid ""
"Converts <link=\"PETROLEUM\">Petroleum</link>, <link=\"ETHANOL\">Ethanol</link> or <link=\"REFINEDLIPID\">Biodiesel</link> into electrical <link=\"POWER\">Power</link>.\n"
"\n"
"Produces <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> and <link=\"DIRTYWATER\">Polluted Water</link>."
msgstr ""
"يحول <link=\"PETROLEUM\">البترول</link> ،<link=\"ETHANOL\">اإليثانول</link> أو <link=\"REFINEDLIPID\">الديزل الحيوي</link> إلى <link=\"POWER\">طاقة كهربائية</link>ينتج \n"
"\n"
".<link=\"CARBONDIOXIDE\">ثاني أكسيد الكربون</link> و<link=\"DIRTYWATER\">مياه ملوثة</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.PETROLEUMGENERATOR.NAME"
msgid "<link=\"PETROLEUMGENERATOR\">Petroleum Generator</link>"
msgstr "<link=\"PETROLEUMGENERATOR\">مولد البترول</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PHONOBOX.DESC"
msgid "Dancing helps Duplicants get their innermost feelings out."
msgstr "الرقص يساعد المكررين على التعبير عن مشاعرهم الداخلية."

msgctxt "STRINGS.BUILDINGS.PREFABS.PHONOBOX.EFFECT"
msgid ""
"Plays music for Duplicants to dance to on their breaks.\n"
"\n"
"Increases Duplicant <link=\"MORALE\">Morale</link>."
msgstr ""
"يزيد \n"
"\n"
"يعزف الموسيقى ليتمكن المكررون من الرقص خالل استراحاتهم.<link=\"MORALE\">المعنويات</link> لدى المكررين."

msgctxt "STRINGS.BUILDINGS.PREFABS.PHONOBOX.NAME"
msgid "<link=\"PHONOBOX\">Jukebot</link>"
msgstr "<link=\"PHONOBOX\">جومبو بوت</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PIONEERLANDER.DESC"
msgid ""
"Lands a Duplicant on a Planetoid from an orbiting "
"<link=\"PIONEERMODULE\">Trailblazer Module</link>."
msgstr ""
"يهبط نسخة مكررة على جرم كوكبي من وحدة "
"<link=\"PIONEERMODULE\">المستكشف</link> التي تدور في المدار."

msgctxt "STRINGS.BUILDINGS.PREFABS.PIONEERLANDER.NAME"
msgid "<link=\"PIONEERMODULE\">Trailblazer Lander</link>"
msgstr "<link=\"PIONEERMODULE\">مركبة الهبوط رائد الطريق</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PIONEERMODULE.DESC"
msgid "That's one small step for Dupekind."
msgstr "هذه خطوة صغيرة واحدة للجنس المزيف."

msgctxt "STRINGS.BUILDINGS.PREFABS.PIONEERMODULE.EFFECT"
msgid ""
"Enables travel to Planetoids that do not yet have a <link=\"LAUNCHPAD\">Rocket Platform</link>.\n"
"\n"
"Can hold one Duplicant traveller.\n"
"\n"
"Deployment is available while in a Starmap hex adjacent to a Planetoid. \n"
"\n"
"Must be built via Rocket Platform."
msgstr ""
"يمكن السفر إلى الكواكب الصغيرة التي ال تمتلك بعد <link=\"LAUNCHPAD\">منصة صواريخ</link>يجب بناؤه عبر منصة الصواريخ.\n"
"\n"
"يمكن نشره أثناء التواجد في خلية خريطة النجوم المالصقة لكوكب صغير.\n"
"\n"
"يمكن أن يحمل مسافرا واحدا من الدوبليكانت.\n"
"\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.PIONEERMODULE.NAME"
msgid "<link=\"PIONEERMODULE\">Trailblazer Module</link>"
msgstr "<link=\"PIONEERMODULE\">وحدة الرائد</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.DESC"
msgid "Four pixels which can be individually designated different colors."
msgstr "أربع بكسالت يمكن تعيين ألوان مختلفة لكل منها بشكل منفصل."

msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.EFFECT"
msgid ""
"Pixels can be designated a color when it receives a <b><style=\"logic_on\">Green Signal</style></b> and a different color when it receives a <b><style=\"logic_off\">Red Signal</style></b>.\n"
"\n"
"Input from an <link=\"LOGICWIRE\">Automation Wire</link> controls the whole strip. Input from an <link=\"LOGICRIBBON\">Automation Ribbon</link> can control individual pixels on the strip."
msgstr ""
"يمكن تعيين لون للبكسالت عندما تتلقى <b><style=\"logic_on\">إشارة خضراء</style></b> ولون مختلف عندما تتلقى <b><style=\"logic_off\">إشارة حمراء</style></b>المدخالت من \n"
"\n"
".<link=\"LOGICWIRE\">سلك األتمتة</link> تتحكم في الشريط بأكمله. المدخالت من <link=\"LOGICRIBBON\">شريط األتمتة</link> يمكن أن تتحكم في بكسالت فردية على الشريط."

msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.INPUT_NAME"
msgid "RIBBON INPUT"
msgstr "إدخال الشريط"

msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.INPUT_PORT_ACTIVE"
msgid ""
"<b><style=\"logic_on\">Green Signal</style></b>: Display the configured "
"<b><style=\"logic_on\">Green Signal</style></b> pixels"
msgstr ""
"<b><style=\"logic_on\">إشارة خضراء</style></b>: عرض البكسالت المكونة إلشارة "
"<b><style=\"logic_on\">خضراء</style></b>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.INPUT_PORT_INACTIVE"
msgid ""
"<b><style=\"logic_off\">Red Signal</style></b>: Display the configured "
"<b><style=\"logic_off\">Red Signal</style></b> pixels"
msgstr ""
"<b><style=\"logic_off\">إشارة حمراء</style></b>: عرض بكسالت "
"<b><style=\"logic_off\">اإلشارة الحمراء</style></b> المكونة"

msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.LOGIC_PORT"
msgid "Color Selection"
msgstr "اختيار اللون"

msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.NAME"
msgid "<link=\"PIXELPACK\">Pixel Pack</link>"
msgstr "<link=\"PIXELPACK\">حزمة البكسل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.SIDESCREEN_TITLE"
msgid "Pixel Pack"
msgstr "حزمة البكسل"

msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.DESC"
msgid "Domestically grown seeds mature more quickly than wild plants."
msgstr "تنضج البذور المزروعة محليا أسرع من النباتات البرية."

msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.EFFECT"
msgid "Grows one <link=\"PLANTS\">Plant</link> from a <link=\"PLANTS\">Seed</link>."
msgstr "يزرع <link=\"PLANTS\">نبتة</link> واحدة من <link=\"PLANTS\">بذرة</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.BRISTLEBLOSSOM.DESC"
msgid "The interior is lined with tiny barbs."
msgstr "الداخل مبطن بأشواك صغيرة."

msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.BRISTLEBLOSSOM.NAME"
msgid "<link=\"PLANTERBOX\">Bristly Green Planter Box</link>"
msgstr "<link=\"PLANTERBOX\">صندوق زراعة أخضر أشعث</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.DEFAULT_PLANTERBOX.DESC"
msgid "Domestically grown seeds mature more quickly than wild plants."
msgstr "تنضج البذور المزروعة محليا أسرع من النباتات البرية."

msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.DEFAULT_PLANTERBOX.NAME"
msgid "<link=\"PLANTERBOX\">Planter Box</link>"
msgstr "<link=\"PLANTERBOX\">صندوق الزرع</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.MEALWOOD.DESC"
msgid "Inspired by genetically modified nature."
msgstr "مستوحى من الطبيعة المعدلة وراثيا."

msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.MEALWOOD.NAME"
msgid "<link=\"PLANTERBOX\">Mealy Teal Planter Box</link>"
msgstr "<link=\"PLANTERBOX\">صندوق زراعة تبن مربى</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.SALMON_PINK.DESC"
msgid "It's not exactly a subtle color."
msgstr "ليست لونا دقيقا بالضبط."

msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.SALMON_PINK.NAME"
msgid "<link=\"PLANTERBOX\">Flashy Planter Box</link>"
msgstr "<link=\"PLANTERBOX\">صندوق زهور المع</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.SLEETWHEAT.DESC"
msgid "The thick paint drips are invisible from a distance."
msgstr "قطرات الطالء السميكة غير مرئية من بعيد."

msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.SLEETWHEAT.NAME"
msgid "<link=\"PLANTERBOX\">Sleet Blue Planter Box</link>"
msgstr "<link=\"PLANTERBOX\">صندوق زراعة بلون أزرق ثلجي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.WHEEZEWORT.DESC"
msgid "For the dreamy agriculturalist."
msgstr "للمزارع الحالم."

msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.WHEEZEWORT.NAME"
msgid "<link=\"PLANTERBOX\">Wheezy Whorl Planter Box</link>"
msgstr "<link=\"PLANTERBOX\">صندوق زراعة ويزي وورل</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.NAME"
msgid "<link=\"PLANTERBOX\">Planter Box</link>"
msgstr "<link=\"PLANTERBOX\">صندوق الزرع</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PLASTICFLOWERS.DESCRIPTION"
msgid "Maintenance-free blooms that will outlive us all."
msgstr "أزهار خالية من الصيانة ستعيش أطول منا جميعا."

msgctxt "STRINGS.BUILDINGS.PREFABS.PLASTICFLOWERS.LORE_DLC2"
msgid ""
"Manufactured by Home Staging Heroes Ltd. as commissioned by the Gravitas Facility, to <i>\"Make Space Feel More Like Home.\"</i>\n"
"\n"
"This bouquet is designed to smell like freshly baked cookies."
msgstr ""
"صنع بواسطة شركة dtL seoreH gnigatS emoH. بتكليف من منشأة sativarG، لـ <i>\"جعل المكان يشعر وكأنه أكثر حرية كالمنزل.\"</i>تم تصميم هذا البوكيه ليشبه رائحة البسكويت الطازج.\n"
"\n"

msgctxt "STRINGS.BUILDINGS.PREFABS.PLASTICFLOWERS.NAME"
msgid "Plastic Flowers"
msgstr "زهور بالستيكية"

msgctxt "STRINGS.BUILDINGS.PREFABS.PLASTICTILE.DESC"
msgid ""
"Plastic tile is mildly antiseptic and can help limit the spread of germs in "
"a colony."
msgstr ""
"البالط البالستيكي مطهر بدرجة خفيفة ويمكن أن يساعد في الحد من انتشار الجراثيم"
" في المستعمرة."

msgctxt "STRINGS.BUILDINGS.PREFABS.PLASTICTILE.EFFECT"
msgid ""
"Used to build the walls and floors of rooms.\n"
"\n"
"Significantly increases Duplicant runspeed."
msgstr ""
"يزيد بشكل كبير من سرعة الجري للنسخ المكررة.\n"
"يستخدم لبناء جدران وأرضيات الغرف."

msgctxt "STRINGS.BUILDINGS.PREFABS.PLASTICTILE.NAME"
msgid "<link=\"PLASTICTILE\">Plastic Tile</link>"
msgstr "<link=\"PLASTICTILE\">بالط بالستيكي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.POIBUNKEREXTERIORDOOR.EFFECT"
msgid "A strong door with a sophisticated genetic lock."
msgstr "باب قوي بقفل جيني متطور."

msgctxt "STRINGS.BUILDINGS.PREFABS.POIBUNKEREXTERIORDOOR.NAME"
msgid "Security Door"
msgstr "باب أمني"

msgctxt "STRINGS.BUILDINGS.PREFABS.POIDLC2SHOWROOMDOOR.EFFECT"
msgid ""
"Large double doors identical to those you might find at the main entrance to"
" a large facility."
msgstr ""
"أبواب مزدوجة كبيرة مماثلة لتلك التي قد تجدها عند المدخل الرئيسي لمنشأة "
"كبيرة."

msgctxt "STRINGS.BUILDINGS.PREFABS.POIDLC2SHOWROOMDOOR.NAME"
msgid "Showroom Doors"
msgstr "أبواب المعرض"

msgctxt "STRINGS.BUILDINGS.PREFABS.POIDOORINTERNAL.EFFECT"
msgid "A strong door with a sophisticated genetic lock."
msgstr "باب قوي بقفل جيني متطور."

msgctxt "STRINGS.BUILDINGS.PREFABS.POIDOORINTERNAL.NAME"
msgid "Security Door"
msgstr "باب أمني"

msgctxt "STRINGS.BUILDINGS.PREFABS.POIFACILITYDOOR.EFFECT"
msgid ""
"Large double doors that were once the main entrance to a large facility."
msgstr "أبواب مزدوجة كبيرة كانت ذات يوم المدخل الرئيسي لمرفق كبير."

msgctxt "STRINGS.BUILDINGS.PREFABS.POIFACILITYDOOR.NAME"
msgid "Lobby Doors"
msgstr "أبواب اللوبي"

msgctxt "STRINGS.BUILDINGS.PREFABS.POLYMERIZER.DESC"
msgid "Plastic can be used to craft unique buildings and goods."
msgstr "يمكن استخدام البالستيك لصنع مبان ومنتجات فريدة."

msgctxt "STRINGS.BUILDINGS.PREFABS.POLYMERIZER.EFFECT"
msgid ""
"Converts <link=\"PLASTIFIABLELIQUID\">Plastic Monomers</link> into raw "
"<link=\"POLYPROPYLENE\">Plastic</link>."
msgstr ""
"يحول <link=\"PLASTIFIABLELIQUID\">المونومرات البالستيكية</link> إلى "
"<link=\"POLYPROPYLENE\">بالستيك</link> خام."

msgctxt "STRINGS.BUILDINGS.PREFABS.POLYMERIZER.NAME"
msgid "<link=\"POLYMERIZER\">Polymer Press</link>"
msgstr "<link=\"POLYMERIZER\">مكبس البوليمر</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.POWERCONTROLSTATION.DESC"
msgid "Only one Duplicant may be assigned to a station at a time."
msgstr "يمكن تعيين نسخة مكررة واحدة فقط في المحطة في وقت واحد."

msgctxt "STRINGS.BUILDINGS.PREFABS.POWERCONTROLSTATION.EFFECT"
msgid ""
"Produces <link=\"POWERSTATIONTOOLS\">Microchip</link> to increase the <link=\"POWER\">Power</link> output of generators.\n"
"\n"
"Assigned Duplicants must possess the <link=\"TECHNICALS2\">Tune Up</link> trait."
msgstr ""
"ينتج <link=\"POWERSTATIONTOOLS\">الدوائر الدقيقة</link> لزيادة <link=\"POWER\">قوة</link>يجب أن يمتلك النسخ المعينون صفة \n"
"\n"
" المولدات.<link=\"TECHNICALS2\">ضبط األداء</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.POWERCONTROLSTATION.NAME"
msgid "<link=\"POWERCONTROLSTATION\">Power Control Station</link>"
msgstr "<link=\"POWERCONTROLSTATION\">محطة التحكم بالطاقة</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMER.DESC"
msgid "It's a power transformer, but larger."
msgstr "إنه محول كهربائي، لكنه أكبر."

msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMER.EFFECT"
msgid ""
"Limits <link=\"POWER\">Power</link> flowing through the Transformer to 4 kW.\n"
"\n"
"Connect <link=\"BATTERY\">Batteries</link> on the large side to act as a valve and prevent <link=\"WIRE\">Wires</link> from drawing more than 4 kW.\n"
"\n"
"Can be rotated before construction."
msgstr ""
"يحد <link=\"POWER\">القدرة</link>قم بتوصيل \n"
"\n"
" المتدفقة عبر المحول إلى 4 كيلووات.<link=\"BATTERY\">البطاريات</link> على الجانب الكبير لتعمل كصمام وتمنع <link=\"WIRE\">األسالك</link>يمكن تدويره قبل التركيب.\n"
"\n"
" من سحب أكثر من 4 كيلووات."

msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMER.NAME"
msgid "<link=\"POWERTRANSFORMER\">Large Power Transformer</link>"
msgstr "<link=\"POWERTRANSFORMER\">محول طاقة كبير</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMERSMALL.DESC"
msgid ""
"Limiting the power drawn by wires prevents them from incurring overload "
"damage."
msgstr ""
"تحديد القدرة التي تسحبها األسالك يمنعها من التعرض ألضرار التحميل الزائد."

msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMERSMALL.EFFECT"
msgid ""
"Limits <link=\"POWER\">Power</link> flowing through the Transformer to 1000 W.\n"
"\n"
"Connect <link=\"BATTERY\">Batteries</link> on the large side to act as a valve and prevent <link=\"WIRE\">Wires</link> from drawing more than 1000 W.\n"
"\n"
"Can be rotated before construction."
msgstr ""
"يحد <link=\"POWER\">الطاقة</link>قم بتوصيل \n"
"\n"
" المتدفقة عبر المحول إلى 0001 واط.<link=\"BATTERY\">البطاريات</link> على الجانب الكبير لتعمل كصمام وتمنع <link=\"WIRE\">األسالك</link>يمكن تدويره قبل البناء.\n"
"\n"
" من سحب أكثر من 0001 واط."

msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMERSMALL.NAME"
msgid "<link=\"POWERTRANSFORMERSMALL\">Power Transformer</link>"
msgstr "<link=\"POWERTRANSFORMERSMALL\">محول طاقة</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSUREDOOR.DESC"
msgid ""
"Mechanized airlocks open and close more quickly than other types of door."
msgstr "األقفال الهوائية الميكانيكية تفتح وتغلق أسرع من أنواع األبواب األخرى."

msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSUREDOOR.EFFECT"
msgid ""
"Blocks <link=\"ELEMENTSLIQUID\">Liquid</link> and <link=\"ELEMENTSGAS\">Gas</link> flow, maintaining pressure between areas.\n"
"\n"
"Functions as a <link=\"MANUALPRESSUREDOOR\">Manual Airlock</link> when no <link=\"POWER\">Power</link> is available.\n"
"\n"
"Wild <link=\"CREATURES\">Critters</link> cannot pass through doors."
msgstr ""
"يمنع تدفق <link=\"ELEMENTSLIQUID\">السائل</link> و<link=\"ELEMENTSGAS\">الغاز</link>يعمل كـ \n"
"\n"
"، مع الحفاظ على الضغط بين المناطق.<link=\"MANUALPRESSUREDOOR\">باب هوائي يدوي</link> عندما ال تتوفر <link=\"POWER\">الطاقة</link>ال يمكن لكائنات \n"
"\n"
".<link=\"CREATURES\">البرية</link> المرور عبر األبواب."

msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSUREDOOR.NAME"
msgid "<link=\"PRESSUREDOOR\">Mechanized Airlock</link>"
msgstr "<link=\"PRESSUREDOOR\">باب هوائي ميكانيكي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHGAS.DESC"
msgid ""
"An atmo switch shuts off power when the air pressure surrounding it "
"surpasses the set threshold."
msgstr ""
"يقوم مفتاح الضغط الجوي بإيقاف تشغيل الكهرباء عندما يتجاوز ضغط الهواء المحيط "
"به الحد المعياري المحدد."

msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHGAS.EFFECT"
msgid ""
"Automatically turns <link=\"POWER\">Power</link> on or off using ambient <link=\"PRESSURE\">Gas Pressure</link> .\n"
"\n"
"Does not affect circuitry preceding the switch."
msgstr ""
"يقوم تلقائيا بتشغيل أو إيقاف <link=\"POWER\">الطاقة</link> باستخدام <link=\"PRESSURE\">ضغط الغاز</link>ال يؤثر على الدوائر الكهربائية التي تسبق المفتاح.\n"
"\n"
" المحيط."

msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHGAS.NAME"
msgid "<link=\"PRESSURESWITCHGAS\">Atmo Switch</link>"
msgstr "<link=\"PRESSURESWITCHGAS\">مفتاح الضغط الجوي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHLIQUID.DESC"
msgid ""
"A hydro switch shuts off power when the liquid pressure surrounding it "
"surpasses the set threshold."
msgstr ""
"يقوم المفتاح الهيدروليكي بقطع التيار الكهربائي عندما يتجاوز ضغط السائل "
"المحيط به الحد المحدد."

msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHLIQUID.EFFECT"
msgid ""
"Automatically turns <link=\"POWER\">Power</link> on or off using ambient <link=\"PRESSURE\">Liquid Pressure</link>.\n"
"\n"
"Does not affect circuitry preceding the switch.\n"
"\n"
"Must be submerged in <link=\"ELEMENTSLIQUID\">Liquid</link>."
msgstr ""
"يقوم تلقائيا بتشغيل أو إيقاف <link=\"POWER\">الطاقة</link> باستخدام <link=\"PRESSURE\">ضغط السائل</link>يجب غمره في \n"
"\n"
"ال يؤثر على الدوائر الكهربائية الموجودة قبل المفتاح.\n"
"\n"
" المحيط.<link=\"ELEMENTSLIQUID\">السائل</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHLIQUID.NAME"
msgid "<link=\"PRESSURESWITCHLIQUID\">Hydro Switch</link>"
msgstr "<link=\"PRESSURESWITCHLIQUID\">مفتاح الضغط الهيدروليكي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERA.DESC"
msgid ""
"A poster promoting a local tourist attraction.\n"
"\n"
"Actual scenery may vary."
msgstr ""
"قد تختلف المشاهد الفعلية.\n"
"ملصق يروج لمعلم سياحي محلي."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERA.NAME"
msgid "Travel Poster"
msgstr "ملصق السفر"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERB.DESC"
msgid ""
"A poster promoting local wildlife.\n"
"\n"
"The first in an unfinished series."
msgstr ""
"األول في سلسلة غير مكتملة.\n"
"\n"
"ملصق يروج للحياة البرية المحلية."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERB.NAME"
msgid "Travel Poster"
msgstr "ملصق السفر"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERLARGE.DESC"
msgid ""
"A sound-absorbing panel that makes small-space living more bearable.\n"
"\n"
"The artwork features a  power source."
msgstr ""
"تظهر اللوحة مصدر طاقة.\n"
"\n"
"لوح ماص للصوت يجعل العيش في المساحات الصغيرة أكثر احتماال."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERLARGE.NAME"
msgid "Acoustic Art Panel"
msgstr "لوحة فنية صوتية"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCLOCK.DESC"
msgid ""
"A simple wall clock.\n"
"\n"
"It is no longer ticking."
msgstr ""
"لم تعد تدق.\n"
"\n"
"ساعة حائط بسيطة."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCLOCK.NAME"
msgid "Clock"
msgstr "ساعة"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCLOTHESHANGER.DESC"
msgid ""
"Holds one <link=\"WARMVEST\">Warm Coat</link>.\n"
"\n"
"It'd be silly not to use it."
msgstr ""
"يمسك بمعطف دافئ واحد <link=\"WARMVEST\">معطف دافئ</link>سيكون من الغباء عدم استخدامه.\n"
"."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCLOTHESHANGER.NAME"
msgid "Coat Rack"
msgstr "حامل المعاطف"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDESK.DESC"
msgid ""
"An intact office desk, decorated with several personal belongings and a "
"barely functioning computer."
msgstr "مكتب مكتبي سليم، مزين بعدة متعلقات شخصية وجهاز كمبيوتر بالكاد يعمل."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDESK.NAME"
msgid "Computer Desk"
msgstr "مكتب كمبيوتر"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDLC2DISPLAY1.DESC"
msgid ""
"An electronic display projecting the blueprint of an engineering project.\n"
"\n"
"It looks like a pump of some kind."
msgstr ""
"يبدو وكأنه مضخة من نوع ما.\n"
"\n"
"شاشة إلكترونية تعرض مخطط مشروع هندسي. "

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDLC2DISPLAY1.NAME"
msgid "Electronic Display"
msgstr "شاشة إلكترونية"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDLC2GEOTHERMALCART.DESC"
msgid ""
"Maintenance equipment that once flushed debris out of complex mechanisms.\n"
"\n"
"One of the wheels is squeaky."
msgstr ""
"إحدى العجالت تصدر صوت صرير.\n"
"\n"
"معدات الصيانة التي كانت تطرد الحطام من اآلليات المعقدة."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDLC2GEOTHERMALCART.NAME"
msgid "Service Cart"
msgstr "عربة الخدمة"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPELEVATOR.DESC"
msgid ""
"Out of service.\n"
"\n"
"The buttons inside indicate it went down more than a dozen floors at one point in time."
msgstr ""
"تشير األزرار الموجودة بالداخل إلى أنه هبط أكثر من اثني عشر طابقا في وقت ما.\n"
"\n"
"خارج الخدمة."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPELEVATOR.NAME"
msgid "Broken Elevator"
msgstr "مصعد معطل"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSETLOCKER.DESC"
msgid ""
"A locker made with ultra-lightweight textiles.\n"
"\n"
"It contains an assortment of personal effects."
msgstr ""
"خزانة مصنوعة من األقمشة فائقة الخفة. تحتوي على مجموعة من المتعلقات الشخصية."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSETLOCKER.NAME"
msgid "Off-site Locker"
msgstr "خزانة خارج الموقع"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSHELFLONG.DESC"
msgid ""
"A shelf made out of flat-packed pieces that can be assembled in various ways.\n"
"\n"
"This is the long way."
msgstr ""
"هذا هو الطريق الطويل.\n"
"\n"
"رف مصنوع من قطع مسطحة يمكن تجميعها بطرق مختلفة."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSHELFLONG.NAME"
msgid "Long Prefab Shelf"
msgstr "رف جاهز طويل"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSHELSHORT.DESC"
msgid ""
"A shelf made out of flat-packed pieces that can be assembled in various ways.\n"
"\n"
"It looks nice, actually."
msgstr ""
"في الواقع، يبدو جميال.\n"
"رف مصنوع من قطع مسطحة يمكن تجميعها بطرق مختلفة."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSHELSHORT.NAME"
msgid "Prefab Shelf"
msgstr "رف جاهز"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHAIR.DESC"
msgid "A chair where visitors can comfortably wait before their appointments."
msgstr "كرسي يمكن للزوار االنتظار على راحته قبل مواعيدهم."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHAIR.NAME"
msgid "Lobby Chair"
msgstr "كرسي اللوبي"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHANDELIER.DESC"
msgid ""
"A large chandelier that hangs from the ceiling.\n"
"\n"
"It does not appear to function."
msgstr ""
"ال يبدو أنها تعمل.\n"
"\n"
"ثريا كبيرة تتدلى من السقف. "

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHANDELIER.NAME"
msgid "Chandelier"
msgstr "ثريا"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCOUCH.DESC"
msgid "A couch where visitors can comfortably wait before their appointments."
msgstr "أريكة يمكن للزوار الجلوس عليها براحة قبل مواعيدهم."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCOUCH.NAME"
msgid "Lobby Couch"
msgstr "أريكة الردهة"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDESK.DESC"
msgid ""
"A spotless desk filled with impeccably organized office supplies.\n"
"\n"
"A photo peeks out from beneath the desk pad, depicting two beaming young women in caps and gowns.\n"
"\n"
"The photo is quite old."
msgstr ""
"الصورة قديمة جدا.\n"
"\n"
"تظهر صورة من تحت وسادة المكتب، تصور امرأتين شابتين مبتسمتين مرتديتين قبعات وأردية التخرج.\n"
"\n"
"سطح مكتب نظيف ممتلئ باللوازم المكتبية المنظمة بشكل ال تشوبه شائبة."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDESK.NAME"
msgid "Director's Desk"
msgstr "مكتب المدير"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY1.DESC"
msgid ""
"An electronic display projecting the blueprint of a familiar device.\n"
"\n"
"It looks like a Printing Pod."
msgstr ""
"يبدو وكأنه وحدة طباعة.\n"
"شاشة إلكترونية تعرض مخطط جهاز مألوف."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY1.NAME"
msgid "Electronic Display"
msgstr "شاشة إلكترونية"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY2.DESC"
msgid ""
"An electronic display projecting the blueprint of a familiar device.\n"
"\n"
"It looks like a Mining Gun."
msgstr ""
"يبدو وكأنه بندقية تعدين.\n"
"\n"
"شاشة إلكترونية تعرض مخطط جهاز مألوف."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY2.NAME"
msgid "Electronic Display"
msgstr "شاشة إلكترونية"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY3.DESC"
msgid ""
"An electronic display projecting the blueprint of a strange device.\n"
"\n"
"Perhaps these displays were used to entice visitors."
msgstr ""
"شاشة إلكترونية تعرض مخطط جهاز غريب. ربما كانت هذه الشاشات تستخدم لجذب "
"الزوار."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY3.NAME"
msgid "Electronic Display"
msgstr "شاشة إلكترونية"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYGLOBEDROORS.DESC"
msgid ""
"A filing cabinet for storing hard copy employee records.\n"
"\n"
"The contents have been shredded."
msgstr "خزانة ملفات لتخزين نسخ ورقية من سجالت الموظفين. تم تمزيق المحتويات."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYGLOBEDROORS.NAME"
msgid "Filing Cabinet"
msgstr "خزانة ملفات"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYLAMP.DESC"
msgid ""
"A long light fixture that hangs from the ceiling.\n"
"\n"
"It does not appear to function."
msgstr ""
"يبدو أنه ال يعمل.\n"
"تركيب إضاءة طويل معلق من السقف. "

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYLAMP.NAME"
msgid "Light Fixture"
msgstr "تركيبة اإلضاءة"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYPAINTING.DESC"
msgid ""
"A painting featuring a copse of fir trees and a magnificent mountain range on the horizon.\n"
"\n"
"The air in the room prickles with the sensation that I'm not meant to be here."
msgstr ""
"الجو في الغرفة يبعث على الوخز باإلحساس بأنني لست من المفترض أن أكون هنا.\n"
"\n"
"لوحة تظهر مجموعة من أشجار التنوب وسلسلة جبال رائعة على األفق."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYPAINTING.NAME"
msgid "Landscape Portrait"
msgstr "منظر طبيعي عمودي"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYSTATUE.DESC"
msgid ""
"A large, modern sculpture that sits in the center of the lobby.\n"
"\n"
"It's an artistic cross between an hourglass shape and a double helix."
msgstr ""
"إنه مزيج فني بين شكل الساعة الرملية واللولب المزدوج.\n"
"\n"
"تمثال كبير وحديث يقع في وسط البهو."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYSTATUE.NAME"
msgid "Gravitas Monument"
msgstr "نصب جرافتاس"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYTABLE.DESC"
msgid "A low coffee table that may have once held old science magazines."
msgstr "طاولة قهوة منخفضة قد تكون كانت تحمل مجالت علمية قديمة في السابق."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYTABLE.NAME"
msgid "Coffee Table"
msgstr "طاولة قهوة"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYTALLPLANT.DESC"
msgid "It's survived the vacuum of space by virtue of being plastic."
msgstr "لقد نجت في فراغ الفضاء بفضل كونها مصنوعة من البالستيك."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYTALLPLANT.NAME"
msgid "Office Plant"
msgstr "نبتة مكتبية"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYWALLDEGREE.DESC"
msgid ""
"Certification in Applied Physics, awarded in recognition of one \"Jacquelyn "
"A. Stern\"."
msgstr "شهادة في الفيزياء التطبيقية، منحت تكريما لـ 'جاكلين أ. ستيرن'."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYWALLDEGREE.NAME"
msgid "Doctorate Degree"
msgstr "درجة الدكتوراه"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMMIRROR.DESC"
msgid ""
"A one-way mirror and shelf.\n"
"\n"
"The skincare products still smell faintly of shea butter."
msgstr ""
"منتجات العناية بالبشرة ال تزال تفوح منها رائحة زبدة الشيا بشكل خافت.\n"
"\n"
"مرآة أحادية االتجاه ورف."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMMIRROR.NAME"
msgid "Mirror"
msgstr "مرآة"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMSINK.DESC"
msgid ""
"A handwashing station that looks suspiciously under-utilized.\n"
"\n"
"It was once part of a bulk office order."
msgstr ""
"كانت في وقت ما جزءا من طلبية جملة للمكتب.\n"
"\n"
"محطة لغسل اليدين تبدو غير مستخدمة بشكل مريب."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMSINK.NAME"
msgid "Enamel Sink"
msgstr "حوض مينا"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMTOILETPAPERHOLDER.DESC"
msgid ""
"It holds one roll of sanitary paper.\n"
"\n"
"The sheets are single-ply."
msgstr "يحتوي على بكرة واحدة من ورق الحمام. األوراق مفردة الطبقة."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMTOILETPAPERHOLDER.NAME"
msgid "Toilet Paper Holder"
msgstr "حامل ورق التواليت"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCEILINGLIGHT.DESC"
msgid ""
"A flush mount ceiling light that no longer functions.\n"
"\n"
"There's dust inside."
msgstr "ضوء سقفي من النوع المسطح لم يعد يعمل. هناك غبار بالداخل."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCEILINGLIGHT.NAME"
msgid "Light Fixture"
msgstr "تركيبة اإلضاءة"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCEILINGROBOT.DESC"
msgid "Non-functioning robotic arms that once assisted lab technicians."
msgstr "أذرع روبوتية غير عاملة كانت تساعد الفنيين في المختبر سابقا."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCEILINGROBOT.NAME"
msgid "Ceiling Robot"
msgstr "روبوت السقف"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCLOCKSQUARE.DESC"
msgid ""
"A square wall clock.\n"
"\n"
"It's quite damaged."
msgstr ""
"إنها تالفة إلى حد كبير.\n"
"\n"
"ساعة حائط مربعة."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCLOCKSQUARE.NAME"
msgid "Clock"
msgstr "ساعة"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCREATUREPOSTER.DESC"
msgid ""
"An anatomical illustration of the very first <link=\"HATCH\">Hatch</link> ever produced.\n"
"\n"
"While the ratio of egg sac to brain may appear outlandish, it is in fact to scale."
msgstr ""
"رسم توضيحي تشريحي ألول <link=\"HATCH\">هتش</link>بينما قد يبدو أن نسبة كيس البيض إلى الدماغ غير معقولة، إال أنها في الواقع وفقا للمقياس.\n"
"\n"
" تم إنتاجه على اإلطالق."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCREATUREPOSTER.NAME"
msgid "Anatomy Poster"
msgstr "ملصق التشريح"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDECORATIVEWINDOW.DESC"
msgid "A tall, thin window which once pointed to a courtyard."
msgstr "نافذة طويلة ونحيلة كانت في السابق تطل على فناء."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDECORATIVEWINDOW.NAME"
msgid "Window"
msgstr "نافذة"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDESK.DESC"
msgid ""
"The unkempt workspace of a long-departed scientist who expected to return."
msgstr "مكان العمل المهمل لعالم رحل منذ زمن وكان يتوقع العودة."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDESK.NAME"
msgid "Biophysics Research Desk"
msgstr "مكتب أبحاث الفيزياء الحيوية"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDESKPODIUM.DESC"
msgid ""
"A clutter-proof desk to minimize distractions.\n"
"\n"
"There appears to be something stored in the computer."
msgstr ""
"يبدو أن هناك شيائ مخزنا في الكمبيوتر.\n"
"\n"
"مكتب خال من الفوضى لتقليل االنحرافات."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDESKPODIUM.NAME"
msgid "Computer Podium"
msgstr "منصة كمبيوتر"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDISPLAY4.DESC"
msgid ""
"An electronic display projecting the blueprint of a robotic device.\n"
"\n"
"It looks like a ceiling robot."
msgstr ""
"يبدو وكأنه روبوت سقفي.\n"
"\n"
"شاشة إلكترونية تعرض مخطط جهاز روبوتي."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDISPLAY4.NAME"
msgid "Electronic Display"
msgstr "شاشة إلكترونية"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFIREEXTINGUISHER.DESC"
msgid ""
"Essential lab equipment.\n"
"\n"
"The inspection tag indicates it has long expired."
msgstr ""
"تشير بطاقة الفحص إلى أنها قد انتهت صالحيتها منذ وقت طويل.\n"
"معدات مختبر أساسية."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFIREEXTINGUISHER.NAME"
msgid "Broken Fire Extinguisher"
msgstr "طفاية حريق مكسورة"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFIRSTAIDKIT.DESC"
msgid "It looks like it's been used a lot."
msgstr "يبدو أنه قد استخدم كثيرا."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFIRSTAIDKIT.NAME"
msgid "First Aid Kit"
msgstr "حقيبة إسعافات أولية"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFLIPPHONE.DESC"
msgid ""
"An outdated phone left behind by a distracted lab technician.\n"
"\n"
"It doesn't work."
msgstr ""
"ال يعمل.\n"
"هاتف قديم تركه فني مختبر مشتت. "

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFLIPPHONE.NAME"
msgid "Flip Phone"
msgstr "هاتف قابل للطي"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFLOORROBOT.DESC"
msgid "The grasping robotic claw designed to assist technicians in a lab."
msgstr "المخلب الروبوتي القابل لإلمساك المصمم لمساعدة الفنيين في المختبر."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFLOORROBOT.NAME"
msgid "Robotic Arm"
msgstr "الذراع اآللي"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFRIDGE.DESC"
msgid ""
"A non-functional cold storage unit full of expired samples.\n"
"\n"
"It was originally someone's home appliance."
msgstr ""
"كانت في األصل جهازا منزليا لشخص ما.\n"
"\n"
"وحدة تخزين باردة غير عاملة مليئة بالعينات المنتهية الصالحية."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFRIDGE.NAME"
msgid "Mini Fridge"
msgstr "ثالجة صغيرة"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASHANDSCANNER.DESC"
msgid ""
"A sophisticated security device.\n"
"\n"
"It appears to use a method other than fingerprints to verify an individual's identity."
msgstr ""
"يبدو أنه يستخدم طريقة غير بصمات األصابع للتحقق من هوية الفرد.\n"
"\n"
"جهاز أمني متطور."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASHANDSCANNER.NAME"
msgid "Hand Scanner"
msgstr "ماسح اليد"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR1.DESC"
msgid ""
"An abnormally large brain floating in embalming liquid to prevent "
"decomposition."
msgstr "دماغ كبير بشكل غير طبيعي يطفو في سائل التحنيط لمنع التحلل."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR1.NAME"
msgid "Big Brain Jar"
msgstr "جرة الدماغ الكبير"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR2.DESC"
msgid "The corpse of a proto-hatch creature meticulously preserved in a jar."
msgstr "جثة مخلوق أولي الفقس محفوظة بعناية في جرة."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR2.NAME"
msgid "Sample Jar"
msgstr "وعاء عينة"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABTABLE.DESC"
msgid ""
"The quaint research desk of a departed lab technician.\n"
"\n"
"Perhaps the computer stores something of interest."
msgstr ""
"مكتب البحث العتيق لفني المختبر المتوفى. ربما يخزن الحاسوب شيائ محل اهتمام."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABTABLE.NAME"
msgid "Lab Desk"
msgstr "مكتب المختبر"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWALL.EFFECT"
msgid "A regular wall that once existed in a working lab."
msgstr "جدار عادي كان موجودا في مختبر عامال."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWALL.NAME"
msgid "Lab Wall"
msgstr "جدار المختبر"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWINDOW.EFFECT"
msgid "A lab window. Formerly a portal to the outside world."
msgstr "نافذة مختبر. كانت في السابق بوابة إلى العالم الخارجي."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWINDOW.NAME"
msgid "Lab Window"
msgstr "نافذة المختبر"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWINDOWHORIZONTAL.EFFECT"
msgid ""
"A lab window.\n"
"\n"
"Someone once stared out of this, contemplating the results of an experiment."
msgstr ""
"ذات مرة، نظر شخص ما من خاللها، متأمال نتائج تجربة.\n"
"\n"
"نافذة مختبر."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWINDOWHORIZONTAL.NAME"
msgid "Lab Window"
msgstr "نافذة المختبر"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASPAPERTOLELDISPENSER.DESC"
msgid ""
"It once dispensed paper made from 100% post-consumer recycled content.\n"
"\n"
"The remaining sheet is jammed."
msgstr ""
"الورقة المتبقية عالقة.\n"
"\n"
"كان يوزع سابقا ورقا مصنوعا من محتوى معاد تدويره بنسبة 001% بعد استهالكه."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASPAPERTOLELDISPENSER.NAME"
msgid "Paper Towel Dispenser"
msgstr "موزع مناشف ورقية"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASPOSTERPLANTS.DESC"
msgid ""
"A handy reference text with illustrations.\n"
"\n"
"It details the genetic makeup of proprietary botanicals."
msgstr ""
"يوضح التركيب الجيني للنباتات الملكية.\n"
"نص مرجعي مفيد مصحوب بالرسوم التوضيحية. "

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASPOSTERPLANTS.NAME"
msgid "Wall Chart"
msgstr "مخطط جداري"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASPOSTERSEED.DESC"
msgid ""
"A handy reference text with illustrations.\n"
"\n"
"It compares the genetic makeup of select organisms."
msgstr ""
"يقارن التركيب الجيني للكائنات المختارة.\n"
"نص مرجعي مفيد مع رسوم توضيحية. "

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASPOSTERSEED.NAME"
msgid "Wall Chart"
msgstr "مخطط جداري"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASPOTPLANTDEAD.DESC"
msgid ""
"A very dead plant.\n"
"\n"
"It's a wonder it hasn't crumbled into nothingness."
msgstr ""
"من العجيب أنها لم تتفكك إلى العدم.\n"
"\n"
"نبتة ميتة جدا."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASPOTPLANTDEAD.NAME"
msgid "Dead Plant"
msgstr "نبات ميت"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASROBTICTABLE.DESC"
msgid ""
"The work space of an extinct robotics technician who left behind some "
"unfinished prototypes."
msgstr ""
"مساحة عمل فني الروبوتات المنقرض الذي ترك وراءه بعض النماذج األولية غير "
"المكتملة."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASROBTICTABLE.NAME"
msgid "Robotics Research Desk"
msgstr "مكتب أبحاث الروبوتات"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASSHELF.DESC"
msgid "A shelf holding jars just out of reach for a short person."
msgstr "رف يحمل أواني الزجاج على ارتفاع يفوق متناول الشخص القصير."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASSHELF.NAME"
msgid "Shelf"
msgstr "رف"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASSMALLSEEDLOCKER.DESC"
msgid ""
"A small glass cabinet.\n"
"\n"
"There's a biohazard symbol on it."
msgstr ""
"يوجد عليها رمز خطر بيولوجي.\n"
"خزانة زجاجية صغيرة."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASSMALLSEEDLOCKER.NAME"
msgid "Wall Cabinet"
msgstr "خزانة حائط"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASTOOLCRATE.DESC"
msgid ""
"A packing crate intended for safety equipment.\n"
"\n"
"It has been repurposed for tool storage."
msgstr ""
"تم إعادة استخدامه لتخزين األدوات.\n"
"صندوق تعبئة مخصص لمعدات السالمة. "

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASTOOLCRATE.NAME"
msgid "Tool Crate"
msgstr "صندوق األدوات"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASTOOLSHELF.DESC"
msgid ""
"A wall-mounted rack for storing and displaying useful tools at a not-so-"
"useful height."
msgstr ""
"رف مثبت على الجدار لتخزين وعرض األدوات المفيدة على ارتفاع ليس مفيدا جدا."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASTOOLSHELF.NAME"
msgid "Tool Rack"
msgstr "رف األدوات"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASTRASHCAN.DESC"
msgid ""
"A wall-mounted garbage receptacle.\n"
"\n"
"The lid does not close."
msgstr ""
"الغطاء ال يغلق.\n"
"\n"
"حاوية نفايات مثبتة على الحائط."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASTRASHCAN.NAME"
msgid "Trash Can"
msgstr "سلة المهمالت"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASWALL.EFFECT"
msgid "The wall of a once-great scientific facility."
msgstr "جدار منشأة علمية كانت عظيمة في السابق."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASWALL.NAME"
msgid "Wall"
msgstr "جدار"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASWALLPURPLE.EFFECT"
msgid "The wall of an ambitious research and development department."
msgstr "جدار قسم البحث والتطوير الطموح."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASWALLPURPLE.NAME"
msgid "Wall"
msgstr "جدار"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASWALLPURPLEWHITEDIAGONAL.EFFECT"
msgid "The wall of an ambitious research and development department."
msgstr "جدار قسم البحث والتطوير الطموح."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASWALLPURPLEWHITEDIAGONAL.NAME"
msgid "Wall"
msgstr "جدار"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPHUMANCHESTERFIELDCHAIR.DESC"
msgid ""
"A luxurious chair where future generations can comfortably sit and dream of "
"home."
msgstr "كرسي فاخر يمكن لألجيال القادمة الجلوس فيه بشكل مريح وحلم بالمنزل."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPHUMANCHESTERFIELDCHAIR.NAME"
msgid "Showroom Chair"
msgstr "كرسي صالة العرض"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPHUMANCHESTERFIELDSOFA.DESC"
msgid ""
"A luxurious couch where potential residents can comfortably nap and dream of"
" home."
msgstr "أريكة فاخرة حيث يمكن للمقيمين المحتملين النوم بشكل مريح وحلم بالمنزل."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPHUMANCHESTERFIELDSOFA.NAME"
msgid "Showroom Couch"
msgstr "أريكة المعرض"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPHUMANMURPHYBED.DESC"
msgid ""
"A bed that folds into the wall, for small live/work spaces.\n"
"\n"
"This is the display model."
msgstr ""
"هذا هو نموذج العرض.\n"
"\n"
"سرير يطوى داخل الحائط، للمساحات الصغيرة للمعيشة/العمل."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPHUMANMURPHYBED.NAME"
msgid "Murphy Bed"
msgstr "سرير ميرفي"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPLADDER.DESC"
msgid "A hard plastic ladder."
msgstr "سلم من البالستيك الصلب."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPLADDER.NAME"
msgid "Ladder"
msgstr "سلم"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPLIGHT.DESC"
msgid "An elegant ceiling lamp, slightly worse for wear."
msgstr "مصباح سقفي أنيق، متضرر بعض الشيء."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPLIGHT.NAME"
msgid "Light Fixture"
msgstr "تركيبة اإلضاءة"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPRECEPTIONDESK.DESC"
msgid ""
"A full coffee cup and a note abandoned mid sentence sit behind the desk.\n"
"\n"
"It gives me an eerie feeling, as if the receptionist has stepped out and will return any moment."
msgstr ""
"يمنحني شعورا غريبا، كما لو أن موظف االستقبال قد خرج وسيعود في أي لحظة.\n"
"\n"
"فنجان قهوة ممتلئ ومذكرة مهجورة في منتصف الجملة تجلس خلف المكتب."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPRECEPTIONDESK.NAME"
msgid "Reception Desk"
msgstr "مكتب االستقبال"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPSKELETON.DESC"
msgid ""
"A detailed anatomical model.\n"
"\n"
"It appears to be made of resin."
msgstr ""
"يبدو أنه مصنوع من الراتنج.\n"
"نموذج تشريحي مفصل."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPSKELETON.NAME"
msgid "Model Skeleton"
msgstr "هيكل عظمي نموذجي"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPSURFACESATELLITE1.DESC"
msgid "All that remains of a once peacefully orbiting satellite."
msgstr "كل ما تبقى من قمر صناعي كان يدور بسالم."

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPSURFACESATELLITE1.NAME"
msgid "Crashed Satellite"
msgstr "قمري اصطدم"

msgctxt "STRINGS.BUILDINGS.PREFABS.PROPSURFACESATELLITE2.DESC"
