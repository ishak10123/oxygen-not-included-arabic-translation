msgid "<link=\"VINEMOTHER\">Ovagro Node</link>"
msgstr "<link=\"VINEMOTHER\">عقدة أوفاجرو</link>"

msgctxt "STRINGS.CREATURES.SPECIES.WINECUPS.DESC"
