msgid "<link=\"BUTTERFLY\">Mimika</link>"
msgstr "<link=\"BUTTERFLY\">ميميكا</link>"

msgctxt "STRINGS.CREATURES.SPECIES.BUTTERFLYPLANT.DESC"
msgid ""
"Mimika Buds are self-harvesting plants that produce airborne <link=\"BUTTERFLY\">Mimikas</link>.\n"
"\n"
"<link=\"BUTTERFLY\">Mimikas</link> boost growth for nearby <link=\"PLANTS\">Plants</link> before hardening into <link=\"BUTTERFLYPLANTSEED\">Mimillet</link>."
msgstr ""
"أزهار ميميكا هي نباتات تقوم بالحصد الذاتي وتنتج <link=\"BUTTERFLY\">ميميكاس</link>\n"
"\n"
" المحمولة جوا.<link=\"BUTTERFLY\">ميميكاس</link> تعزز النمو للنباتات <link=\"PLANTS\">القريبة</link> قبل أن تتصلب إلى <link=\"BUTTERFLYPLANTSEED\">ميميليت</link>."

msgctxt "STRINGS.CREATURES.SPECIES.BUTTERFLYPLANT.DOMESTICATEDDESC"
msgid "This plant produces <link=\"BUTTERFLY\">Mimikas</link>."
msgstr "هذا النبات ينتج <link=\"BUTTERFLY\">ميميكاس</link>."

