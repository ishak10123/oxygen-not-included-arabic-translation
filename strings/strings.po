msgctxt "STRINGS.MISC.TAGS.COMPOSTABLE"
msgid "<link=\"COMPOSTABLE\">Compostable</link>"
msgstr "<link=\"COMPOSTABLE\">قابل للتحلل العضوي</link>"

msgctxt "STRINGS.MISC.TAGS.COMPOSTABLE_DESC"
msgid ""
"Compostables are biological materials which can be put into a <link=\"COMPOST\">Compost</link> to generate clean <link=\"DIRT\">Dirt</link>.\n"
"\n"
"Composting also generates a small amount of <link=\"HEAT\">Heat</link>.\n"
"\n"
"Once it starts to rot, consumable food should be composted to prevent <link=\"FOODPOISONING\">Food Poisoning</link>."
msgstr ""
"المواد القابلة للتحلل هي مواد حيوية يمكن وضعها في <link=\"COMPOST\">السماد</link> إلنتاج <link=\"DIRT\">التربة</link>كما أن عملية التسميد تولد كمية صغيرة من \n"
"\n"
" النظيفة.<link=\"HEAT\">الحرارة</link>بمجرد أن تبدأ في التعفن، يجب تسميد الطعام القابل لألكل لمنع \n"
"\n"
".<link=\"FOODPOISONING\">تسمم الطعام</link>."

