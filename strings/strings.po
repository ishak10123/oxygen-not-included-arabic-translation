msgstr "<link=\"SQUIRREL\">عانق بيبسكووك</link>"

msgctxt "STRINGS.CREATURES.SPECIES.SQUIRREL.VARIANT_HUG.DESC"
msgid ""
"Cuddle Pips are fluffy, affectionate critters who exhibit a strong snuggling instinct towards all types of eggs.\n"
"\n"
"This is temporarily amplified when they are hugged by a passing Duplicant."
msgstr ""
"ببساطة، spiP المزكرة لطيفة ووفية، وتظهر غريزة قوية للعناق تجاه جميع أنواع "
"البيض. هذا األمر يتضاعف مؤقتا عندما يتم احتضانها من قبل نسخة مماثلة عابرة."

