msgid ""
"Extracts <link=\"ENRICHEDURANIUM\">Enriched Uranium</link> from <link=\"URANIUMORE\">Uranium Ore</link>.\n"
"\n"
"Outputs <link=\"DEPLETEDURANIUM\">Depleted Uranium</link> in molten form."
msgstr ""
" ﺝﺮﺨﺘﺴﻳ<link=\"ENRICHEDURANIUM\">ﺐﺼﺨﻤﻟﺍ ﻡﻮﻴﻧﺍﺭﻮﻴﻟﺍ</link> ﻦﻣ <link=\"URANIUMORE\">ﻡﻮﻴﻧﺍﺭﻮﻴﻟﺍ ﺔﻣﺎﺧ</link>.\n"
"\n"
" ﺞﺘﻨﻳ<link=\"DEPLETEDURANIUM\">ﺪﻔﻨﺘﺴﻤﻟﺍ ﻡﻮﻴﻧﺍﺭﻮﻴﻟﺍ</link>.ﺭﻮﻬﺼﻣ ﻞﻜﺷ ﻲﻓ "

