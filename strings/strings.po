msgctxt "STRINGS.MISC.TAGS.COMBUSTIBLEGAS"
msgid "<link=\"COMBUSTIBLEGAS\">Combustible Gas</link>"
msgstr "<link=\"COMBUSTIBLEGAS\">غاز قابل لالشتعال</link>"

msgctxt "STRINGS.MISC.TAGS.COMBUSTIBLEGAS_DESC"
msgid ""
"Combustible Gases can be burned as fuel to be used in the production of "
"<link=\"POWER\">Power</link> and <link=\"FOOD\">Food</link>."
msgstr ""
"يمكن حرق الغازات القابلة لالشتعال كوقود الستخدامها في إنتاج "
"<link=\"POWER\">الطاقة</link> و <link=\"FOOD\">الغذاء</link>."

msgctxt "STRINGS.MISC.TAGS.COMBUSTIBLELIQUID"
msgid "<link=\"COMBUSTIBLELIQUID\">Combustible Liquid</link>"
msgstr "<link=\"COMBUSTIBLELIQUID\">سائل قابل لالحتراق</link>"

msgctxt "STRINGS.MISC.TAGS.COMBUSTIBLELIQUID_DESC"
msgid ""
"Combustible Liquids can be burned as fuels to be used in energy production, such as in a <link=\"PETROLEUMGENERATOR\">Petroleum Generator</link> or a <link=\"KEROSENEENGINECLUSTER\">Petroleum Engine</link>.\n"
"\n"
"Though these liquids have other uses, such as fertilizer for growing a <link=\"BEANPLANTSEED\">Nosh Bean</link>, their primary usefulness lies in their ability to be burned for <link=\"POWER\">Power</link>."
msgstr ""
"يمكن حرق السوائل القابلة لالشتعال كوقود الستخدامها في إنتاج الطاقة، مثل <link=\"PETROLEUMGENERATOR\">مولد البترول</link> أو <link=\"KEROSENEENGINECLUSTER\">محرك البترول</link>على الرغم من أن لهذه السوائل استخدامات أخرى، مثل األسمدة لزراعة \n"
"\n"
".<link=\"BEANPLANTSEED\">حبوب النوش</link>، فإن فائدتها األساسية تكمن في قدرتها على االحتراق لتوليد <link=\"POWER\">الطاقة</link>."

msgctxt "STRINGS.MISC.TAGS.COMBUSTIBLESOLID"
msgid "<link=\"COMBUSTIBLESOLID\">Combustible Solid</link>"
msgstr "<link=\"COMBUSTIBLESOLID\">صلب قابل لالحتراق</link>"

msgctxt "STRINGS.MISC.TAGS.COMBUSTIBLESOLID_DESC"
msgid ""
"Combustible Solids can be burned as fuel to be used in "
"<link=\"POWER\">Power</link> production."
msgstr ""
"يمكن حرق المواد الصلبة القابلة لالشتعال كوقود الستخدامها في إنتاج "
"<link=\"POWER\">الطاقة</link>."

