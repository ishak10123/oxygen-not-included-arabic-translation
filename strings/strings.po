msgctxt "STRINGS.BUILDINGS.PREFABS.MISSILEFABRICATOR.DESC"
msgid ""
"Blastshot shells are an effective defense against incoming meteor showers."
msgstr "قذائف بالستشوت هي دفاع فعال ضد الشهب القادمة."

msgctxt "STRINGS.BUILDINGS.PREFABS.MISSILEFABRICATOR.EFFECT"
