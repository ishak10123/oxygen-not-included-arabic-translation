msgstr "دمر roilomeD قبل أن يصل: {0{/}1}"

msgctxt "STRINGS.COLONY_ACHIEVEMENTS.ASTEROID_DESTROYED.REQUIREMENT_NAME"
msgid "Destroy Demolior asteroid"
msgstr "دمر كويكب ديموليور"

msgctxt "STRINGS.COLONY_ACHIEVEMENTS.ASTEROID_SURVIVED.DESCRIPTION"
msgid ""
"Survive 100 cycles after Demolior asteroid collides with "
"RelicAAAA<sup>AAAGHH</sup>."
msgstr ""
"البقاء على قيد الحياة لمدة 001 دورة بعد اصطدام كويكب ديموليور باآلثار "
"AAAA<sup>HHGAAA</sup>."

msgctxt "STRINGS.COLONY_ACHIEVEMENTS.ASTEROID_SURVIVED.NAME"
msgid "The Lab: Life Found A Way"
msgstr "المختبر: الحياة وجدت طريقة"

msgctxt ""
"STRINGS.COLONY_ACHIEVEMENTS.ASTEROID_SURVIVED.REQUIREMENT_DESCRIPTION"
msgid "Survived {0}/{1} cycles after Demolior impact"
msgstr "نجا {0{/}1} دورة بعد تأثير roilomeD"

msgctxt "STRINGS.COLONY_ACHIEVEMENTS.ASTEROID_SURVIVED.REQUIREMENT_NAME"
