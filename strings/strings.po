msgstr "وعاء نبات أزرق عصري للنباتات أثناء التنقل."

msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_DREAMY.NAME"
msgid "<link=\"FLOWERVASE\">Dreamy Retro Flower Pot</link>"
msgstr "<link=\"FLOWERVASE\">وعاء زهور رجعي حالمي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_ELEGANT.DESC"
