msgstr "<link=\"SWAMPHARVESTPLANT\">دلو المستنقع</link>"

msgctxt "STRINGS.CREATURES.SPECIES.SWAMPLILY.DESC"
msgid ""
"Balm Lilies produce <link=\"SWAMPLILYFLOWER\">Balm Lily Flower</link>, a "
