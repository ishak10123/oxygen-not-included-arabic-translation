msgctxt "STRINGS.BUILDINGS.PREFABS.ELECTROBANKCHARGER.DESC"
msgid "Bionic Duplicants rely on a steady supply of power to function."
msgstr "يعتمد النسخ البايوني على تزويد مستمر بالطاقة ليعمل."

msgctxt "STRINGS.BUILDINGS.PREFABS.ELECTROBANKCHARGER.EFFECT"
msgid ""
"Converts empty <link=\"ELECTROBANK\">Eco Power Banks</link> into fully "
"charged units ready for reuse."
msgstr ""
"يحول وحدات <link=\"ELECTROBANK\">بنوك الطاقة اإليكولوجية</link> الفارغة إلى "
"وحدات مشحونة بالكامل جاهزة إلعادة االستخدام."

