msgstr "قطع النبات المسطحة هي بديل خشبي مفيد."

msgctxt "STRINGS.BUILDINGS.PREFABS.FABRICATEDWOODMAKER.EFFECT"
msgid ""
"Combines a Binder liquid and <link=\"PLANTFIBER\">Plant Husk</link> to "
"create <link=\"FABRICATEDWOOD\">Plywood</link>."
msgstr ""
"يجمع سائل الربط و<link=\"PLANTFIBER\">قشر النبات</link> إلنشاء "
"<link=\"FABRICATEDWOOD\">الخشب الرقائقي</link>."

msgctxt "STRINGS.BUILDINGS.PREFABS.FABRICATEDWOODMAKER.NAME"
msgid "<link=\"FABRICATEDWOODMAKER\">Plywood Press</link>"
msgstr "<link=\"FABRICATEDWOODMAKER\">مكبس الخشب الرقائقي</link>"

msgctxt "STRINGS.BUILDINGS.PREFABS.FABRICATEDWOODMAKER.RECIPE_DESC"
