msgctxt ""
"STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_WOOD_DEER.DESC"
msgid ""
"The sculptor used a tiny fleck of glass to mimic the mischievous glint of a "
"Flox's eye."
msgstr ""
"استخدم النحات شظية صغيرة من الزجاج لتقليد اللمعان الماكر في عين الفلوكس."

msgctxt ""
"STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_WOOD_DEER.NAME"
