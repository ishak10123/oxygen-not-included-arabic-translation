msgstr "مصنع النسيج"

msgctxt "STRINGS.CODEX.THIMBLEREED.TITLE"
msgid "Thimble Reed"
msgstr "قصبة اإلبهام"

msgctxt "STRINGS.CODEX.TIMEOFFAPPROVED.BODY.CONTAINER"
