msgid ""
"Stone Hatches excrete solid <link=\"CARBON\">Coal</link> as waste and enjoy "
"burrowing into the ground."
msgstr ""
"تطرح فتحات الحجارة <link=\"CARBON\">الفحم</link> الصلب كنفايات وتستمتع "
"بالحفر في األرض."

msgctxt "STRINGS.CREATURES.SPECIES.HATCH.VARIANT_HARD.EGG_NAME"
msgid "<link=\"HATCHHARD\">Stone Hatch Egg</link>"
msgstr "<link=\"HATCHHARD\">بيضة فتحة حجرية</link>"

