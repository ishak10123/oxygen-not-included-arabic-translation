msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_TRIANGLE_SATSUMA_WHITE.NAME"
msgid "<link=\"EXTERIORWALL\">Hi-Vis Corner</link>"
msgstr "<link=\"EXTERIORWALL\">زاوية الرؤية العالية</link>"

msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_TRIANGLE_WHITE_CHARCOAL.DESC"
msgid ""
"This wallpaper features a dark-gray triangle pointing into a vast expanse of"
" nothingness."
msgstr ""
"تتميز هذه الخلفية بورقة مثلثية داكنة الرمادي تشير إلى فضاء شاسع من العدم."

msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_TRIANGLE_WHITE_CHARCOAL.NAME"
msgid "<link=\"EXTERIORWALL\">Charcoal Point</link>"
msgstr "<link=\"EXTERIORWALL\">نقطة الفحم</link>"

msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_TRIANGLE_WHITE_CHILLI.DESC"
msgid ""
"This wallpaper features a chili-red triangle pointing into a vast expanse of"
" nothingness."
msgstr ""
"تتميز هذه الخلفية بورقة حائط تحتوي على مثلث أحمر حار يشير إلى امتداد واسع من"
" العدم."

msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_TRIANGLE_WHITE_CHILLI.NAME"
msgid "<link=\"EXTERIORWALL\">Chili Point</link>"
msgstr "<link=\"EXTERIORWALL\">تشلي بوينت</link>"

msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_TRIANGLE_WHITE_COBALT.DESC"
msgid ""
"This wallpaper features a cobalt-blue triangle pointing into a vast expanse "
